(ns clojure.msbuild.bootstrap
  "Process startup for Clojure.MSBuild projects.

   The build generates a `clojure.msbuild.entry` namespace whose gen-class
   `Main` (or, in csharp entry-point mode, the generated C# host) calls
   `run` with a config map describing the project. `run` sets up the load
   path, pre-loads NuGet assemblies, and then either dispatches to the
   in-process tool (`--clj-mode repl|nrepl|test|build|...`) or invokes the
   project's main namespace `-main`."
  (:require [clojure.string :as str])
  (:import [System Environment AppDomain]
           [System.IO Directory Path File]
           [System.Reflection Assembly]))

;; ── Load path ────────────────────────────────────────────────────

(defn- base-directory []
  (.BaseDirectory (AppDomain/CurrentDomain)))

(defn- load-path []
  (let [raw (Environment/GetEnvironmentVariable "CLOJURE_LOAD_PATH")]
    (if (str/blank? raw)
      []
      (vec (remove str/blank? (.Split raw (char-array [Path/PathSeparator])))))))

(defn- set-load-path! [paths]
  (Environment/SetEnvironmentVariable
    "CLOJURE_LOAD_PATH"
    (String/Join (str Path/PathSeparator) (into-array String paths))))

(defn add-to-load-path!
  "Append directories to CLOJURE_LOAD_PATH, skipping blanks, duplicates
   and directories that do not exist."
  [dirs]
  (let [current (load-path)
        seen (set current)
        new (->> dirs
                 (remove str/blank?)
                 (map #(Path/GetFullPath %))
                 (filter #(Directory/Exists %))
                 (remove seen)
                 distinct)]
    (when (seq new)
      (set-load-path! (into current new)))))

(defn- split-dirs
  "Directories separated by | or ; (blanks dropped)."
  [s]
  (when-not (str/blank? s)
    (->> (.Split ^String s (char-array "|;") StringSplitOptions/RemoveEmptyEntries)
         (map str/trim)
         (remove str/blank?))))

(defn- source-dirs [{:keys [source-dir extra-source-dirs]}]
  (cons (or (not-empty source-dir) "src") (split-dirs extra-source-dirs)))

(defn- setup-tooling-load-path!
  "Tooling (build, tests, REPL) works from the project's sources: the
   source directories under the project directory (the current directory)
   and the Clojure.MSBuild namespaces."
  [{:keys [msbuild-source-dir] :as config}]
  (let [cwd (Environment/CurrentDirectory)
        dirs (source-dirs config)]
    (add-to-load-path!
      (concat (map #(Path/Combine cwd %) dirs)
              (map #(Path/Combine (base-directory) %) dirs)
              [msbuild-source-dir]))))

(defn- setup-app-load-path!
  "The compiled application loads its namespaces from the assemblies next
   to it. Only source directories copied next to it (Content items) are on
   the load path, so that `require :reload` from a REPL can find them. A
   source directory under the current directory is deliberately not added:
   RT.load prefers a source file that is newer than its assembly, so an
   application started from a directory with a src/ folder could otherwise
   run that code instead of its own. With dev? (the in-app nREPL is on)
   the project's sources are added as for tooling, to reload edited files."
  [config dev?]
  (if dev?
    (setup-tooling-load-path! config)
    (add-to-load-path! (map #(Path/Combine (base-directory) %) (source-dirs config)))))

;; ── Assemblies ───────────────────────────────────────────────────

(defn- compiled-namespace?
  "Assemblies of compiled Clojure namespaces (a.b.cljr.dll, ...) are found
   and loaded by RT.load when the namespace is required."
  [^String file]
  (or (.EndsWith file ".cljr.dll") (.EndsWith file ".cljc.dll") (.EndsWith file ".clj.dll")))

(defn preload-assemblies!
  "Load every assembly next to the application so that `require` and
   `import` can find NuGet-packaged Clojure libraries and .NET types.
   Compiled namespaces are skipped: RT.load loads them on demand, and a
   preloaded copy of one that the build is about to compile again would
   shadow the types it defines."
  []
  (doseq [dll (Directory/GetFiles (base-directory) "*.dll")
          :when (not (compiled-namespace? dll))]
    (try (Assembly/LoadFrom dll) (catch Exception _))))

;; ── Git deps ─────────────────────────────────────────────────────

(defn- fail!
  "Reports a canonical MSBuild error (see clojure.msbuild.diagnostics) and
   exits: the tooling cannot work without what failed."
  [kind ^String text]
  (binding [*out* *err*]
    (println (str "Clojure.MSBuild : error " (case kind :git-deps "CLJ0002" :config "CLJ0003" "CLJ0000")
                  ": " (first (str/split-lines text))))
    (doseq [line (rest (str/split-lines text))]
      (println (str "  " line)))
    (flush))
  (Environment/Exit 1))

(defn- resolve-git-deps!
  "Resolves the ClojureGitDep items and deps-clr.edn/deps.edn (with the
   ClojureDepsAliases) and puts their source paths on the load path. A
   dependency that cannot be resolved stops the process with an error."
  [{:keys [git-deps deps-aliases]}]
  (let [cwd (Environment/CurrentDirectory)
        has-csproj-deps (seq (:deps git-deps))
        has-deps-file (or (File/Exists (Path/Combine cwd "deps-clr.edn"))
                          (File/Exists (Path/Combine cwd "deps.edn")))]
    (when (or has-csproj-deps has-deps-file)
      (require 'clojure.msbuild.gitlibs)
      (let [resolve-project! (resolve 'clojure.msbuild.gitlibs/resolve-project!)
            paths (try (resolve-project! cwd git-deps (split-dirs deps-aliases))
                       (catch Exception e
                         (fail! :git-deps (.Message e))))]
        (add-to-load-path! paths)))))

;; ── Settings for the tooling ─────────────────────────────────────

(defn- export-settings!
  "Settings the tooling reads from the environment (so that `dotnet run --
   --clj-mode ...` and the test adapter's processes see them too). A value
   already in the environment wins."
  [{:keys [test-dir test-suffix]}]
  (doseq [[k v] [["CLOJURE_MSBUILD_TEST_DIR" test-dir]
                 ["CLOJURE_MSBUILD_TEST_SUFFIX" test-suffix]]
          :when (and (not (str/blank? v))
                     (str/blank? (Environment/GetEnvironmentVariable k)))]
    (Environment/SetEnvironmentVariable k v)))

;; ── In-app nREPL ─────────────────────────────────────────────────

(defn- in-app-nrepl
  "The port of the in-app nREPL server (ClojureNReplInApp), or nil when it
   is off. CLOJURE_MSBUILD_NREPL in the environment overrides the build:
   false/off/0 turns it off, true/on turns it on, a number picks the port."
  [{:keys [nrepl-in-app nrepl-port]}]
  (let [env (some-> (Environment/GetEnvironmentVariable "CLOJURE_MSBUILD_NREPL") str/trim str/lower-case)
        port (or (not-empty (str nrepl-port)) "1667")]
    (cond
      (#{"false" "off" "no" "0"} env) nil
      (#{"true" "on" "yes"} env) port
      (and env (re-matches #"\d+" env)) env
      (true? nrepl-in-app) port
      :else nil)))

;; ── clojure.core ─────────────────────────────────────────────────

(defn- mark-core-loaded!
  "The runtime loads clojure.core without recording it in *loaded-libs*, so a
   namespace that requires clojure.core explicitly (clojure.test.check.generators
   does) makes ClojureCLR load it a second time: 25 s from source, and during
   the build it would be emitted in the wrong layer. Record it as loaded, which
   is what the JVM effectively does."
  []
  (dosync (alter (deref #'clojure.core/*loaded-libs*) conj 'clojure.core)))

;; ── Entry ────────────────────────────────────────────────────────

(defn run
  "Start the process. `config` is the map generated by the build:
     :main-ns            symbol of the namespace whose -main to run
     :source-dir         Clojure source directory (relative)
     :extra-source-dirs  extra source directories, separated by | or ;
     :msbuild-source-dir directory containing the Clojure.MSBuild namespaces
     :git-deps           {:deps {lib {:git/tag .. :git/sha .. :git/url ..}}}
     :deps-aliases       deps.edn aliases whose :extra-deps/:extra-paths to use
     :test-dir           the test directory (relative), \"test\" by default
     :test-suffix        suffix of test file names, \"_test\" by default
     :preload-assemblies false to not load every assembly next to the app
     :nrepl-in-app       true to start an nREPL server inside the app
     :nrepl-port         its port
     :nrepl-middleware   extra nREPL middleware (qualified var symbols)

   If the first argument is --clj-mode, the remaining arguments are handed
   to clojure.msbuild.tool (repl, nrepl, script, test, build, ...).
   Otherwise the main namespace is required and its -main is applied to
   the arguments. The return value is returned so the caller can await a
   Task result."
  [config args]
  (let [args (vec args)
        tooling? (= "--clj-mode" (first args))
        nrepl-port (when-not tooling? (in-app-nrepl config))]
    (mark-core-loaded!)
    (export-settings! config)
    (if tooling?
      (setup-tooling-load-path! config)
      (setup-app-load-path! config (some? nrepl-port)))
    ;; Tooling needs every assembly (it loads the project's NuGet libraries
    ;; from source); an application can opt out and load what it uses.
    (when (or tooling? (not (false? (:preload-assemblies config))))
      (preload-assemblies!))
    (if tooling?
      (do
        ;; Tooling (REPL, tests, build) works from source, so it needs git deps
        ;; on the load path. The compiled application already contains them.
        (resolve-git-deps! config)
        (require 'clojure.msbuild.tool)
        (binding [*command-line-args* (seq (drop 2 args))]
          (apply (resolve 'clojure.msbuild.tool/-main) config (rest args))))
      (let [main-ns (symbol (str (:main-ns config)))]
        (when nrepl-port
          (require 'clojure.msbuild.nrepl)
          ((resolve 'clojure.msbuild.nrepl/start-in-app!) nrepl-port (:nrepl-middleware config)))
        (require main-ns)
        (let [main-fn (ns-resolve main-ns '-main)]
          (when-not main-fn
            (throw (Exception. (str "Namespace " main-ns " has no -main function"))))
          (let [result (binding [*command-line-args* (seq args)]
                         (apply main-fn args))]
            (if nrepl-port
              ;; nREPL sessions run on agent threads, which would keep the process
              ;; alive after -main (and the Task it returns) has finished.
              (do (when (instance? System.Threading.Tasks.Task result)
                    (.Wait ^System.Threading.Tasks.Task result))
                  (shutdown-agents)
                  nil)
              result)))))))
