(ns clojure.msbuild.tool
  "ClojureCLR MSBuild tool — REPL, test runner, script runner, AOT compiler.
   Runs in-process: the host project's entry point already loaded all assemblies
   and set up CLOJURE_LOAD_PATH, so no bootstrap is needed here."
  (:require [clojure.string :as str]
            [clojure.test])
  (:import [System Environment Console DateTime]
           [System.IO Directory Path File SearchOption]))

;; ── Machine-readable test results ────────────────────────────────

(def result-prefix
  "Prefix of the one-line-per-test result written to stdout while tests run:
   CLJTEST<tab>ns/name<tab>pass|fail<tab>milliseconds<tab>first failure message
   The VSTest adapter (Clojure.MSBuild.TestAdapter) parses these lines."
  "CLJTEST")

(defn- format-failure [{:keys [type message expected actual]}]
  (str (name type)
       (when message (str ": " message))
       " expected: " (pr-str expected)
       " actual: " (pr-str actual)))

(defn- single-line [s]
  (str/replace (or s "") #"[\r\n\t]+" " "))

(defn run-with-reporter
  "Calls f with clojure.test/report wrapped so that, in addition to the normal
   output, one result line per test var is printed (see result-prefix)."
  [f]
  (let [original clojure.test/report
        current (atom nil)]
    (binding [clojure.test/report
              (fn [m]
                (case (:type m)
                  :begin-test-var (reset! current {:var (:var m) :start (DateTime/UtcNow) :failures []})
                  (:fail :error) (swap! current update :failures conj (format-failure m))
                  nil)
                (original m)
                (when (= :end-test-var (:type m))
                  (let [{:keys [var start failures]} @current
                        {:keys [ns name]} (meta var)
                        ms (long (.TotalMilliseconds (.Subtract (DateTime/UtcNow) ^DateTime start)))]
                    (println (str result-prefix "\t" (ns-name ns) "/" name "\t"
                                  (if (empty? failures) "pass" "fail") "\t" ms "\t"
                                  (single-line (first failures)))))))]
      (f))))

;; ── Test directory helpers ───────────────────────────────────────

(defn- add-test-dir-to-load-path! []
  (let [test-dir (Path/Combine (Environment/CurrentDirectory) "test")]
    (when (Directory/Exists test-dir)
      (let [current (or (Environment/GetEnvironmentVariable "CLOJURE_LOAD_PATH") "")
            new-path (if (seq current)
                       (str current Path/PathSeparator test-dir)
                       test-dir)]
        (Environment/SetEnvironmentVariable "CLOJURE_LOAD_PATH" new-path)))))

(defn- discover-test-namespaces []
  (let [test-dir (Path/Combine (Environment/CurrentDirectory) "test")]
    (when (Directory/Exists test-dir)
      (let [files (concat
                    (Directory/GetFiles test-dir "*_test.cljr" SearchOption/AllDirectories)
                    (Directory/GetFiles test-dir "*_test.cljc" SearchOption/AllDirectories)
                    (Directory/GetFiles test-dir "*_test.clj" SearchOption/AllDirectories))]
        (println (str "Found " (count files) " test files"))
        (->> files
             (map (fn [f]
                    (let [rel (Path/GetRelativePath test-dir f)
                          no-ext (subs rel 0 (- (count rel) (count (Path/GetExtension rel))))]
                      (-> no-ext
                          (.Replace (char Path/DirectorySeparatorChar) \.)
                          (.Replace \_ \-)
                          symbol))))
             (doall))))))

;; ── Modes ────────────────────────────────────────────────────────

(defn run-repl
  "Start interactive Clojure REPL."
  []
  (println "Starting Clojure REPL...")
  (clojure.main/main))

(defn run-nrepl
  "Start nREPL server."
  []
  (println "Starting nREPL server...")
  (try
    ((requiring-resolve 'clojure.tools.nrepl/start-server!))
    (println "nREPL started at port: 1667")
    (Console/ReadLine)
    (catch Exception e
      (println (str "Error starting nREPL: " (.Message e)))
      (println "Make sure clojure.tools.nrepl is in your project dependencies"))))

(defn run-script
  "Run a Clojure script file."
  [path]
  (println (str "Running script: " path))
  (if (File/Exists path)
    (load-file path)
    (do (println (str "Error: Script file not found: " path))
        (Environment/Exit 1))))

(defn run-tests
  "Discover and run all *_test.cljr test files."
  []
  (println "Running tests...")
  (add-test-dir-to-load-path!)
  (require 'clojure.test)
  (let [run-tests-fn (resolve 'clojure.test/run-tests)
        run-all-fn   (resolve 'clojure.test/run-all-tests)
        test-nses    (discover-test-namespaces)
        loaded       (doall
                       (keep (fn [ns-sym]
                               (println (str "Loading test namespace: " ns-sym))
                               (try
                                 (require ns-sym)
                                 ns-sym
                                 (catch Exception e
                                   (println (str "Error loading namespace " ns-sym ": " (.Message e)))
                                   nil)))
                             test-nses))]
    (run-with-reporter
      (fn []
        (if (seq loaded)
          (apply run-tests-fn (map find-ns loaded))
          (do (println "No test namespaces found, running all tests...")
              (run-all-fn)))))))

(defn run-namespace-tests
  "Run tests for a specific namespace."
  [ns-name]
  (println (str "Running tests for namespace: " ns-name))
  (add-test-dir-to-load-path!)
  (require 'clojure.test)
  (let [ns-sym (symbol ns-name)]
    (require ns-sym)
    (run-with-reporter
      (fn [] ((resolve 'clojure.test/run-tests) (find-ns ns-sym))))))

(defn run-test-vars
  "Run only the given tests (\"ns/name\" strings), with their namespaces'
   fixtures. Used by the VSTest adapter for filtered runs."
  [names]
  (println (str "Running tests: " (str/join " " names)))
  (add-test-dir-to-load-path!)
  (require 'clojure.test)
  (let [vars (doall
               (keep (fn [full-name]
                       (let [sym (symbol full-name)]
                         (try
                           (require (symbol (namespace sym)))
                           (or (resolve sym)
                               (println (str "Error: test " full-name " not found")))
                           (catch Exception e
                             (println (str "Error loading namespace " (namespace sym) ": " (.Message e)))
                             nil))))
                     names))]
    (run-with-reporter
      (fn [] ((resolve 'clojure.test/test-vars) vars)))))

(defn- root-cause [^Exception e]
  (loop [e e]
    (if-let [inner (.InnerException e)] (recur inner) e)))

(defn compile-namespaces
  "AOT compile semicolon-separated namespaces to compile-path.
   Each namespace is compiled explicitly (compile only emits assemblies
   for namespaces loaded from source during the call, so namespaces that
   are already loaded in this process must be listed to be emitted).
   Returns the number of namespaces that failed to compile."
  [namespaces compile-path]
  (let [compile-path (Path/GetFullPath compile-path)
        ns-strs (->> (.Split namespaces (char-array ";") StringSplitOptions/RemoveEmptyEntries)
                     (map #(.Trim ^String %))
                     (remove empty?)
                     distinct)]
    (println (str "Compiling Clojure namespaces to: " compile-path))
    (Directory/CreateDirectory compile-path)
    (reduce
      (fn [failures ns-str]
        (println (str "  Compiling " ns-str "..."))
        (try
          (binding [*compile-path* compile-path
                    *compile-files* true]
            (compile (symbol ns-str)))
          failures
          (catch Exception e
            (let [cause (root-cause e)]
              (binding [*out* *err*]
                (println (str "  Error compiling " ns-str ": " (.Message cause)))))
            (inc failures))))
      0
      ns-strs)))

(defn build
  "Build mode used by the ClojureBuild MSBuild target: compile all listed
   namespaces and exit non-zero if any of them failed."
  [namespaces compile-path]
  (let [failures (compile-namespaces namespaces compile-path)]
    (when (pos? failures)
      (binding [*out* *err*]
        (println (str failures " Clojure namespace(s) failed to compile")))
      (Environment/Exit 1))))

;; ── Entry point (--clj-mode dispatch) ────────────────────────────

(defn -main
  "Dispatch based on --clj-mode argument. Called by the generated entry point
   when the project is invoked with --clj-mode instead of normal app startup."
  [& args]
  (let [args-vec (vec args)
        mode (first args-vec)
        rest-args (rest args-vec)]
    (case mode
      "repl"           (run-repl)
      "nrepl"          (run-nrepl)
      "script"         (run-script (first rest-args))
      "test"           (run-tests)
      "test-namespace" (run-namespace-tests (first rest-args))
      "test-vars"      (run-test-vars rest-args)
      "build"          (build (first rest-args) (second rest-args))
      "compile"        (compile-namespaces (first rest-args) (second rest-args))
      (do (println (str "Unknown mode: " mode))
          (println "Valid modes: repl, nrepl, script, test, test-namespace, test-vars, build, compile")
          (Environment/Exit 1)))))
