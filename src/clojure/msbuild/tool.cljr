(ns clojure.msbuild.tool
  "ClojureCLR MSBuild tool — REPL, test runner, script runner, AOT compiler.
   Runs in-process: the host project's entry point already loaded all assemblies
   and set up CLOJURE_LOAD_PATH, so no bootstrap is needed here."
  (:require [clojure.string :as str]
            [clojure.test]
            [clojure.msbuild.incremental :as incremental]
            [clojure.msbuild.ready-to-run :as r2r]
            [clojure.msbuild.nrepl :as nrepl]
            [clojure.msbuild.test-runner :as test-runner])
  (:import [System Environment Console DateTime AppDomain]
           [System.IO Directory Path File SearchOption]))

;; ── Modes ────────────────────────────────────────────────────────

(defn run-repl
  "Start interactive Clojure REPL."
  []
  (println "Starting Clojure REPL...")
  (clojure.main/main))

(defn run-nrepl
  "Start the nREPL server (see clojure.msbuild.nrepl) on port, 1667 by
   default, 0 for any free port."
  [port]
  (nrepl/run port))

(defn run-script
  "Run a Clojure script file."
  [path]
  (println (str "Running script: " path))
  (if (File/Exists path)
    (load-file path)
    (do (println (str "Error: Script file not found: " path))
        (Environment/Exit 1))))

(defn run-tests
  "Run the tests selected by args (namespaces and ns/name; all when empty)
   and exit non-zero if any failed or could not be loaded."
  [args]
  (let [summary (test-runner/run (test-runner/result-format) args)]
    (flush)
    (Environment/Exit (test-runner/exit-code summary))))

(defn- split-dirs [dirs]
  (remove str/blank? (map #(.Trim ^String %) (.Split (or dirs "src") (char-array "|")))))

(defn- root-cause [^Exception e]
  (loop [e e]
    (if-let [inner (.InnerException e)] (recur inner) e)))

(defn- warn [& parts]
  (binding [*out* *err*]
    (println (apply str parts))))

;; ── Project vs library namespaces ────────────────────────────────
;;
;; The build compiles Clojure in two layers. Library namespaces (clojure.core
;; and the standard library, NuGet Clojure libraries, git dependencies and the
;; Clojure.MSBuild tooling) only change when the project's dependencies change,
;; so they are compiled once into a cached layer. Project namespaces, whose
;; source lives in the project directories, are recompiled on every build.

(def ^:private source-extensions [".cljr" ".cljc" ".clj"])

(defn- parse-dirs
  "Pipe-separated directories, made absolute against the current directory;
   blanks and missing directories are dropped."
  [dirs]
  (->> (.Split (or dirs "") (char-array "|") StringSplitOptions/RemoveEmptyEntries)
       (map #(.Trim ^String %))
       (remove empty?)
       (map #(Path/GetFullPath (Path/Combine (Environment/CurrentDirectory) %)))
       (filter #(Directory/Exists %))
       distinct
       vec))

(defn- source-in-dirs?
  "Does a source file for the given path stem (a/b_c/d) exist under any of dirs?"
  [dirs stem]
  (boolean (some (fn [dir] (some #(File/Exists (Path/Combine dir (str stem %))) source-extensions)) dirs)))

(defn- compiled-in?
  "Is there a compiled assembly for ns-sym in dir?"
  [dir ns-sym]
  (let [stem (.Replace (str ns-sym) \- \_)]
    (boolean (some #(File/Exists (Path/Combine dir (str stem % ".dll"))) source-extensions))))

(defn- project-namespace? [project-dirs ns-sym]
  (source-in-dirs? project-dirs
                   (-> (str ns-sym) (.Replace \- \_) (.Replace \. Path/DirectorySeparatorChar))))

(defn- compiled-file-stem
  "clojure.msbuild.test_adapter.cljr.dll -> clojure/msbuild/test_adapter, or nil
   for files that are not compiled Clojure namespaces (e.g. the entry exe)."
  [file]
  (let [name (Path/GetFileName file)]
    (some (fn [ext]
            (let [suffix (str ext ".dll")]
              (when (.EndsWith name suffix)
                (.Replace (subs name 0 (- (count name) (count suffix))) \. Path/DirectorySeparatorChar))))
          source-extensions)))

(defn- project-compiled-file? [project-dirs file]
  (when-let [stem (compiled-file-stem file)]
    (source-in-dirs? project-dirs stem)))

(defn- delete-with-pdb! [^String dll]
  (File/Delete dll)
  (let [pdb (Path/ChangeExtension dll ".pdb")]
    (when (File/Exists pdb) (File/Delete pdb))))

(defn- move-with-pdb! [^String dll ^String target-dir]
  (let [target (Path/Combine target-dir (Path/GetFileName dll))
        pdb (Path/ChangeExtension dll ".pdb")]
    (File/Move dll target true)
    (when (File/Exists pdb)
      (File/Move pdb (Path/Combine target-dir (Path/GetFileName pdb)) true))))

;; ── Compilation ──────────────────────────────────────────────────

(defn- compile-one!
  "Compiles one namespace into compile-path. Returns true on success; failures
   are reported on stderr and any partially written assembly is removed."
  [ns-sym compile-path]
  (try
    (binding [*compile-path* compile-path
              *compile-files* true]
      (compile ns-sym))
    true
    (catch Exception e
      (warn "  Error compiling " ns-sym ": " (.Message (root-cause e)))
      (let [stem (-> (str ns-sym) (.Replace \- \_))]
        (doseq [ext source-extensions
                :let [dll (Path/Combine compile-path (str stem ext ".dll"))]
                :when (File/Exists dll)]
          (delete-with-pdb! dll)))
      false)))

(defn- split-namespaces [namespaces]
  (->> (.Split (or namespaces "") (char-array ";") StringSplitOptions/RemoveEmptyEntries)
       (map #(.Trim ^String %))
       (remove empty?)
       distinct))

(defn compile-namespaces
  "AOT compile semicolon-separated namespaces to compile-path.
   Each namespace is compiled explicitly (compile only emits assemblies
   for namespaces loaded from source during the call, so namespaces that
   are already loaded in this process must be listed to be emitted).
   A namespace whose compiled assembly is up to date is loaded from it
   and not emitted again.
   Returns the number of namespaces that failed to compile."
  [namespaces compile-path]
  (let [compile-path (Path/GetFullPath compile-path)]
    (Directory/CreateDirectory compile-path)
    (reduce (fn [failures ns-str]
              (if (compile-one! (symbol ns-str) compile-path) failures (inc failures)))
            0
            (split-namespaces namespaces))))

(defn- written-since
  "Compiled namespace files in dir written at or after started."
  [dir ^DateTime started]
  (->> (Directory/GetFiles dir "*.dll")
       (filter compiled-file-stem)
       (filter #(>= (.Ticks (File/GetLastWriteTimeUtc ^String %)) (.Ticks started)))
       (map #(Path/GetFileName ^String %))
       sort))

(defn build
  "Build mode used by the ClojureBuild MSBuild target: compile the project
   namespaces into compile-path and exit non-zero if any of them failed.

   compile-path keeps the previous build's assemblies. Only namespaces whose
   source changed, and the namespaces that depend on them, are compiled
   again; the others load from their assemblies (see
   clojure.msbuild.incremental). Library namespaces that had to be loaded
   from source along the way (a dependency the library layer did not know
   about yet) are moved into lib-dir so that later builds load them
   precompiled."
  [namespaces compile-path lib-dir project-dirs]
  (let [started DateTime/UtcNow
        compile-path (Path/GetFullPath compile-path)
        project-dirs (parse-dirs project-dirs)
        test-dir (Path/GetFullPath (Path/Combine (Environment/CurrentDirectory) "test"))
        _ (Directory/CreateDirectory compile-path)
        {:keys [entries fresh]} (incremental/prepare! (remove #{test-dir} project-dirs) compile-path)
        failures (compile-namespaces namespaces compile-path)]
    (when (pos? failures)
      (warn failures " Clojure namespace(s) failed to compile")
      (Environment/Exit 1))
    (doseq [name (incremental/prune! entries compile-path started)]
      (println (str "  Removed " name " (no source)")))
    (incremental/write-manifest! entries compile-path)
    (let [compiled (written-since compile-path started)
          project (->> compiled
                       (filter #(project-compiled-file? project-dirs %))
                       (remove #(.StartsWith ^String % "clojure.msbuild.entry.")))]
      (println (str "Compiled " (count project) " namespace(s) to " compile-path
                    (when (seq fresh) (str ", " (count fresh) " up to date"))
                    (when (seq project) (str ": " (str/join " " project))))))
    (when-not (str/blank? lib-dir)
      (let [lib-dir (Path/GetFullPath lib-dir)]
        (Directory/CreateDirectory lib-dir)
        (doseq [dll (Directory/GetFiles compile-path "*.dll")
                :when (and (compiled-file-stem dll) (not (project-compiled-file? project-dirs dll)))]
          (println (str "  Adding " (Path/GetFileName dll) " to the library layer"))
          (move-with-pdb! dll lib-dir))))))

;; Loaded by clojure.core itself; compiling clojure.core emits them.
(def ^:private core-parts '#{clojure.core clojure.core.protocols clojure.instant clojure.uuid})

;; spec is reloaded before anything that registers specs against it.
(def ^:private spec-first '{clojure.spec.alpha 0 clojure.spec.gen.alpha 1 clojure.core.specs.alpha 2})

(defn- copy-dlls!
  "Copies the assemblies (and pdbs) in files into target-dir."
  [files target-dir]
  (Directory/CreateDirectory target-dir)
  (doseq [^String f files]
    (File/Copy f (Path/Combine target-dir (Path/GetFileName f)) true)
    (let [pdb (Path/ChangeExtension f ".pdb")]
      (when (File/Exists pdb)
        (File/Copy pdb (Path/Combine target-dir (Path/GetFileName pdb)) true)))))

(defn- publish-shared-layer!
  "Stores files (and the ReadyToRun Clojure.dll in runtime-dir, if any) in
   shared-dir for other projects. Written to a temporary directory first and
   moved into place so concurrent builds never see a partial layer; the first
   one to finish wins."
  [shared-dir files runtime-dir]
  (let [shared-dir (.TrimEnd (Path/GetFullPath shared-dir) (char-array [Path/DirectorySeparatorChar]))
        tmp (str shared-dir ".tmp-" (.Id (System.Diagnostics.Process/GetCurrentProcess)))]
    (try
      (copy-dlls! files tmp)
      (when (Directory/Exists runtime-dir)
        (copy-dlls! (Directory/GetFiles runtime-dir "*.dll") (Path/Combine tmp "runtime")))
      (File/WriteAllText (Path/Combine tmp "complete") (str (DateTime/UtcNow)))
      (Directory/CreateDirectory (Path/GetDirectoryName shared-dir))
      (if (Directory/Exists shared-dir)
        (Directory/Delete tmp true)
        (Directory/Move tmp shared-dir))
      (println (str "Shared Clojure runtime layer stored in " shared-dir))
      (catch Exception e
        (warn "warning: could not store the shared Clojure runtime layer: " (.Message (root-cause e)))
        (try (when (Directory/Exists tmp) (Directory/Delete tmp true)) (catch Exception _))))))

(defn- ready-to-run!
  "ReadyToRun-compiles the IL assemblies in lib-dir in place and, when given,
   the Clojure runtime (clojure-dll, the IL assembly from the Clojure package)
   into lib-dir/runtime. An assembly crossgen2 cannot compile stays IL.
   Returns false when crossgen2 was asked for but is not there."
  [lib-dir crossgen clojure-dll shared-dir]
  (cond
    (str/blank? crossgen) true

    (not (File/Exists crossgen))
    (do (warn "warning: crossgen2 was not found (" crossgen "), so the Clojure library layer is not ReadyToRun compiled and starts slower. It is retried when the layer is rebuilt; set ClojureReadyToRun to false to turn this off.")
        false)

    :else
    (let [started DateTime/UtcNow
          ;; What came from the shared layer was compiled when that was built;
          ;; what is still IL there is what crossgen2 could not compile.
          shared? (fn [f] (and (not (str/blank? shared-dir))
                               (File/Exists (Path/Combine shared-dir (Path/GetFileName ^String f)))))
          jobs (concat (for [f (sort (Directory/GetFiles lib-dir "*.dll"))
                             :when (not (or (shared? f) (r2r/ready-to-run? f)))]
                         [f f])
                       (when (and (not (str/blank? clojure-dll)) (File/Exists clojure-dll)
                                  (not (r2r/ready-to-run? clojure-dll)))
                         [[clojure-dll (Path/Combine lib-dir "runtime" "Clojure.dll")]]))
          {:keys [compiled failed]} (r2r/compile! crossgen jobs [lib-dir (.BaseDirectory (AppDomain/CurrentDomain))])
          secs (long (.TotalSeconds (.Subtract DateTime/UtcNow started)))]
      (when (seq jobs)
        (println (str "ReadyToRun: " (count compiled) " assemblies compiled in " secs " s")))
      (when (seq failed)
        (println "  Kept as IL (crossgen2 could not compile them):")
        (doseq [[file reason] (sort failed)]
          (println (str "    " (Path/GetFileName ^String file) ": " reason))))
      true)))

(defn build-libs
  "Compiles the library layer into lib-dir: everything the application and its
   tests load that is not project code, the namespaces already loaded when the
   process started (the standard library and the Clojure.MSBuild tooling), and
   finally clojure.core. ClojureCLR ships these as source and would otherwise
   compile them again at every process start. Failures are reported and the
   namespace is left to be loaded from source; the mode always exits 0.

   The second part (startup namespaces and clojure.core) depends only on the
   Clojure and Clojure.MSBuild versions, so it is shared between projects
   through shared-dir: when that directory is complete the build has already
   copied it into lib-dir and this pass skips it, otherwise the freshly
   compiled assemblies are stored there for the next project.

   With crossgen (the path of crossgen2) the layer is then ReadyToRun
   compiled (see clojure.msbuild.ready-to-run), together with clojure-dll,
   the Clojure runtime, which goes to lib-dir/runtime and the shared layer.

   Must run with clojure.spec.skip-macros=true: reloading clojure.spec.alpha
   while macro specs are checked with the previous spec objects fails."
  [lib-dir main-ns project-dirs shared-dir crossgen clojure-dll]
  (let [lib-dir (Path/GetFullPath lib-dir)
        project-dirs (parse-dirs project-dirs)
        shared? (not (str/blank? shared-dir))
        shared-ready? (and shared? (File/Exists (Path/Combine shared-dir "complete")))
        shared-files (atom nil)
        started (DateTime/UtcNow)
        startup-namespaces (set (map ns-name (all-ns)))
        failures (atom [])
        compile! (fn [ns-sym]
                   (println (str "  Compiling " ns-sym "..."))
                   (when-not (compile-one! ns-sym lib-dir)
                     (swap! failures conj ns-sym)))
        dlls #(set (Directory/GetFiles lib-dir "*.dll"))]
    (println (str "Compiling the Clojure library layer to: " lib-dir))
    (Directory/CreateDirectory lib-dir)
    (test-runner/add-test-dir-to-load-path!)
    ;; 1. Load the application and the tests with *compile-files* on: every
    ;;    namespace loaded from source on the way is emitted into lib-dir.
    (binding [*compile-path* lib-dir
              *compile-files* true]
      (when-not (str/blank? main-ns)
        (println (str "  Loading " main-ns " and its dependencies..."))
        (try (require (symbol main-ns))
             (catch Exception e
               (warn "  Error loading " main-ns ": " (.Message (root-cause e))))))
      (doseq [test-ns (map :ns (test-runner/test-namespaces))]
        (println (str "  Loading " test-ns " and its dependencies..."))
        (try (require test-ns)
             (catch Exception e
               (warn "  Error loading " test-ns ": " (.Message (root-cause e))))))
      ;; The nREPL server, when the project references it, so it starts precompiled
      (when (File/Exists (Path/Combine (.BaseDirectory (AppDomain/CurrentDomain)) "clojure.tools.nrepl.dll"))
        (println "  Loading clojure.tools.nrepl...")
        (try (require 'clojure.tools.nrepl.impl.server 'clojure.tools.nrepl.server.middleware)
             (catch Exception e
               (warn "  Error loading clojure.tools.nrepl: " (.Message (root-cause e)))))))
    (if shared-ready?
      (do
        (println "  Standard library and clojure.core: shared runtime layer")
        ;; Startup namespaces the shared layer does not have (the project that
        ;; built it did not load them) go into this project's layer.
        (doseq [ns-sym (->> startup-namespaces
                            (remove #{'user})
                            (remove core-parts)
                            (remove (partial project-namespace? project-dirs))
                            (remove (partial compiled-in? lib-dir))
                            sort)]
          (compile! ns-sym)))
      (let [before (dlls)]
        ;; 2. The namespaces that were already loaded at startup have to be
        ;;    compiled explicitly.
        (doseq [ns-sym (->> startup-namespaces
                            (remove #{'user})
                            (remove core-parts)
                            (remove (partial project-namespace? project-dirs))
                            (sort-by (fn [ns-sym] [(get spec-first ns-sym 9) (str ns-sym)])))]
          (compile! ns-sym))
        ;; Not loaded at startup but part of every project: clojure.core.specs.alpha
        ;; is loaded by macro spec checking (off in this process), the others by
        ;; the REPL, by most applications and by the tooling (gitlibs only runs
        ;; for projects with git dependencies).
        (doseq [ns-sym '[clojure.core.specs.alpha clojure.repl clojure.pprint clojure.set
                         clojure.edn clojure.msbuild.gitlibs]
                :when (not (project-namespace? project-dirs ns-sym))
                :when (not (compiled-in? lib-dir ns-sym))]
          (compile! ns-sym))
        ;; 3. clojure.core last: after reloading it nothing else can be compiled
        ;;    in this process.
        (compile! 'clojure.core)
        (reset! shared-files (sort (remove before (dlls))))))
    ;; 4. Project namespaces emitted in step 1 belong to the build layer.
    (doseq [dll (Directory/GetFiles lib-dir "*.dll")
            :when (project-compiled-file? project-dirs dll)]
      (delete-with-pdb! dll))
    ;; 5. Native code for everything, so that processes start without JIT.
    (let [compiled? (ready-to-run! lib-dir crossgen (when-not shared-ready? clojure-dll)
                                   (when shared-ready? shared-dir))]
      ;; 6. Share the version-dependent part with other projects.
      (when (and shared? (not shared-ready?) (empty? @failures) compiled?)
        (publish-shared-layer! shared-dir (filter #(File/Exists ^String %) @shared-files)
                               (Path/Combine lib-dir "runtime"))))
    (let [n (count (Directory/GetFiles lib-dir "*.dll"))
          secs (long (.TotalSeconds (.Subtract DateTime/UtcNow started)))]
      (println (str "Library layer: " n " assemblies in " secs " s"))
      (when (seq @failures)
        (warn "warning: " (count @failures) " library namespace(s) could not be precompiled and will be loaded from source: "
              (str/join " " @failures))))))

;; ── Entry point (--clj-mode dispatch) ────────────────────────────

(defn -main
  "Dispatch based on --clj-mode argument. Called by the generated entry point
   when the project is invoked with --clj-mode instead of normal app startup."
  [& args]
  (let [args-vec (vec args)
        mode (first args-vec)
        rest-args (rest args-vec)]
    (case mode
      "repl"           (run-repl)
      "nrepl"          (run-nrepl (first rest-args))
      "script"         (run-script (first rest-args))
      "test"           (run-tests rest-args)
      "test-namespace" (run-tests (take 1 rest-args))
      "test-vars"      (run-tests rest-args)
      "test-watch"     (test-runner/watch (split-dirs (first rest-args)))
      "build"          (let [[namespaces compile-path lib-dir project-dirs] rest-args]
                         (build namespaces compile-path lib-dir project-dirs))
      "build-libs"     (let [[lib-dir main-ns project-dirs shared-dir crossgen clojure-dll] rest-args]
                         (build-libs lib-dir main-ns project-dirs shared-dir crossgen clojure-dll))
      "compile"        (compile-namespaces (first rest-args) (second rest-args))
      (do (println (str "Unknown mode: " mode))
          (println "Valid modes: repl, nrepl, script, test, test-watch, test-namespace, test-vars, build, build-libs, compile")
          (Environment/Exit 1)))))
