(ns clojure.msbuild.test-adapter
  "VSTest adapter for discovering and running Clojure tests.
   Single gen-class implementing both ITestDiscoverer and ITestExecutor
   so everything lands in one DLL for VSTest discovery.

   Discovery scans test/**/*_test.cljr (.cljc, .clj) for deftest and defspec
   forms. The build writes <assembly>.clojure.edn next to the test assembly
   with the project directory; assemblies without it (and without a test
   directory three levels up, the layout of older versions) are not
   Clojure test assemblies.

   Execution runs the test assembly with --clj-mode test (or test-vars for a
   filtered or selected subset) and reads the result lines that
   clojure.msbuild.test-runner prints, one per test var, so every test is
   reported individually with its failures, stack trace and output."
  (:require [clojure.string :as str]
            [clojure.edn :as edn])
  (:import [System Uri DateTimeOffset TimeSpan Environment]
           [System.Diagnostics Process ProcessStartInfo]
           [System.IO Directory Path File SearchOption]
           [System.Text StringBuilder]
           [System.Text.RegularExpressions Regex RegexOptions]
           [Microsoft.VisualStudio.TestPlatform.ObjectModel
            TestCase TestResult TestOutcome TestResultMessage
            FileExtensionAttribute DefaultExecutorUriAttribute ExtensionUriAttribute]
           [Microsoft.VisualStudio.TestPlatform.ObjectModel.Adapter
            ITestDiscoverer ITestExecutor
            IDiscoveryContext IRunContext IFrameworkHandle ITestCaseDiscoverySink]
           [Microsoft.VisualStudio.TestPlatform.ObjectModel.Logging
            IMessageLogger TestMessageLevel]))

;; ── Constants ────────────────────────────────────────────────────

(def executor-uri-string "executor://clojuretestexecutor/v1")
(def ^Uri executor-uri (Uri. executor-uri-string))
(def result-prefix "CLJTEST")
(def edn-prefix "CLJTEST-EDN")

;; ── Single gen-class: both discoverer + executor ─────────────────

(gen-class
  :name Clojure.MSBuild.TestAdapter.ClojureTestAdapter
  :implements [Microsoft.VisualStudio.TestPlatform.ObjectModel.Adapter.ITestDiscoverer
               Microsoft.VisualStudio.TestPlatform.ObjectModel.Adapter.ITestExecutor]
  :class-attributes {FileExtensionAttribute #{ ".dll" ".exe" }
                     DefaultExecutorUriAttribute "executor://clojuretestexecutor/v1"
                     ExtensionUriAttribute "executor://clojuretestexecutor/v1"}
  :state state
  :init init
  :prefix "adapter-")

;; ── Discovery ────────────────────────────────────────────────────

(defn- project-config
  "{:project-dir ..} from the <assembly>.clojure.edn the build writes next to
   the test assembly, or the project three levels up (bin/<config>/<tfm>/),
   the layout older versions assumed, or nil."
  [source]
  (let [marker (Path/ChangeExtension ^String source ".clojure.edn")]
    (if (File/Exists marker)
      (try (edn/read-string (File/ReadAllText marker)) (catch Exception _ nil))
      (let [dir (Path/GetFullPath (Path/Combine (Path/GetDirectoryName ^String source) ".." ".." ".."))]
        (when (File/Exists (Path/Combine dir "test"))
          {:project-dir dir})))))

(defn- project-dir [source]
  (or (:project-dir (project-config source))
      (Path/GetDirectoryName ^String source)))

(defn- test-dir [source]
  (when-let [{:keys [project-dir test-dir]} (project-config source)]
    (let [dir (Path/Combine ^String project-dir (or test-dir "test"))]
      (when (Directory/Exists dir) dir))))

(defn- file->ns-name [test-dir test-file]
  (let [relative (Path/GetRelativePath test-dir test-file)
        no-ext (subs relative 0 (- (count relative) (count (Path/GetExtension relative))))]
    (-> no-ext
        (.Replace (char Path/DirectorySeparatorChar) \.)
        (.Replace \_ \-))))

(def ^:private ns-pattern
  (Regex. "^\\s*\\(ns\\s+(?:\\^(?:\\{[^}]*\\}|\\S+)\\s+)*([^\\s()\\[\\]{}]+)" RegexOptions/Multiline))

;; deftest/defspec forms that are not commented out with #_
(def ^:private test-pattern
  (Regex. "(?<!#_\\s*)\\((?:deftest|defspec)\\s+(?:\\^(?:\\{[^}]*\\}|\\S+)\\s+)*([^\\s()\\[\\]{}]+)"))

(defn- test-files [dir]
  (mapcat #(Directory/GetFiles dir % SearchOption/AllDirectories)
          ["*_test.cljr" "*_test.cljc" "*_test.clj"]))

(defn discover-test-cases
  "Scans the project's test directory and returns a map of
   \"ns/test-name\" -> TestCase for the given source assembly."
  [source]
  (if-let [dir (test-dir source)]
    (into {}
      (for [test-file (test-files dir)
            :let [content (File/ReadAllText test-file)
                  ns-match (.Match ns-pattern content)
                  ns-name (if (.Success ns-match)
                            (.Value (.get_Item (.Groups ns-match) 1))
                            (file->ns-name dir test-file))]
            m (.Matches test-pattern content)
            :let [test-name (str (.Value (.get_Item (.Groups m) 1)))
                  line-num (-> (.Substring content 0 (.Index m))
                               (.Split (char-array "\n"))
                               count)
                  full-name (str ns-name "/" test-name)
                  test-case (TestCase. full-name executor-uri source)]]
        (do
          (set! (.-DisplayName test-case) test-name)
          (set! (.-CodeFilePath test-case) test-file)
          (set! (.-LineNumber test-case) line-num)
          (.Add (.-Traits test-case) "Namespace" ns-name)
          [full-name test-case])))
    {}))

;; ── Running the test process ─────────────────────────────────────

(defn- dotnet-host
  "Path of the dotnet host to run the test assembly with. Prefer the host that
   is running this process so the same SDK/runtime is used as for the build."
  []
  (or (not-empty (Environment/GetEnvironmentVariable "DOTNET_HOST_PATH"))
      (let [p (Environment/ProcessPath)]
        (when (and p (.StartsWith (Path/GetFileNameWithoutExtension p) "dotnet")) p))
      "dotnet"))

(defn- result-line? [^String line]
  (.StartsWith line result-prefix))

(defn- run-process
  "Runs the test assembly with the given --clj-mode arguments, streaming its
   output to the framework handle. Returns {:exit :output :errors}."
  [assembly args project-dir ^IFrameworkHandle framework-handle]
  (let [start-info (doto (ProcessStartInfo.)
                     (-> .-FileName (set! (dotnet-host)))
                     (-> .-WorkingDirectory (set! project-dir))
                     (-> .-RedirectStandardOutput (set! true))
                     (-> .-RedirectStandardError (set! true))
                     (-> .-UseShellExecute (set! false))
                     (-> .-CreateNoWindow (set! true)))
        _ (doseq [a (concat [assembly "--clj-mode"] args)]
            (.Add (.ArgumentList start-info) a))
        _ (.set_Item (.Environment start-info) "CLOJURE_MSBUILD_TEST_FORMAT" "edn")
        output (StringBuilder.)
        errors (StringBuilder.)
        process (Process/Start start-info)]
    (.add_OutputDataReceived process
      (gen-delegate System.Diagnostics.DataReceivedEventHandler [s e]
        (when-let [data (.-Data e)]
          (locking output (.AppendLine output data))
          (when-not (or (String/IsNullOrEmpty data) (result-line? data))
            (.SendMessage framework-handle TestMessageLevel/Informational data)))))
    (.add_ErrorDataReceived process
      (gen-delegate System.Diagnostics.DataReceivedEventHandler [s e]
        (when-let [data (.-Data e)]
          (locking errors (.AppendLine errors data))
          (when-not (String/IsNullOrEmpty data)
            (.SendMessage framework-handle TestMessageLevel/Warning data)))))
    (.BeginOutputReadLine process)
    (.BeginErrorReadLine process)
    (.WaitForExit process)
    {:exit (.ExitCode process)
     :output (locking output (.ToString output))
     :errors (locking errors (.ToString errors))}))

(defn- parse-results
  "Parses the result lines into {:results {\"ns/name\" result} :load-errors
   {\"ns\" message}}. Both the edn lines and the original tab-separated ones
   (from older versions of Clojure.MSBuild) are understood."
  [output]
  (reduce
    (fn [acc ^String line]
      (cond
        (.StartsWith line (str edn-prefix "\t"))
        (let [r (try (edn/read-string (subs line (inc (count edn-prefix)))) (catch Exception _ nil))]
          (cond
            (:load-error r) (assoc-in acc [:load-errors (:load-error r)] (:message r))
            (:test r) (assoc-in acc [:results (:test r)] r)
            :else acc))

        (.StartsWith line (str result-prefix "\t"))
        (let [[_ full-name outcome ms message] (str/split line #"\t" 5)]
          (assoc-in acc [:results full-name]
                    {:test full-name
                     :outcome outcome
                     :ms (try (Int64/Parse ms) (catch Exception _ 0))
                     :message message}))

        :else acc))
    {:results {} :load-errors {}}
    (str/split-lines output)))

(defn- record-result! [^IFrameworkHandle framework-handle ^TestCase test-case {:keys [outcome ms message stack output]}]
  (let [result (TestResult. test-case)
        now (DateTimeOffset/Now)
        duration (TimeSpan/FromMilliseconds (double (or ms 0)))]
    (set! (.-Outcome result) (case outcome
                               "pass" TestOutcome/Passed
                               "fail" TestOutcome/Failed
                               "skip" TestOutcome/Skipped
                               "not-found" TestOutcome/NotFound
                               TestOutcome/None))
    (set! (.-StartTime result) (.Subtract now duration))
    (set! (.-EndTime result) now)
    (set! (.-Duration result) duration)
    (when-not (str/blank? message)
      (set! (.-ErrorMessage result) message))
    (when-not (str/blank? stack)
      (set! (.-ErrorStackTrace result) stack))
    (when-not (str/blank? output)
      (.Add (.-Messages result) (TestResultMessage. TestResultMessage/StandardOutCategory output)))
    (.RecordStart framework-handle test-case)
    (.RecordEnd framework-handle test-case (.-Outcome result))
    (.RecordResult framework-handle result)))

;; ── Test case filters (dotnet test --filter) ─────────────────────

(def ^:private filter-properties
  (into-array String ["FullyQualifiedName" "DisplayName" "Namespace"]))

(defn- test-case-property [^TestCase t ^String property]
  (case property
    "FullyQualifiedName" (.FullyQualifiedName t)
    "DisplayName" (.DisplayName t)
    "Namespace" (some (fn [tr] (when (= "Namespace" (.Name tr)) (.Value tr))) (.-Traits t))
    nil))

(defn- apply-filter
  "Keeps only the test cases matching the run's --filter expression, if any."
  [^IRunContext run-context cases]
  (let [expression (try
                     (.GetTestCaseFilter run-context filter-properties nil)
                     (catch Exception _ nil))]
    (if (nil? expression)
      cases
      (into {}
        (filter (fn [[_ ^TestCase t]]
                  (.MatchTestCase expression t
                    (sys-func [String Object] [property] (test-case-property t property))))
                cases)))))

(defn- missing-result
  "The result of an expected test that reported nothing: its namespace did
   not load, the process failed, or (after a clean run) the test does not
   exist, e.g. a deftest the discovery regex found in a comment."
  [full-name {:keys [exit errors]} load-errors]
  (let [ns-name (subs full-name 0 (max 0 (.IndexOf ^String full-name "/")))]
    (cond
      (load-errors ns-name)
      {:outcome "fail" :ms 0 :message (str "Could not load " ns-name ":\n" (load-errors ns-name))}

      (zero? exit)
      {:outcome "not-found" :ms 0 :message "The test run completed without running this test"}

      :else
      {:outcome "fail"
       :ms 0
       :message (str "No result was reported for this test (test process exited with code " exit ")"
                     (when-not (str/blank? errors) (str ":\n" (str/trim errors))))})))

(defn- run-and-record!
  "Runs the process and records one result per expected test case. With
   report-extra?, tests that ran but were not discovered (e.g. new files) are
   reported as well."
  [assembly args project-dir framework-handle expected-cases report-extra?]
  (let [{:keys [exit errors output] :as run} (run-process assembly args project-dir framework-handle)
        {:keys [results load-errors]} (parse-results output)]
    (doseq [[full-name ^TestCase test-case] expected-cases]
      (record-result! framework-handle test-case
                      (or (results full-name) (missing-result full-name run load-errors))))
    (doseq [[full-name result] results
            :when (and report-extra? (not (contains? expected-cases full-name)))
            :let [test-case (TestCase. full-name executor-uri assembly)]]
      (set! (.-DisplayName test-case) (subs full-name (inc (.IndexOf ^String full-name "/"))))
      (when-let [file (:file result)] (set! (.-CodeFilePath test-case) file))
      (when-let [line (:line result)] (set! (.-LineNumber test-case) (int line)))
      (record-result! framework-handle test-case result))
    (when (and (empty? results) (not= 0 exit))
      (.SendMessage framework-handle TestMessageLevel/Error
        (str "Test run failed with exit code " exit ": " errors)))))

;; ── Adapter implementation ───────────────────────────────────────

(defn adapter-init []
  [[] (atom false)])

;; ITestDiscoverer.DiscoverTests
(defn adapter-DiscoverTests [this sources discovery-context ^IMessageLogger logger ^ITestCaseDiscoverySink discovery-sink]
  (doseq [source sources
          :let [cases (discover-test-cases source)]
          :when (seq cases)]
    (.SendMessage logger TestMessageLevel/Informational
      (str "Found " (count cases) " Clojure tests in " source))
    (doseq [[_ test-case] cases]
      (.SendTestCase discovery-sink test-case))))

;; ITestExecutor.Cancel
(defn adapter-Cancel [this]
  (reset! (.state this) true))

;; ITestExecutor.RunTests (handles both overloads via type dispatch)
(defn adapter-RunTests [this sources-or-tests run-context ^IFrameworkHandle framework-handle]
  (let [cancelled? (.state this)
        first-item (first sources-or-tests)]
    (if (instance? TestCase first-item)
      ;; Overload: RunTests(IEnumerable<TestCase>, ...) - only the selected tests
      (doseq [[source tests] (group-by (fn [^TestCase t] (.Source t)) sources-or-tests)
              :when (not @cancelled?)
              :let [expected (into {} (map (fn [^TestCase t] [(.FullyQualifiedName t) t]) tests))]]
        (run-and-record! source (cons "test-vars" (keys expected)) (project-dir source) framework-handle expected false))

      ;; Overload: RunTests(IEnumerable<string>, ...) - whole assemblies, honouring --filter
      (doseq [source sources-or-tests
              :when (not @cancelled?)
              :when (test-dir source)
              :let [discovered (discover-test-cases source)
                    selected (apply-filter run-context discovered)]]
        (cond
          (= (count selected) (count discovered))
          (run-and-record! source ["test"] (project-dir source) framework-handle discovered true)

          (seq selected)
          (run-and-record! source (cons "test-vars" (keys selected))
                           (project-dir source) framework-handle selected false)

          :else
          (.SendMessage framework-handle TestMessageLevel/Informational
            (str "No Clojure tests match the filter in " source)))))))
