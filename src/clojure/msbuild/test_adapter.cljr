(ns clojure.msbuild.test-adapter
  "VSTest adapter for discovering and running Clojure tests.
   Single gen-class implementing both ITestDiscoverer and ITestExecutor
   so everything lands in one DLL for VSTest discovery.

   Discovery scans test/**/*_test.cljr (.cljc, .clj) for deftest and defspec
   forms. The build writes <assembly>.clojure.edn next to the test assembly
   with the project directory; assemblies without it (and without a test
   directory three levels up, the layout of older versions) are not
   Clojure test assemblies.

   Execution runs the test assembly with --clj-mode test (or test-vars for a
   filtered or selected subset) and reads the result lines that
   clojure.msbuild.test-runner prints, one per test var, so every test is
   reported individually with its failures, stack trace and output."
  (:require [clojure.string :as str]
            [clojure.edn :as edn])
  (:import [System Uri DateTimeOffset TimeSpan Environment Guid Int64]
           [System.Diagnostics Process ProcessStartInfo]
           [System.IO Directory Path File SearchOption StringReader]
           [System.Text StringBuilder]
           [System.Text.RegularExpressions Regex RegexOptions Match]
           [Microsoft.VisualStudio.TestPlatform.ObjectModel
            TestCase TestResult TestOutcome TestResultMessage
            FileExtensionAttribute DefaultExecutorUriAttribute ExtensionUriAttribute]
           [Microsoft.VisualStudio.TestPlatform.ObjectModel.Adapter
            ITestDiscoverer ITestExecutor
            IDiscoveryContext IRunContext IFrameworkHandle ITestCaseDiscoverySink]
           [Microsoft.VisualStudio.TestPlatform.ObjectModel.Logging
            IMessageLogger TestMessageLevel]))

;; ── Constants ────────────────────────────────────────────────────

(def executor-uri-string "executor://clojuretestexecutor/v1")
(def ^Uri executor-uri (Uri. executor-uri-string))
(def result-prefix "CLJTEST")
(def edn-prefix "CLJTEST-EDN")

;; ── Single gen-class: both discoverer + executor ─────────────────

(gen-class
  :name Clojure.MSBuild.TestAdapter.ClojureTestAdapter
  :implements [Microsoft.VisualStudio.TestPlatform.ObjectModel.Adapter.ITestDiscoverer
               Microsoft.VisualStudio.TestPlatform.ObjectModel.Adapter.ITestExecutor]
  :class-attributes {FileExtensionAttribute #{ ".dll" ".exe" }
                     DefaultExecutorUriAttribute "executor://clojuretestexecutor/v1"
                     ExtensionUriAttribute "executor://clojuretestexecutor/v1"}
  :state state
  :init init
  :prefix "adapter-")

;; ── Discovery ────────────────────────────────────────────────────

(defn- project-config
  "{:project-dir ..} from the <assembly>.clojure.edn the build writes next to
   the test assembly, or the project three levels up (bin/<config>/<tfm>/),
   the layout older versions assumed, or nil."
  [source]
  (let [marker (Path/ChangeExtension ^String source ".clojure.edn")]
    (if (File/Exists marker)
      (try (edn/read-string (File/ReadAllText marker)) (catch Exception _ nil))
      (let [dir (Path/GetFullPath (Path/Combine (Path/GetDirectoryName ^String source) ".." ".." ".."))]
        (when (File/Exists (Path/Combine dir "test"))
          {:project-dir dir})))))

(defn- project-dir [source]
  (or (:project-dir (project-config source))
      (Path/GetDirectoryName ^String source)))

(defn- test-dir [source]
  (when-let [{:keys [project-dir test-dir]} (project-config source)]
    (let [dir (Path/Combine ^String project-dir (or (not-empty test-dir) "test"))]
      (when (Directory/Exists dir) dir))))

(defn- test-suffix [source]
  (or (not-empty (:test-suffix (project-config source))) "_test"))

(defn- file->ns-name [test-dir test-file]
  (let [relative (Path/GetRelativePath test-dir test-file)
        no-ext (subs relative 0 (- (count relative) (count (Path/GetExtension relative))))]
    (-> no-ext
        (.Replace (char Path/DirectorySeparatorChar) \.)
        (.Replace \_ \-))))

;; ── Finding tests: with the reader ───────────────────────────────

(def ^:private test-macros #{"deftest" "defspec"})

;; ::alias/kw needs the alias to be known to read; the resolver accepts any
;; alias without creating namespaces in the test host process.
(def ^:private reader-resolver
  (reify clojure.lang.LispReader+Resolver
    (CurrentNS [_] 'user)
    (ResolveClass [_ sym] sym)
    (ResolveAlias [_ sym] sym)
    (ResolveVar [_ sym] sym)))

(defn read-forms
  "All top-level forms of a source string, with :line metadata. Nothing is
   evaluated. Throws if the source cannot be read."
  [^String content]
  (let [rdr (clojure.lang.LineNumberingTextReader. (StringReader. content))
        resolver-var (resolve 'clojure.core/*reader-resolver*)]
    (with-bindings (cond-> {#'*read-eval* false
                            #'*default-data-reader-fn* (fn [_ v] v)}
                     resolver-var (assoc resolver-var reader-resolver))
      (loop [forms []]
        (let [form (read {:read-cond :allow :features #{:cljr} :eof ::eof} rdr)]
          (if (= ::eof form)
            forms
            (recur (conj forms form))))))))

(defn- form-head [form]
  (when (and (seq? form) (symbol? (first form)))
    (name (first form))))

(defn find-tests
  "{:ns name-or-nil :tests [[name line] ...]} of source forms: deftest and
   defspec forms (also qualified, e.g. t/deftest), at the top level or
   inside other forms such as when, but not inside comment, quote or a
   macro definition. #_ forms are dropped by the reader."
  [forms]
  (let [ns-form (first (filter #(= "ns" (form-head %)) forms))
        tests (atom [])]
    (letfn [(walk [form]
              (when (seq? form)
                (let [head (form-head form)]
                  (cond
                    (#{"comment" "quote" "defmacro"} head) nil
                    (and (test-macros head) (symbol? (second form)))
                    (swap! tests conj [(name (second form)) (or (:line (meta form)) 1)])
                    :else (run! walk form)))))]
      (run! walk forms))
    {:ns (when (symbol? (second ns-form)) (str (second ns-form)))
     :tests @tests}))

;; ── Finding tests: with regular expressions (unreadable files) ───

(def ^:private ns-pattern
  (Regex. "^\\s*\\(ns\\s+(?:\\^(?:\\{[^}]*\\}|\\S+)\\s+)*([^\\s()\\[\\]{}]+)" RegexOptions/Multiline))

;; deftest/defspec forms that are not commented out with #_
(def ^:private test-pattern
  (Regex. "(?<!#_\\s*)\\((?:[\\w.\\-]+/)?(?:deftest|defspec)\\s+(?:\\^(?:\\{[^}]*\\}|\\S+)\\s+)*([^\\s()\\[\\]{}]+)"))

(defn- line-starts
  "Indexes at which the lines of content start."
  [^String content]
  (loop [i 0 starts [0]]
    (let [j (.IndexOf content \newline i)]
      (if (neg? j) starts (recur (inc j) (conj starts (inc j)))))))

(defn- line-of
  "The 1-based line of index: the number of line starts at or before it."
  [starts index]
  (loop [lo 0 hi (count starts)]
    (if (< lo hi)
      (let [mid (quot (+ lo hi) 2)]
        (if (<= (nth starts mid) index) (recur (inc mid) hi) (recur lo mid)))
      lo)))

(defn find-tests-by-regex
  "Like find-tests, for a file the reader cannot read (e.g. a syntax error:
   its tests are still listed, and then fail with the compiler error)."
  [^String content]
  (let [ns-match (.Match ^Regex ns-pattern content)
        starts (line-starts content)]
    {:ns (when (.Success ns-match) (.Value (.get_Item (.Groups ns-match) 1)))
     :tests (vec (for [^Match m (.Matches ^Regex test-pattern content)]
                   [(str (.Value (.get_Item (.Groups m) 1))) (line-of starts (.Index m))]))}))

(defn tests-in-source
  "{:ns :tests} of a source string, with the reader when it can read it."
  [^String content]
  (try (find-tests (read-forms content))
       (catch Exception _ (find-tests-by-regex content))))

(defn- test-files [dir suffix]
  (->> [".cljr" ".cljc" ".clj"]
       (mapcat (fn [ext]
                 (filter #(.EndsWith ^String % (str suffix ext))
                         (Directory/GetFiles dir (str "*" suffix ext) SearchOption/AllDirectories))))
       distinct))

(defn discover-test-cases
  "Scans the project's test directory and returns a map of
   \"ns/test-name\" -> TestCase for the given source assembly."
  [source]
  (if-let [dir (test-dir source)]
    (into {}
      (for [test-file (test-files dir (test-suffix source))
            :let [{:keys [ns tests]} (tests-in-source (File/ReadAllText test-file))
                  ns-name (or ns (file->ns-name dir test-file))]
            [test-name line-num] (distinct tests)
            :let [full-name (str ns-name "/" test-name)
                  test-case (TestCase. full-name executor-uri source)]]
        (do
          (set! (.-DisplayName test-case) test-name)
          (set! (.-CodeFilePath test-case) test-file)
          (set! (.-LineNumber test-case) (int line-num))
          (.Add (.-Traits test-case) "Namespace" ns-name)
          [full-name test-case])))
    {}))

;; ── Running the test process ─────────────────────────────────────

(defn- dotnet-host
  "Path of the dotnet host to run the test assembly with. Prefer the host that
   is running this process so the same SDK/runtime is used as for the build."
  []
  (or (not-empty (Environment/GetEnvironmentVariable "DOTNET_HOST_PATH"))
      (let [p (Environment/ProcessPath)]
        (when (and p (.StartsWith (Path/GetFileNameWithoutExtension p) "dotnet")) p))
      "dotnet"))

(defn- result-line? [^String line]
  (.StartsWith line result-prefix))

(defn quote-arg
  "One command-line argument, quoted for a Windows-style command line (the
   form LaunchProcessWithDebuggerAttached takes)."
  [^String a]
  (if (and (seq a) (not (re-find #"[\s\"]" a)))
    a
    (str "\"" (-> a (str/replace #"(\\*)\"" "$1$1\\\"") (str/replace #"(\\+)$" "$1$1")) "\"")))

(defn- kill-tree! [^Process p]
  (try (when-not (.HasExited p) (.Kill p true)) (catch Exception _)))

(defn- run-process
  "Runs the test assembly with the given --clj-mode arguments, streaming its
   output to the framework handle. Returns {:exit :output :errors :results-file
   :timed-out? :cancelled?}.

   The test runner also appends its result lines to results-file, which is
   what is read when it exists: the output can interleave a line with what a
   test printed, and under a debugger it is not captured at all.

   opts: :debug? (start through the IDE's debugger), :timeout-ms (kill the
   process after that), :state (the adapter's state atom; the process is
   kept there so that Cancel can kill it)."
  [assembly args project-dir ^IFrameworkHandle framework-handle {:keys [debug? timeout-ms state]}]
  (let [results-file (Path/Combine (Path/GetTempPath) (str "clojure-tests-" (Guid/NewGuid) ".edn"))
        env {"CLOJURE_MSBUILD_TEST_FORMAT" "edn"
             "CLOJURE_MSBUILD_TEST_RESULTS" results-file}
        argv (concat [assembly "--clj-mode"] args)
        output (StringBuilder.)
        errors (StringBuilder.)
        ^Process process
        (if debug?
          (let [vars (|System.Collections.Generic.Dictionary`2[System.String,System.String]|.)]
            (doseq [[k v] env] (.set_Item vars k v))
            (let [pid (.LaunchProcessWithDebuggerAttached framework-handle (dotnet-host) project-dir
                                                          (str/join " " (map quote-arg argv)) vars)]
              (try (Process/GetProcessById pid) (catch Exception _ nil))))
          (let [start-info (doto (ProcessStartInfo.)
                             (-> .-FileName (set! (dotnet-host)))
                             (-> .-WorkingDirectory (set! project-dir))
                             (-> .-RedirectStandardOutput (set! true))
                             (-> .-RedirectStandardError (set! true))
                             (-> .-UseShellExecute (set! false))
                             (-> .-CreateNoWindow (set! true)))]
            (doseq [a argv] (.Add (.ArgumentList start-info) a))
            (doseq [[k v] env] (.set_Item (.Environment start-info) k v))
            (let [p (Process/Start start-info)]
              (.add_OutputDataReceived p
                (gen-delegate System.Diagnostics.DataReceivedEventHandler [s e]
                  (when-let [data (.-Data e)]
                    (locking output (.AppendLine output data))
                    (when-not (or (String/IsNullOrEmpty data) (result-line? data))
                      (.SendMessage framework-handle TestMessageLevel/Informational data)))))
              (.add_ErrorDataReceived p
                (gen-delegate System.Diagnostics.DataReceivedEventHandler [s e]
                  (when-let [data (.-Data e)]
                    (locking errors (.AppendLine errors data))
                    (when-not (String/IsNullOrEmpty data)
                      (.SendMessage framework-handle TestMessageLevel/Warning data)))))
              (.BeginOutputReadLine p)
              (.BeginErrorReadLine p)
              p)))
        _ (when state (swap! state assoc :process process))
        exited? (cond
                  (nil? process) true
                  timeout-ms (.WaitForExit process (int timeout-ms))
                  :else (do (.WaitForExit process) true))]
    (when-not exited?
      (kill-tree! process)
      (.WaitForExit process))
    (when (and process exited? (not debug?))
      ;; drain the asynchronous output readers
      (.WaitForExit process))
    (when state (swap! state assoc :process nil))
    {:exit (when (and process (not debug?)) (try (.ExitCode process) (catch Exception _ nil)))
     :output (locking output (.ToString output))
     :errors (locking errors (.ToString errors))
     :results-file results-file
     :timed-out? (not exited?)
     :timeout-ms timeout-ms
     :cancelled? (boolean (and state (:cancelled? @state)))}))

(defn- parse-results
  "Parses the result lines into {:results {\"ns/name\" result} :load-errors
   {\"ns\" message}}. Both the edn lines and the original tab-separated ones
   (from older versions of Clojure.MSBuild) are understood."
  [output]
  (reduce
    (fn [acc ^String line]
      (cond
        (.StartsWith line (str edn-prefix "\t"))
        (let [r (try (edn/read-string (subs line (inc (count edn-prefix)))) (catch Exception _ nil))]
          (cond
            (:load-error r) (assoc-in acc [:load-errors (:load-error r)] (:message r))
            (:test r) (assoc-in acc [:results (:test r)] r)
            :else acc))

        (.StartsWith line (str result-prefix "\t"))
        (let [[_ full-name outcome ms message] (str/split line #"\t" 5)]
          (assoc-in acc [:results full-name]
                    {:test full-name
                     :outcome outcome
                     :ms (try (Int64/Parse ms) (catch Exception _ 0))
                     :message message}))

        :else acc))
    {:results {} :load-errors {}}
    (str/split-lines output)))

(defn- record-result! [^IFrameworkHandle framework-handle ^TestCase test-case {:keys [outcome ms message stack output]}]
  (let [result (TestResult. test-case)
        now (DateTimeOffset/Now)
        duration (TimeSpan/FromMilliseconds (double (or ms 0)))]
    (set! (.-Outcome result) (case outcome
                               "pass" TestOutcome/Passed
                               "fail" TestOutcome/Failed
                               "skip" TestOutcome/Skipped
                               "not-found" TestOutcome/NotFound
                               TestOutcome/None))
    (set! (.-StartTime result) (.Subtract now duration))
    (set! (.-EndTime result) now)
    (set! (.-Duration result) duration)
    (when-not (str/blank? message)
      (set! (.-ErrorMessage result) message))
    (when-not (str/blank? stack)
      (set! (.-ErrorStackTrace result) stack))
    (when-not (str/blank? output)
      (.Add (.-Messages result) (TestResultMessage. TestResultMessage/StandardOutCategory output)))
    (.RecordStart framework-handle test-case)
    (.RecordEnd framework-handle test-case (.-Outcome result))
    (.RecordResult framework-handle result)))

;; ── Test case filters (dotnet test --filter) ─────────────────────

(def ^:private filter-properties
  (into-array String ["FullyQualifiedName" "DisplayName" "Namespace"]))

(defn- test-case-property [^TestCase t ^String property]
  (case property
    "FullyQualifiedName" (.FullyQualifiedName t)
    "DisplayName" (.DisplayName t)
    "Namespace" (some (fn [tr] (when (= "Namespace" (.Name tr)) (.Value tr))) (.-Traits t))
    nil))

(defn- apply-filter
  "Keeps only the test cases matching the run's --filter expression, if any."
  [^IRunContext run-context cases]
  (let [expression (try
                     (.GetTestCaseFilter run-context filter-properties nil)
                     (catch Exception _ nil))]
    (if (nil? expression)
      cases
      (into {}
        (filter (fn [[_ ^TestCase t]]
                  (.MatchTestCase expression t
                    (sys-func [String Object] [property] (test-case-property t property))))
                cases)))))

(defn- missing-result
  "The result of an expected test that reported nothing: its namespace did
   not load, the run was cancelled or timed out, the process failed, or
   (after a clean run) the test does not exist, e.g. one that a macro only
   defines under some condition."
  [full-name {:keys [exit errors timed-out? timeout-ms cancelled?]} load-errors]
  (let [ns-name (subs full-name 0 (max 0 (.IndexOf ^String full-name "/")))]
    (cond
      (load-errors ns-name)
      {:outcome "fail" :ms 0 :message (str "Could not load " ns-name ":\n" (load-errors ns-name))}

      cancelled?
      {:outcome "skip" :ms 0 :message "The test run was cancelled"}

      timed-out?
      {:outcome "fail" :ms 0
       :message (str "The test run was stopped after " (quot timeout-ms 1000)
                     " s (ClojureTest/TimeoutSeconds in the run settings, or CLOJURE_MSBUILD_TEST_TIMEOUT) before this test reported a result")}

      (or (nil? exit) (zero? exit))
      {:outcome "not-found" :ms 0 :message "The test run completed without running this test"}

      :else
      {:outcome "fail"
       :ms 0
       :message (str "No result was reported for this test (test process exited with code " exit ")"
                     (when-not (str/blank? errors) (str ":\n" (str/trim errors))))})))

(defn- read-results-file [^String file]
  (when (File/Exists file)
    (try (let [text (File/ReadAllText file)]
           (when-not (str/blank? text) text))
         (catch Exception _ nil)
         (finally (try (File/Delete file) (catch Exception _))))))

(defn run-settings
  "{:timeout-ms ..} from the run settings XML (<RunSettings><ClojureTest>
   <TimeoutSeconds>60</TimeoutSeconds></ClojureTest>) or the
   CLOJURE_MSBUILD_TEST_TIMEOUT environment variable (seconds)."
  [^String settings-xml]
  (let [from-xml (when settings-xml
                   (some->> (re-find #"(?s)<ClojureTest>.*?<TimeoutSeconds>\s*(\d+)\s*</TimeoutSeconds>.*?</ClojureTest>" settings-xml)
                            second))
        from-env (some->> (Environment/GetEnvironmentVariable "CLOJURE_MSBUILD_TEST_TIMEOUT")
                          (re-matches #"\s*(\d+)\s*") second)
        seconds (some-> (or from-xml from-env) Int64/Parse)]
    {:timeout-ms (when (and seconds (pos? seconds)) (* 1000 seconds))}))

(defn- run-and-record!
  "Runs the process and records one result per expected test case. With
   report-extra?, tests that ran but were not discovered (e.g. generated by
   a macro) are reported as well."
  [assembly args project-dir framework-handle expected-cases report-extra? opts]
  (let [{:keys [exit errors output results-file] :as run}
        (run-process assembly args project-dir framework-handle opts)
        {:keys [results load-errors]} (parse-results (or (read-results-file results-file) output))]
    (doseq [[full-name ^TestCase test-case] expected-cases]
      (record-result! framework-handle test-case
                      (or (results full-name) (missing-result full-name run load-errors))))
    (doseq [[full-name result] results
            :when (and report-extra? (not (contains? expected-cases full-name)))
            :let [test-case (TestCase. full-name executor-uri assembly)]]
      (set! (.-DisplayName test-case) (subs full-name (inc (.IndexOf ^String full-name "/"))))
      (when-let [file (:file result)] (set! (.-CodeFilePath test-case) file))
      (when-let [line (:line result)] (set! (.-LineNumber test-case) (int line)))
      (record-result! framework-handle test-case result))
    (when (and (empty? results) exit (not= 0 exit))
      (.SendMessage framework-handle TestMessageLevel/Error
        (str "Test run failed with exit code " exit ": " errors)))))

;; ── Adapter implementation ───────────────────────────────────────

;; state: an atom {:cancelled? bool :process the running test process}
(defn adapter-init []
  [[] (atom {:cancelled? false :process nil})])

;; ITestDiscoverer.DiscoverTests
(defn adapter-DiscoverTests [this sources discovery-context ^IMessageLogger logger ^ITestCaseDiscoverySink discovery-sink]
  (doseq [source sources
          :let [cases (discover-test-cases source)]
          :when (seq cases)]
    (.SendMessage logger TestMessageLevel/Informational
      (str "Found " (count cases) " Clojure tests in " source))
    (doseq [[_ test-case] cases]
      (.SendTestCase discovery-sink test-case))))

;; ITestExecutor.Cancel: stop the running test process too
(defn adapter-Cancel [this]
  (let [{:keys [process]} (swap! (.state this) assoc :cancelled? true)]
    (when process (kill-tree! process))))

(defn- run-options [this ^IRunContext run-context]
  (merge {:state (.state this)
          :debug? (boolean (try (.IsBeingDebugged run-context) (catch Exception _ false)))}
         (run-settings (try (some-> run-context .RunSettings .SettingsXml) (catch Exception _ nil)))))

;; ITestExecutor.RunTests (handles both overloads via type dispatch)
(defn adapter-RunTests [this sources-or-tests ^IRunContext run-context ^IFrameworkHandle framework-handle]
  (swap! (.state this) assoc :cancelled? false)
  (let [state (.state this)
        cancelled? #(:cancelled? @state)
        opts (run-options this run-context)
        first-item (first sources-or-tests)]
    (if (instance? TestCase first-item)
      ;; Overload: RunTests(IEnumerable<TestCase>, ...) - only the selected tests
      (doseq [[source tests] (group-by (fn [^TestCase t] (.Source t)) sources-or-tests)
              :when (not (cancelled?))
              :let [expected (into {} (map (fn [^TestCase t] [(.FullyQualifiedName t) t]) tests))]]
        (run-and-record! source (cons "test-vars" (keys expected)) (project-dir source) framework-handle expected false opts))

      ;; Overload: RunTests(IEnumerable<string>, ...) - whole assemblies, honouring --filter
      (doseq [source sources-or-tests
              :when (not (cancelled?))
              :when (test-dir source)
              :let [discovered (discover-test-cases source)
                    selected (apply-filter run-context discovered)]]
        (cond
          (= (count selected) (count discovered))
          (run-and-record! source ["test"] (project-dir source) framework-handle discovered true opts)

          (seq selected)
          (run-and-record! source (cons "test-vars" (keys selected))
                           (project-dir source) framework-handle selected false opts)

          :else
          (.SendMessage framework-handle TestMessageLevel/Informational
            (str "No Clojure tests match the filter in " source)))))))
