(ns bank.bank-test
  "The bank on the local system: no Orleans, no database, every crash
   under the test's control. The runtime is the one the silos use, so the
   saga proved here is the saga the chaos demo runs; bank.postgres-test
   runs it on silos backed by PostgreSQL."
  (:require [clojure.test :refer [deftest is testing]]
            [clojure.test.check.generators :as gen]
            [clojure.test.check.properties :as prop]
            [clojure.test.check.clojure-test :refer [defspec]]
            [bank.account :refer [account]]
            [bank.audit :as audit]
            [bank.run :as run]
            [bank.transfer :refer [transfer]]
            [orleans.actors :as actors]
            [orleans.actors.local :as local]))

(defn- open!
  "Opens a run with n accounts of `opening` each."
  [system run-id n opening]
  (actors/call! system (run/run run-id) :run/open #:run{:accounts n :opening opening})
  (doseq [i (range n)
          :let [id (run/account-id run-id i)]]
    (actors/call! system (account id) :account/deposit #:transfer{:id (audit/opening-id id) :amount opening})))

(defn- start! [system run-id from to amount]
  (let [[n _] (actors/call! system (run/run run-id) :run/reserve 1)
        id (run/transfer-id run-id n)]
    [id (actors/call! system (transfer id) :transfer/start
                      #:transfer{:from (run/account-id run-id from) :to (run/account-id run-id to) :amount amount})]))

(defn- balance [system run-id i]
  (actors/call! system (account (run/account-id run-id i)) :account/get-balance))

(defn- settle!
  "Fires timers and reminders until no transfer has a reminder left, as the
   cluster does over time. Returns the number of rounds it took."
  [system]
  (loop [rounds 0]
    (local/run-timers! system)
    (local/run-reminders! system)
    (if (or (= rounds 50) (empty? @(:reminders system)))
      rounds
      (recur (inc rounds)))))

(deftest a-transfer-moves-money-once
  (let [system (local/system)]
    (open! system "r" 2 100)
    (let [[id reply] (start! system "r" 0 1 30)]
      (is (= :pending reply) "accepted, nothing moved yet")
      (is (= 100 (balance system "r" 0)))
      (is (= {:transfer/retry {:due 5000 :period 5000}} (local/reminders system (transfer id)))
          "the reminder is registered before anything moves")
      (local/run-timers! system)
      (is (= :done (actors/call! system (transfer id) :transfer/get-status)))
      (is (= [70 130] [(balance system "r" 0) (balance system "r" 1)]))
      (local/run-timers! system)
      (is (empty? (local/reminders system (transfer id))) "settled: the reminder is gone")
      (is (= :done (actors/call! system (transfer id) :transfer/start
                                 #:transfer{:from "r-a0" :to "r-a1" :amount 30}))
          "starting it again starts nothing")
      (settle! system)
      (is (= [70 130] [(balance system "r" 0) (balance system "r" 1)]))
      (is (:ok? (audit/audit system "r"))))))

(deftest a-transfer-without-funds-is-declined
  (let [system (local/system)]
    (open! system "r" 2 100)
    (let [[id _] (start! system "r" 0 1 101)]
      (settle! system)
      (is (= :declined (actors/call! system (transfer id) :transfer/get-status)))
      (is (= [100 100] [(balance system "r" 0) (balance system "r" 1)]))
      (is (= [:declined 101] ((juxt :entry/kind :entry/amount) (actors/call! system (account "r-a0") :account/entry id))))
      (is (:ok? (audit/audit system "r"))))))

(defn- kind [entry] (:entry/kind entry))

(deftest an-account-answers-a-repeated-message-from-its-journal
  (let [system (local/system)
        debit #:transfer{:id "t" :amount 60}]
    (actors/call! system (account "x") :account/deposit #:transfer{:id "open" :amount 100})
    (let [first-time (actors/call! system (account "x") :account/debit debit)]
      (is (= :debit (kind first-time)))
      (is (= first-time (actors/call! system (account "x") :account/debit debit)) "the same debit: the same entry")
      (is (= 40 (actors/call! system (account "x") :account/get-balance)) "and the money moved once"))
    (is (= :declined (kind (actors/call! system (account "x") :account/debit #:transfer{:id "u" :amount 60}))))
    (actors/call! system (account "x") :account/credit #:transfer{:id "v" :amount 500})
    (is (= :declined (kind (actors/call! system (account "x") :account/debit #:transfer{:id "u" :amount 60})))
        "a declined debit stays declined, even once there is money")
    (is (= [1 2 3 4] (map :entry/seq (audit/journal system "x"))) "four entries, no more")
    (is (= [100 40 40 540] (map :entry/balance (audit/journal system "x"))) "each with the balance after it")))

(deftest an-account-comes-back-from-the-end-of-its-journal
  (let [system (local/system)]
    (actors/call! system (account "x") :account/deposit #:transfer{:id "open" :amount 100})
    (actors/call! system (account "x") :account/debit #:transfer{:id "t" :amount 30})
    (let [system (local/restart system)]
      (is (= #:account{:id "x" :balance 70 :seq 2} (dissoc (actors/call! system (account "x") :account/summary) :account/at))
          "resumed from its last entry, without reading the others")
      (is (= :credit (kind (actors/call! system (account "x") :account/credit #:transfer{:id "u" :amount 5}))))
      (is (= 3 (:account/seq (actors/call! system (account "x") :account/summary)))))))

(deftest the-balance-at-any-moment
  (let [system (local/system)
        book (fn [type id amount] (:entry/at (actors/call! system (account "x") type #:transfer{:id id :amount amount})))
        t1 (book :account/deposit "open" 100)
        t2 (book :account/debit "a" 30)
        t3 (book :account/credit "b" 50)
        at (fn [t] (actors/call! system (account "x") :account/balance-at t))]
    (is (< t1 t2 t3))
    (is (= 0 (at (dec t1))) "before it was opened")
    (is (= [100 100 70 70 120 120] [(at t1) (at (dec t2)) (at t2) (at (dec t3)) (at t3) (at (+ t3 1000000))]))))

(deftest a-credit-is-never-booked-before-its-debit
  ;; Two silos whose clocks disagree by a second. The source account last
  ;; booked on the fast one, the destination on the slow one; the transfer
  ;; runs on the slow one. Its credit is still booked after its debit, so
  ;; at no moment is the money in both accounts, or in neither without
  ;; being on its way.
  (let [fast (local/system)
        slow (local/fork fast -1000000)]
    (open! fast "h" 1 100)
    (actors/call! slow (account "h-a1") :account/deposit #:transfer{:id (audit/opening-id "h-a1") :amount 100})
    (actors/call! fast (run/run "h") :run/open #:run{:accounts 2 :opening 100})
    (let [[id _] (start! slow "h" 0 1 40)]
      (settle! slow)
      (let [{:transfer/keys [debited-at credited-at]} (actors/call! slow (transfer id) :transfer/show)]
        (is (<= debited-at credited-at)))
      (let [books (audit/audit slow "h")]
        (is (:ok? books) (pr-str (:problems books)))))))

(deftest a-transfer-survives-a-crash-at-every-write
  ;; For each write a transfer causes (its own, the debit, the credit), a
  ;; run where the host dies right before it, and one where it dies right
  ;; after it; then the whole system restarts and the reminders do the rest.
  (doseq [phase [:before-write :after-write]
          nth-write (range 6)]
    (testing (str "crash " (name phase) " write " nth-write)
      (let [writes (atom 0)
            armed (atom false)
            system (local/system {:crash (fn [_ p]
                                           (when @armed
                                             (when (= p :before-write) (swap! writes inc))
                                             (and (= p phase) (= (inc nth-write) @writes))))})]
        (open! system "c" 2 100)
        (reset! armed true)
        (let [[id _] (try (start! system "c" 0 1 30) (catch Exception _ [(run/transfer-id "c" 0) nil]))
              _ (try (local/run-timers! system) (catch Exception _ nil))
              _ (reset! armed false)
              system (local/restart system)]
          (settle! system)
          (let [status (actors/call! system (transfer id) :transfer/get-status)
                books (audit/audit system "c")]
            (is (#{:done :blank} status) "finished, or never started")
            (when (and (= :done status) (= phase :before-write) (pos? nth-write))
              (is (:transfer/recovered? (actors/call! system (transfer id) :transfer/show))
                  "a crash after the start: its reminder finished it"))
            (is (= (if (= :done status) [70 130] [100 100]) [(balance system "c" 0) (balance system "c" 1)]))
            (is (:ok? books) (pr-str (:problems books)))))))))

;; ── Two activations of one actor ─────────────────────────────────

(deftest a-stale-activation-cannot-write-past-the-journal
  ;; While a cluster changes, an actor can be active on two silos at once,
  ;; each with the end of the journal it read. The seq decides: the first
  ;; append of seq 2 wins, the second is refused and that activation starts
  ;; over from the journal.
  (let [a (local/system)
        b (local/fork a)]
    (actors/call! a (account "x") :account/deposit #:transfer{:id "open" :amount 100})
    (is (= 100 (actors/call! b (account "x") :account/get-balance)) "active in b too, with 100")
    (is (= :debit (kind (actors/call! a (account "x") :account/debit #:transfer{:id "t1" :amount 60}))))
    (is (thrown-with-msg? Exception #"Journal conflict"
                          (actors/call! b (account "x") :account/debit #:transfer{:id "t2" :amount 60}))
        "b still believes in 100 at seq 1: its append of seq 2 is refused")
    (is (= :declined (kind (actors/call! b (account "x") :account/debit #:transfer{:id "t2" :amount 60})))
        "restarted from the journal, b sees 40")
    (is (= 40 (actors/call! a (account "x") :account/get-balance)))))

(deftest a-stale-transfer-cannot-overwrite-its-record
  ;; The same for an actor in grain storage: the ETag decides.
  (let [a (local/system)
        b (local/fork a)]
    (open! a "s" 2 100)
    (is (= :blank (actors/call! b (transfer "s-t9") :transfer/get-status)) "active in b, blank")
    (actors/call! a (transfer "s-t9") :transfer/start #:transfer{:from "s-a0" :to "s-a1" :amount 5})
    (is (thrown-with-msg? Exception #"Version conflict"
                          (actors/call! b (transfer "s-t9") :transfer/start #:transfer{:from "s-a0" :to "s-a1" :amount 7})))
    (is (= 5 (:transfer/amount (actors/call! b (transfer "s-t9") :transfer/show))) "b restarted from the record")))

;; ── A deterministic simulation ───────────────────────────────────
;; The operations, the crashes and the moments the cluster splits in two are
;; all generated data, and the local systems do nothing the test did not
;; say. A failure is reproducible from its seed and shrinks to the smallest
;; schedule that breaks the books.

(def ^:private op
  (gen/frequency [[8 (gen/tuple (gen/return :transfer) (gen/choose 0 1) (gen/choose 0 3) (gen/choose 1 3) (gen/choose 1 80))]
                  [3 (gen/tuple (gen/return :tick) (gen/choose 0 1))]
                  [1 (gen/tuple (gen/return :split) (gen/choose -5000000 5000000))]
                  [1 (gen/return [:heal])]
                  [1 (gen/return [:restart])]]))

(def ^:private crashes
  "Which writes crash, and when: [n :before-write] dies before the n-th
   write of the run is stored, [n :after-write] right after."
  (gen/set (gen/tuple (gen/choose 1 150) (gen/elements [:before-write :after-write])) {:max-elements 10}))

(defn- step
  "Applies one operation to the cluster, a vector of one or two systems on
   the same storage and journals; a split's second system has a clock off
   by up to five seconds."
  [cluster [kind via a b amount]]
  (let [system (nth cluster (if (#{:transfer :tick} kind) (mod via (count cluster)) 0))]
    (case kind
      :transfer (do (try (start! system "p" a (mod (+ a b) 4) amount) (catch Exception _ nil))
                    cluster)
      :tick (do (try (local/run-timers! system) (catch Exception _ nil))
                (try (local/run-reminders! system) (catch Exception _ nil))
                cluster)
      :split (if (= 1 (count cluster)) (conj cluster (local/fork (first cluster) via)) cluster)
      :heal [(first cluster)]
      :restart [(local/restart (first cluster))])))

(defn- simulate
  "Runs the operations with the given crashes, then lets the cluster
   settle without faults and audits the books."
  [ops crash-set]
  (let [writes (atom 0)
        armed (atom false)
        crash (fn [_ phase]
                (when @armed
                  (let [n (if (= phase :before-write) (swap! writes inc) @writes)]
                    (contains? crash-set [n phase]))))
        system (local/system {:crash crash})]
    (open! system "p" 4 100)
    (reset! armed true)
    (let [cluster (reduce step [system] ops)]
      (reset! armed false)
      (let [system (local/restart (first cluster))]
        (settle! system)
        (audit/audit system "p")))))

(defspec the-books-balance-whatever-crashes 100
  (prop/for-all [ops (gen/vector op 1 40)
                 crash-set crashes]
    (:ok? (simulate ops crash-set))))

(deftest the-audit-finds-what-is-wrong
  (let [e (fn [seq key kind amount balance at] #:entry{:seq seq :key key :kind kind :amount amount :balance balance :at at})
        opened (fn [id] (e 1 (str id "-open") :deposit 100 100 1))
        a #:account{:id "a" :balance 70 :seq 2 :at 10 :entries [(opened "a") (e 2 "t" :debit 30 70 10)]}
        b #:account{:id "b" :balance 100 :seq 1 :at 1 :entries [(opened "b")]}
        done #:transfer{:id "t" :status :done :from "a" :to "b" :amount 30}
        {:keys [ok? problems total expected]} (audit/check {:opening 100 :accounts [a b] :transfers [done]})]
    (is (not ok?))
    (is (= [170 200] [total expected]))
    (is (some #(re-find #"t: done, but a has .* and b has nil" %) problems) (pr-str problems))
    (is (not-any? #(re-find #"is on its way" %) problems)
        "at every moment the missing 30 counts as on its way: it is the end that is wrong")
    (testing "a journal whose balances do not follow"
      (let [bad (assoc a :account/entries [(opened "a") (e 2 "t" :debit 30 75 10)] :account/balance 75)]
        (is (some #(re-find #"a: entry 2 has balance 75, the one before 100 and debit 30 make 70" %)
                  (:problems (audit/check {:opening 100 :accounts [bad b] :transfers [done]}))))))
    (testing "a credit booked before its debit"
      (let [b (assoc b :account/balance 130 :account/seq 2 :account/at 5
                       :account/entries [(opened "b") (e 2 "t" :credit 30 130 5)])]
        (is (some #(re-find #"credited before it was debited" %)
                  (:problems (audit/check {:opening 100 :accounts [a b] :transfers [done]})))))))
  (is (:ok? (audit/check {:opening 100
                          :accounts [#:account{:id "a" :balance 100 :seq 1 :at 1
                                               :entries [#:entry{:seq 1 :key "a-open" :kind :deposit :amount 100 :balance 100 :at 1}]}]
                          :transfers [#:transfer{:id "t" :status :blank}]}))
      "a transfer nobody started moved nothing"))
