(ns ants.actors-test
  "The actors on the local system: no Orleans, every message handled on the
   caller's thread, the state in reach. The runtime is the one the silo
   uses, so what passes here passes there; ants.colony-test runs the same
   actors on a real silo."
  (:require [clojure.test :refer [deftest is testing]]
            [clojure.spec.alpha :as s]
            [clojure.test.check.generators :as gen]
            [clojure.test.check.properties :as prop]
            [clojure.test.check.clojure-test :refer [defspec]]
            [ants.model :as model]
            [ants.test-actors :refer [counter ledger liar vault nag tally]]
            [ants.world :refer [world]]
            [ants.ant :refer [ant]]
            [orleans.actors :as actors]
            [orleans.actors.local :as local]))

(defn- colony
  "A local system with a small configured world."
  []
  (let [system (local/system)]
    (actors/call! system (world "main") :world/configure #:world{:size 20 :seed 3 :food-places 10 :home-size 8})
    system))

(deftest a-counter-counts
  (let [system (local/system)]
    (is (= 2 (actors/call! system (counter 1) :counter/add 2)))
    (is (= 5 (actors/call! system (counter 1) :counter/add 3)))
    (is (= 0 (actors/call! system (counter 2) :counter/get)) "actors of a type are independent")
    (is (= 5 (local/state system (counter 1))) "the state is in reach")
    (is (= #{(counter 1) (counter 2)} (local/active system)))))

(deftest an-ant-lives-in-the-world
  (let [system (colony)
        {:ant/keys [x y] :as state} (actors/call! system (ant 1) :ant/state)]
    (is (:cell/home? (:view/here (actors/call! system (world "main") :world/look (select-keys state [:ant/x :ant/y :ant/dir]))))
        "init asked the world for a place in the nest")
    (is (= "1" (:cell/ant (get-in (local/state system (world "main")) [:world/cells [x y]]))))
    (dotimes [_ 30] (actors/call! system (ant 1) :ant/step))
    (is (= 30 (:ant/steps (actors/call! system (ant 1) :ant/state))))
    (is (s/valid? ::model/world-state (local/state system (world "main"))))))

(defn- forage!
  "Steps a few ants until at least one of them has left the nest and
   dropped pheromone on the way."
  [system]
  (dotimes [_ 40] (doseq [id (range 5)] (actors/call! system (ant id) :ant/step))))

(deftest timers-are-fired-on-demand
  (let [system (colony)]
    (is (= [{:type :world/evaporate :payload nil :due 250 :period 250}] (local/timers system (world "main"))))
    (forage! system)
    (let [trail (fn [] (reduce + (keep :cell/pher (vals (:world/cells (local/state system (world "main")))))))
          before (trail)]
      (is (pos? before) "the ant left pheromone")
      (is (= 1 (local/run-timers! system)))
      (is (< (trail) before) "evaporated by the info handler")
      (is (= 1 (count (local/timers system (world "main")))) "a periodic timer stays"))))

(deftest casts-are-handled-before-they-return
  (let [system (colony)]
    (forage! system)
    (is (seq (keep :cell/pher (vals (:world/cells (local/state system (world "main")))))))
    (actors/cast system (world "main") :world/clear-trails)
    (is (empty? (keep :cell/pher (vals (:world/cells (local/state system (world "main")))))))))

(deftest messages-are-checked
  (let [system (colony)]
    (testing "an unknown message is rejected, the actor untouched"
      (is (thrown-with-msg? Exception #"rejected :ant/fly" (actors/call! system (ant 4) :ant/fly)))
      (is (zero? (:ant/steps (actors/call! system (ant 4) :ant/state)))))
    (testing "a payload that fails its spec is rejected with the explanation"
      (is (thrown-with-msg? Exception #"rejected :world/move" (actors/call! system (world "main") :world/move {:bogus 1})))
      (is (thrown-with-msg? Exception #"rejected :counter/add" (actors/call! system (counter 1) :counter/add "two"))))
    (testing "the actor's own mistake restarts it"
      (is (= 5 (actors/call! system (counter 1) :counter/add 5)))
      (is (thrown-with-msg? Exception #"does not conform" (actors/call! system (counter 1) :counter/add -9)))
      (is (= 0 (actors/call! system (counter 1) :counter/get)) "back to a fresh state"))
    (testing "a reply that fails its spec is the actor's mistake too"
      (is (= 0 (actors/call! system (liar 1) :liar/asked)))
      (is (thrown-with-msg? Exception #"reply to :liar/count does not conform" (actors/call! system (liar 1) :liar/count)))
      (is (= 0 (actors/call! system (liar 1) :liar/asked)) "restarted, the state it computed was dropped"))))

(deftest states-and-messages-are-described
  (let [{:keys [state call cast]} (actors/describe :world)]
    (is (= '(keys :req [:world/size :world/home :world/cells :world/collected]) state))
    (is (= {:payload '(keys :req [:ant/id :move/from :move/to]) :reply 'boolean?} (:world/move call)))
    (is (= {:payload nil :reply '(keys :req [:snapshot/size :snapshot/collected :snapshot/cells])} (:world/snapshot call)) "no payload")
    (is (= {:payload nil} (:world/clear-trails cast)) "a cast has no reply"))
  (is (true? (:persist (actors/describe :ledger))))
  (is (false? (:persist (actors/describe :counter)))))

;; ── Persistence: each actor's own record, kept by the host ────────

(deftest persisting-actors-resume-where-they-left
  (let [system (local/system)]
    (is (= 7 (actors/call! system (ledger 1) :ledger/add 7)))
    (is (= 7 (local/stored system (ledger 1))) "stored after the message")
    (is (= :stopping (actors/call! system (ledger 1) :ledger/stop)))
    (is (nil? (local/state system (ledger 1))) "deactivated")
    (is (= 7 (actors/call! system (ledger 1) :ledger/get)) "resumed from the stored state")
    (testing "a crash restarts from the last stored state, which is the last one that conformed"
      (is (thrown-with-msg? Exception #"does not conform" (actors/call! system (ledger 1) :ledger/add -100)))
      (is (= 7 (actors/call! system (ledger 1) :ledger/get))))
    (testing "forget starts over"
      (is (= :forgotten (actors/call! system (ledger 1) :ledger/forget)))
      (is (actors/none? (local/stored system (ledger 1))))
      (is (= 0 (actors/call! system (ledger 1) :ledger/get))))
    (testing "without persistence a stop starts over"
      (is (= 3 (actors/call! system (counter 9) :counter/add 3)))
      (actors/call! system (counter 9) :counter/stop)
      (is (= 0 (actors/call! system (counter 9) :counter/get)))
      (is (actors/none? (local/stored system (counter 9))) "nothing stored"))
    (testing "after a restart only what was stored is left"
      (is (= 5 (actors/call! system (ledger 2) :ledger/add 5)))
      (is (= 4 (actors/call! system (counter 2) :counter/add 4)))
      (let [system (local/restart system)]
        (is (empty? (local/active system)))
        (is (= 6 (actors/call! system (ledger 2) :ledger/add 1)))
        (is (= 0 (actors/call! system (counter 2) :counter/get)))))))

(deftest a-named-storage-keeps-its-actors-apart
  (let [system (local/system)]
    (actors/call! system (vault 1) :vault/put "gold")
    (is (= #{"gold"} (local/stored system (vault 1) "vaults")))
    (is (actors/none? (local/stored system (vault 1))) "not in the default storage")
    (is (= "vaults" (:storage (actors/describe :vault))))))

(deftest reminders-outlive-the-activation
  (let [system (local/system)]
    (is (= :started (actors/call! system (nag 1) :nag/start)))
    (is (= {:nag/tick {:due 60000 :period 60000}} (local/reminders system (nag 1))))
    (actors/call! system (nag 1) :nag/stop)
    (is (nil? (local/state system (nag 1))) "deactivated")
    (is (= 1 (local/run-reminders! system)) "the reminder activates it again")
    (let [system (local/restart system)]
      (local/run-reminders! system)
      (is (= 2 (actors/call! system (nag 1) :nag/count)) "and survives a restart")
      (local/run-reminders! system)
      (is (= 3 (actors/call! system (nag 1) :nag/count)))
      (is (empty? (local/reminders system (nag 1))) "cancelled on the third tick"))))

;; ── Journals ─────────────────────────────────────────────────────

(deftest a-journaled-actor-keeps-what-happened
  (let [system (local/system)
        add (fn [system id n] (actors/call! system (tally "t") :tally/add #:tally{:id id :n n}))]
    (is (= [3 7 7 12] [(add system "a" 3) (add system "b" 4) (add system "b" 4) (add system "c" 5)])
        "an addition repeated under its key counts once")
    (let [entries (actors/call! system (tally "t") :tally/entries)
          [a b c] (map :entry/at entries)]
      (is (= [1 2 3] (map :entry/seq entries)))
      (is (< a b c) "each entry after the one before")
      (is (= [3 7 12] (map #(actors/call! system (tally "t") :tally/total-at %) [a b c])))
      (is (= 3 (actors/call! system (tally "t") :tally/total-at (dec b))) "the total at any moment"))
    (testing "a restart resumes from the last entry"
      (let [system (local/restart system)]
        (is (= 13 (add system "d" 1)))))
    (testing "a second activation cannot append past the first"
      (let [other (local/fork system)]
        (is (= 13 (actors/call! other (tally "t") :tally/total-at Int64/MaxValue)))
        (add other "e" 1)                                  ; other reads the end of the journal and appends seq 5
        (is (thrown-with-msg? Exception #"Journal conflict" (add system "f" 1)) "system still thinks it ends at 4")
        (is (= 15 (add system "f" 1)) "restarted from the journal")))
    (is (= "tallies" (:journal (actors/describe :tally))))))

(deftest a-journaled-actor-needs-a-resume
  (is (thrown-with-msg? Exception #"needs a resume"
                        (actors/register-actor! :no-resume {:init (fn [_ _] {}) :journal :x})))
  (is (thrown-with-msg? Exception #"not both"
                        (actors/register-actor! :both {:init (fn [_ _] {}) :journal :x :persist true :resume (fn [_ e] e)}))))

;; ── Every valid message, generated from the specs ────────────────
;; A fresh system per case, with the whole grid checked after every message.

(defspec the-world-handles-every-valid-message 100
  (prop/for-all [messages (gen/vector (actors/message-generator :world :call) 1 5)]
    (let [system (local/system {:state-check 5000})]
      (doseq [[type payload] messages]
        (actors/call! system (world "main") type payload))
      (s/valid? ::model/look-view (actors/call! system (world "main") :world/look #:ant{:x 0 :y 0 :dir 0})))))

(defspec the-ant-handles-every-valid-message 30
  (prop/for-all [messages (gen/vector (actors/message-generator :ant :call) 1 10)]
    (let [system (colony)]
      (doseq [[type payload] messages]
        (actors/call! system (ant "under-test") type payload))
      (s/valid? ::model/ant-state (actors/call! system (ant "under-test") :ant/state)))))
