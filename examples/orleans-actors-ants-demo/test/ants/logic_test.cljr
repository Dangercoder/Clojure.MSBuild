(ns ants.logic-test
  (:require [clojure.test :refer [deftest is testing]]
            [clojure.spec.alpha :as s]
            [clojure.test.check.generators :as gen]
            [clojure.test.check.properties :as prop]
            [clojure.test.check.clojure-test :refer [defspec]]
            [ants.logic :as logic]
            [ants.model :as model]))

(deftest directions-wrap
  (is (= 0 (logic/turn 7 1)))
  (is (= 7 (logic/turn 0 -1)))
  (is (= [0 39] (logic/delta-loc 40 [0 0] 0)) "north of the top row is the bottom row")
  (is (= [1 0] (logic/delta-loc 40 [0 0] 2))))

(deftest weighted-choice
  (is (= 0 (logic/wrand [1 1 1] 0.0)))
  (is (= 1 (logic/wrand [1 1 1] 0.4)))
  (is (= 2 (logic/wrand [1 1 1] 0.9)))
  (is (= 1 (logic/wrand [0 5 0] 0.5)) "zero weights are never chosen"))

(def empty-cell #:cell{:food 0 :pher 0.0 :home? false :ant? false})
(def empty-view {:world/size 40 :view/here empty-cell :view/ahead empty-cell :view/left empty-cell :view/right empty-cell})

(deftest foraging-ant
  (testing "takes food when standing on it"
    (is (= [:take-food] (logic/decide #:ant{:food? false} (assoc-in empty-view [:view/here :cell/food] 3) 0.5))))
  (testing "moves onto food ahead"
    (is (= [:move] (logic/decide #:ant{:food? false} (assoc-in empty-view [:view/ahead :cell/food] 3) 0.5))))
  (testing "does not walk into another ant"
    (is (not= [:move] (logic/decide #:ant{:food? false} (assoc-in empty-view [:view/ahead :cell/ant?] true) 0.0))))
  (testing "prefers the strongest pheromone"
    (is (= [:turn 1] (logic/decide #:ant{:food? false} (assoc-in empty-view [:view/right :cell/pher] 5.0) 0.99)))))

(deftest ant-carrying-food
  (is (= [:drop-food] (logic/decide #:ant{:food? true} (assoc-in empty-view [:view/here :cell/home?] true) 0.5)))
  (is (= [:move] (logic/decide #:ant{:food? true} (assoc-in empty-view [:view/ahead :cell/home?] true) 0.5))))

(deftest world-rules
  (let [world (logic/new-world #:world{:size 10 :home-size 2 :food-places 3 :seed 1})
        [world {:ant/keys [x y]}] (logic/spawn world "1" 0.0)]
    (is (:cell/home? (logic/cell world [x y])))
    (is (= "1" (:cell/ant (logic/cell world [x y]))))
    (testing "moving leaves the old cell and blocks the new one"
      (let [[world moved?] (logic/move world "1" [x y] [0 0])]
        (is moved?)
        (is (= "1" (:cell/ant (logic/cell world [0 0]))))
        (is (nil? (:cell/ant (logic/cell world [x y]))))
        (is (= [world false] (logic/move world "2" [5 5] [0 0])) "occupied")))
    (testing "pheromone evaporates"
      (let [world (logic/update-cell world [3 3] assoc :cell/pher 1.0)]
        (is (< (:cell/pher (logic/cell (logic/evaporate world) [3 3])) 1.0))))))

;; ── Generated from the specs in ants.model ───────────────────────

(defspec every-ant-in-every-situation-has-an-action 200
  (prop/for-all [ant (s/gen ::model/ant-state)
                 look (s/gen ::model/look-view)
                 r (gen/double* {:min 0.0 :max 0.999 :NaN? false :infinite? false})]
    (let [[action amount] (logic/decide ant look r)]
      (and (contains? #{:take-food :drop-food :move :turn} action)
           (or (not= action :turn) (#{-1 1} amount))))))

(defspec new-worlds-conform-to-their-spec 30
  (prop/for-all [options (s/gen :world/configure)]
    (s/valid? ::model/world-state (logic/new-world options))))

(defspec looking-around-conforms-to-the-view-spec 50
  (prop/for-all [options (s/gen :world/configure)
                 dir (s/gen :ant/dir)]
    (let [world (logic/new-world options)
          size (:world/size world)]
      (s/valid? ::model/look-view (logic/look world [(rand-int size) (rand-int size)] dir)))))
