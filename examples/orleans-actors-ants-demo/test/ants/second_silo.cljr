;; Started by ants.colony-test in a second process: joins the test's silo as a
;; second silo of the same cluster and talks to the world actor, which lives
;; on the first silo, so every message crosses the wire.
(require '[orleans.actors :as actors]
         '[orleans.actors.silo :as silo]
         '[ants.world :refer [world]]
         '[ants.test-actors :refer [ledger]]      ; the persisting actor type the test uses
         '[clojure.string :as str])
(import '[System Int32])

(defn- port [name] (Int32/Parse (System.Environment/GetEnvironmentVariable name)))

(defn- message-of [thunk]
  (try (thunk) nil (catch Exception e (.Message e))))

(let [system (silo/start! {:silo-port (port "SILO_PORT")
                           :gateway-port (port "GATEWAY_PORT")
                           :primary-port (port "PRIMARY_PORT")})]
  (try
    (let [view (actors/call! system (world "main") :world/look #:ant{:x 1 :y 1 :dir 0})]
      (assert (= 20 (:world/size view)) (str "the world configured by the first silo has size 20, saw " (:world/size view)))
      (assert (= :ok (actors/call! system (world "main") :world/drop-food [1 1])))
      (let [rejected (message-of #(actors/call! system (world "main") :world/move {:bogus 1}))]
        (assert (and rejected (str/includes? rejected "rejected")) (str "a rejection travels back as data, saw " rejected)))
      (let [unknown (message-of #(actors/call! system (world "main") :world/fly))]
        (assert (and unknown (str/includes? unknown "rejected")) "an unknown message is rejected on the other silo too"))
      (assert (= 5 (actors/call! system (ledger "shared") :ledger/add 5)) "a persisting actor, written from this silo")
      (assert (= 5 (actors/call! system (ledger "shared") :ledger/get)) "and read back")
      (println "second silo: ok"))
    (finally
      (silo/shutdown! system))))
