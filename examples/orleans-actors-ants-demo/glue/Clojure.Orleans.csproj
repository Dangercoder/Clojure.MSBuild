<Project Sdk="Microsoft.NET.Sdk">

  <!-- The glue between Orleans and the Clojure actor runtime: one generic grain whose
       behaviour lives in Clojure (see src/orleans/actors.cljr). Orleans needs its grain
       interfaces and message types in a C# project so that its source generator can
       produce the proxies and serializers. -->
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Clojure.Orleans</RootNamespace>
    <EnablePreviewFeatures>true</EnablePreviewFeatures>
    <NoWarn>CA2252</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Clojure" Version="1.12.6" />
    <PackageReference Include="Microsoft.Orleans.Sdk" Version="10.3.1" />
    <PackageReference Include="Microsoft.Orleans.Server" Version="10.3.1" />
    <PackageReference Include="Microsoft.Orleans.Reminders" Version="10.3.1" />
  </ItemGroup>

</Project>
