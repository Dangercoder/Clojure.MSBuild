(ns orleans.actors.local
  "An actor system in this process, without Orleans: for tests and the
   REPL. Actors live in a map and messages are handled one after the
   other, casts included; the Task that `call` or `cast` returns completes
   once the message has been handled, and as long as the handlers wait on
   nothing outside the process that happens before the Task is returned,
   so a test can send a message and look at the state (`state`) right
   after. Timers are recorded and fired by `run-timers!`, reminders by
   `run-reminders!`.

   The system is also the host's durable side: the stored states of
   persisting actors (`stored`) and the reminders (`reminders`) belong to
   it, not to the actors, exactly as on a silo they belong to the grain
   storage and the reminder service. A stored record has a version, which
   an activation reads with the state and has to match when it writes, as
   the ETag of an Orleans grain storage: a write from an activation that
   is out of date throws. `restart` gives a system that kept only the
   stored states and reminders, as after a crash of every silo; `fork`
   gives a second system on the same ones next to the first, so an actor
   can be active twice, as it can for a moment when a cluster changes.

   Everything happens on the caller's thread, in the order the caller
   says, and faults come from the :crash function: a test that generates
   the messages, the restarts and the crashes is deterministic, and
   test.check can shrink a failure to the smallest schedule that breaks.

   The runtime is the one the Orleans host uses (orleans.actors/activate,
   handle and recover), so specs, persistence and the :on-error policy
   behave the same; only the hosting differs. Two differences matter: an
   actor calling itself, directly or in a cycle, works here and deadlocks
   on Orleans, and there is no cluster, so nothing crosses the wire.

     (let [system (local/system)]
       (actors/call! system (counter 1) :add 2)
       (local/state system (counter 1)))       ; => 2"
  (:require [clojure.clr.async.task.alpha :as t]
            [orleans.actors :as actors]
            [orleans.actors.journal :as journal])
  (:import [System IDisposable]))

(set! *warn-on-reflection* true)

(declare dispatch)

(defn- without-timer [timers id]
  (vec (remove #(= id (:id %)) timers)))

(defn- crash!
  "Throws when the system's :crash function says the host dies here."
  [system ref phase]
  (when-let [crash? (:crash system)]
    (when (crash? ref phase)
      (throw (ex-info (str "crash " (name phase) " of " (:actor/type ref) "/" (:actor/id ref))
                      {:crash phase :actor ref})))))

(defn- write-versioned!
  "Stores the state when the record still has the version this activation
   read, as Orleans' grain storage does with its ETag; throws when it does
   not: another activation of the same actor wrote in between."
  [system ref provider state]
  (let [key [provider ref]
        expected (get-in @(:activations system) [ref :versions provider] 0)
        [before after] (swap-vals! (:stored system)
                                   (fn [stored]
                                     (if (= expected (get-in stored [key :version] 0))
                                       (assoc stored key {:state state :version (inc expected)})
                                       stored)))]
    (when (identical? before after)
      (throw (ex-info (str "Version conflict writing " (:actor/type ref) "/" (:actor/id ref) ": read version " expected
                           ", stored version " (get-in before [key :version] 0))
                      {:actor ref :expected expected :stored (get-in before [key :version] 0)})))
    (swap! (:activations system) assoc-in [ref :versions provider] (inc expected))))

(defn- journal-named
  "The system's journal of that name, created on first use."
  [system name]
  (or (get @(:journals system) name)
      (get (swap! (:journals system) (fn [js] (if (contains? js name) js (assoc js name (journal/memory))))) name)))

(defrecord LocalHost [system ref]
  actors/Host
  (-timer [_ type payload due period]
    (let [timer {:id (gensym "timer") :type type :payload payload :due due :period period}]
      (swap! (:activations system) update-in [ref :timers] (fnil conj []) timer)
      (reify IDisposable
        (Dispose [_]
          (swap! (:activations system) update-in [ref :timers] without-timer (:id timer))))))
  (-clear-timers [_] (swap! (:activations system) assoc-in [ref :timers] []))
  (-remind [_ type due period]
    (swap! (:reminders system) assoc-in [ref type] {:due due :period period})
    nil)
  (-unremind [_ type]
    (swap! (:reminders system) (fn [reminders]
                                 (let [left (dissoc (get reminders ref) type)]
                                   (if (empty? left) (dissoc reminders ref) (assoc reminders ref left)))))
    nil)
  (-read-state [_ provider]
    (let [{:keys [state version] :or {state actors/none version 0}} (get @(:stored system) [provider ref])]
      (swap! (:activations system) assoc-in [ref :versions provider] version)
      state))
  (-write-state [_ provider state]
    (crash! system ref :before-write)
    (write-versioned! system ref provider state)
    (crash! system ref :after-write)
    nil)
  (-clear-state [_ provider] (write-versioned! system ref provider actors/none) nil)
  (-append [_ name entry]
    (crash! system ref :before-write)
    (let [result (journal/-append (journal-named system name) ref entry)]
      (crash! system ref :after-write)
      result))
  (-last-entry [_ name] (journal/-last-entry (journal-named system name) ref))
  (-entry-at [_ name at] (journal/-entry-at (journal-named system name) ref at))
  (-entry-by-key [_ name key] (journal/-entry-by-key (journal-named system name) ref key))
  (-entries [_ name after-seq limit] (journal/-entries (journal-named system name) ref after-seq limit))
  (-now [_] ((:clock system)))
  (-stop [_] (swap! (:activations system) assoc-in [ref :stopping?] true)))

(defn- context [system ref]
  (actors/context ref system (->LocalHost system ref)))

(defrecord LocalSystem [activations stored reminders journals settings crash clock]
  actors/Messaging
  (-call [this ref type payload] (dispatch this :call ref type payload))
  (-cast [this ref type payload] (dispatch this :cast ref type payload)))

(def ^:private task-of-object "System.Threading.Tasks.Task`1[System.Object]")

(defn- activation
  "A Task of the live actor for a ref, activated first when needed. Init may
   set timers through the context before the state exists, so an entry with
   timers but no state is not active yet."
  [system ref]
  (t/async
    (let [live (get @(:activations system) ref)]
      (if (contains? live :state)
        live
        (let [state (t/await (actors/activate (context system ref) (:settings system)))]
          (swap! (:activations system) assoc-in [ref :state] state)
          (get @(:activations system) ref))))))

(alter-meta! #'activation assoc :tag task-of-object)

(defn- finish! [system ref]
  (when-let [live (get @(:activations system) ref)]
    (when (:stopping? live)
      (swap! (:activations system) dissoc ref)
      (t/result (actors/deactivate (context system ref) (:state live))))))

(defn- dispatch
  "Handles one message and returns a Task of the reply, faulted with the
   handler's exception after the :on-error policy was applied."
  [system kind ref type payload]
  (t/async
    (let [ctx (context system ref)
          {:keys [state]} (t/await (activation system ref))
          [result error] (t/await (actors/outcome (actors/handle ctx (:settings system) kind state type payload)))]
      (if error
        (let [recovered (t/await (actors/recover ctx (:settings system) state error))]
          (swap! (:activations system) assoc-in [ref :state] recovered)
          (finish! system ref)
          (throw error))
        (let [[reply new-state] result]
          (swap! (:activations system) assoc-in [ref :state] new-state)
          (finish! system ref)
          reply)))))

(alter-meta! #'dispatch assoc :tag task-of-object)

(defn logical-clock
  "A clock for the local system: every reading is a millisecond, in
   microseconds, after the previous one, from 2026-01-01. Nothing depends on
   the time of day, so a test that reads it is deterministic."
  []
  (let [now (atom 1767225600000000)]
    (fn [] (swap! now + 1000))))

(defn system
  "A local actor system. Options: :state-check as for
   orleans.actors.silo/start, and :crash, for fault injection: a function
   of the actor's ref and :before-write or :after-write, called whenever a
   persisting actor's state is written; when it returns true the write
   throws, before or after the state was stored, as if the host died
   there (appends to a journal count as writes), and :clock, a function
   of no arguments giving the time in microseconds (`logical-clock` by
   default)."
  ([] (system {}))
  ([{:keys [crash clock] :as options}]
   (->LocalSystem (atom {}) (atom {}) (atom {}) (atom {}) (actors/settings options) crash
                  (or clock (logical-clock)))))

(defn fork
  "A second system on the stored states and reminders of this one, with
   activations of its own: the same actor can then be active in both, with
   the state each read, as it can be on two silos for a moment when a
   cluster changes. Their writes are ordered by the records' versions: the
   first one wins, the other throws and its actor restarts from what is
   stored. Both systems stay usable. With a skew (microseconds), the
   fork's clock is that far off the first one's, as the clocks of two
   silos are."
  ([system] (fork system 0))
  ([system skew]
   (->LocalSystem (atom {}) (:stored system) (:reminders system) (:journals system) (:settings system) (:crash system)
                  (let [clock (:clock system)] (fn [] (+ skew (clock)))))))

(defn restart
  "A new system with the stored states and the reminders of this one and
   no activations: what is left after every silo of a cluster went down
   and came back. The old system should not be used afterwards."
  [system]
  (fork system 0))

(defn stored
  "The stored state of a persisting actor, `orleans.actors/none` when it
   has none. `provider` is the storage name, \"Default\" for {:persist true}."
  ([system ref] (stored system ref "Default"))
  ([system ref provider] (get-in @(:stored system) [[provider ref] :state] actors/none)))

(defn reminders
  "The reminders of an actor: {message-type {:due ms :period ms}}."
  [system ref]
  (get @(:reminders system) ref {}))

(defn run-reminders!
  "Fires every reminder once, as the reminder service would when its time
   came, activating the actor first when it is not active. Returns the
   number of messages delivered."
  [system]
  (let [due (vec (for [[ref by-type] @(:reminders system) [type _] by-type] [ref type]))]
    (doseq [[ref type] due]
      (t/result (dispatch system :info ref type nil)))
    (count due)))

(defn state
  "The current state of an actor, nil when it is not active."
  [system ref]
  (:state (get @(:activations system) ref)))

(defn active
  "The refs of the actors that are active."
  [system]
  (set (for [[ref live] @(:activations system) :when (contains? live :state)] ref)))

(defn timers
  "The pending timers of an actor: {:type :payload :due :period}, period
   nil for a send-after."
  [system ref]
  (mapv #(dissoc % :id) (:timers (get @(:activations system) ref))))

(defn run-timers!
  "Fires every pending timer once, as the host would when its time came:
   each delivers its message to the actor's info handler and is waited
   for. Timers set with send-after are removed, those set with send-every
   stay. Returns the number of messages delivered."
  [system]
  (let [pending (vec (for [[ref live] @(:activations system) timer (:timers live)] [ref timer]))]
    (doseq [[ref {:keys [id type payload period]}] pending]
      (when-not period
        (swap! (:activations system) update-in [ref :timers] without-timer id))
      (t/result (dispatch system :info ref type payload)))
    (count pending)))
