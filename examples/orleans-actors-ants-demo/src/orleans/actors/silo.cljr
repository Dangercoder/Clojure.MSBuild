;; IHost and LogLevel live in shared-framework assemblies that are not loaded
;; until something uses them; ClojureCLR resolves type names against loaded
;; assemblies, so load them first.
(assembly-load "Microsoft.Extensions.Hosting.Abstractions")
(assembly-load "Microsoft.Extensions.Logging.Abstractions")

(ns orleans.actors.silo
  "Actors on Microsoft Orleans. `start` runs a silo in this process that
   hosts every defined actor type and returns a system for `actors/call`
   and `actors/cast`. Every actor type is hosted by the same Orleans grain
   class (Clojure.Orleans.ActorGrain, in the glue); the grain key is
   \"type/id\" and the runtime dispatches on the type. Orleans gives the
   rest: actors are virtual (they exist as soon as they are addressed, are
   activated on the first message and deactivated when idle), each actor
   handles one message at a time, and a crashed actor is simply
   re-initialised (:on-error). The context an actor gets here sends
   through the grain factory and keeps its timers, its reminders and its
   stored record on the grain: a persisting actor's state is the grain's
   own record in an Orleans grain storage, as EDN.

   What a silo runs on, its clustering, grain storages and reminder
   service, is an Action<ISiloBuilder> (:configure). Without one a silo
   uses localhost clustering and keeps states and reminders in memory,
   which is enough for one process and for tests."
  (:require [clojure.clr.async.task.alpha :as t]
            [clojure.string :as str]
            [orleans.actors :as actors]
            [orleans.actors.journal :as journal]
            [orleans.actors.wire :as wire])
  (:import [Clojure.Orleans Actors ActorGrain ActorMessage ActorReply IActorHost IClojureWire]
           [Microsoft.Extensions.Hosting IHost]
           [Microsoft.Extensions.Logging LogLevel]
           [System TimeSpan]
           [System.Threading Timeout]))

(set! *warn-on-reflection* true)

(def ^:private task-of-object "System.Threading.Tasks.Task`1[System.Object]")

;; ── Messages and refs on the grain side ──────────────────────────

(defn- type-name ^String [type]
  (subs (str type) 1))                           ; keeps the namespace of a qualified keyword

(defn- message ^ActorMessage [type payload]
  (ActorMessage. (type-name type) payload))

(defn- span ^TimeSpan [ms]
  (TimeSpan/FromMilliseconds (double ms)))

(defn- ref-key ^String [{:actor/keys [type id]}]
  (str (name type) "/" id))

(defn- key->ref [^String key]
  (let [[type id] (str/split key #"/" 2)]
    (actors/actor-ref (keyword type) id)))

(defn- grain-call [factory ref type payload]
  (t/async
    (let [^ActorReply r (t/await (.Call (Actors/Ref factory (ref-key ref)) (message type payload)))]
      {:ok? (.Ok r) :value (.Value r)})))

(alter-meta! #'grain-call assoc :tag task-of-object)

(defn- grain-cast [factory ref type payload]
  (.Cast (Actors/Ref factory (ref-key ref)) (message type payload)))

;; ── The context of an actor hosted by a grain ────────────────────

(defrecord GrainMessaging [factory]
  actors/Messaging
  (-call [_ ref type payload] (grain-call factory ref type payload))
  (-cast [_ ref type payload] (grain-cast factory ref type payload)))

(defn- journal-named [journals name]
  (or (get journals name)
      (throw (ex-info (str "No journal named \"" name "\" is configured on this silo (:journals of silo/start)")
                      {:journal name}))))

(defn- now-micros []
  (quot (- (.Ticks System.DateTime/UtcNow) 621355968000000000) 10))

(defrecord GrainHost [^ActorGrain grain journals]
  actors/Host
  (-timer [_ type payload due period]
    (.Timer grain (message type payload) (span due) (if period (span period) Timeout/InfiniteTimeSpan)))
  (-clear-timers [_] (.ClearTimers grain))
  (-remind [_ type due period]
    (t/async (t/await (.Remind grain (type-name type) (span due) (span period))) nil))
  (-unremind [_ type]
    (t/async (t/await (.Unremind grain (type-name type))) nil))
  (-read-state [_ provider] (.ReadStored grain ^String provider actors/none))
  (-write-state [_ provider state]
    (t/async (t/await (.WriteStored grain ^String provider state)) nil))
  (-clear-state [_ provider]
    (t/async (t/await (.ClearStored grain ^String provider)) nil))
  (-append [_ name entry] (journal/-append (journal-named journals name) (key->ref (.Key grain)) entry))
  (-last-entry [_ name] (journal/-last-entry (journal-named journals name) (key->ref (.Key grain))))
  (-entry-at [_ name at] (journal/-entry-at (journal-named journals name) (key->ref (.Key grain)) at))
  (-entry-by-key [_ name key] (journal/-entry-by-key (journal-named journals name) (key->ref (.Key grain)) key))
  (-entries [_ name after-seq limit] (journal/-entries (journal-named journals name) (key->ref (.Key grain)) after-seq limit))
  (-now [_] (now-micros))
  (-stop [_] (.Stop grain)))

(defn- actor-host
  "The IActorHost the grains call: it hands every event to the runtime with
   a context for the grain, and keeps the state on the grain."
  [settings journals]
  (let [context (fn [^ActorGrain grain]
                  (actors/context (key->ref (.Key grain)) (->GrainMessaging (.Factory grain)) (->GrainHost grain journals)))
        handle (fn [kind ^ActorGrain grain ^ActorMessage message]
                 (t/async
                   (let [[reply state] (t/await (actors/handle (context grain) settings kind (.State grain)
                                                               (keyword (.Type message)) (.Payload message)))]
                     (set! (.State grain) state)
                     (when reply
                       (ActorReply. (boolean (:ok? reply)) (:value reply))))))]
    (reify IActorHost
      (OnActivate [_ grain]
        (t/async
          (set! (.State grain) (t/await (actors/activate (context grain) settings)))
          nil))
      (OnDeactivate [_ grain _reason] (actors/deactivate (context grain) (.State grain)))
      (OnCall [_ grain message] (handle :call grain message))
      (OnCast [_ grain message] (handle :cast grain message))
      (OnInfo [_ grain message] (handle :info grain message))
      (OnError [_ grain error]
        (t/async
          (set! (.State grain) (t/await (actors/recover (context grain) settings (.State grain) error)))
          nil)))))

(defn- clojure-wire []
  (reify IClojureWire
    (Write [_ value] (wire/write value))
    (Read [_ text] (wire/read text))))

;; ── The silo ─────────────────────────────────────────────────────

(defrecord Silo [^IHost host settings]
  actors/Messaging
  (-call [_ ref type payload] (grain-call (Actors/GrainFactory host) ref type payload))
  (-cast [_ ref type payload] (grain-cast (Actors/GrainFactory host) ref type payload)))

(defn start
  "Starts an Orleans silo in this process hosting all defined actors and
   returns a Task of the silo, a system for `actors/call` and
   `actors/cast`. Options:
     :silo-port    11111
     :gateway-port 30000
     :primary-port join the cluster whose primary silo listens on that port
                   on this machine (the silo is a primary itself otherwise).
                   Actors are shared by every silo of a cluster: an actor
                   lives on one of them and is reached from all
     :configure    an Action<ISiloBuilder> that sets up clustering, grain
                   storages (the one named \"Default\" is where {:persist
                   true} actors are kept) and reminders, replacing the
                   in-memory, localhost defaults; :primary-port is then
                   ignored, the clustering finds the cluster
     :journals     {name journal}: the journals journaled actors ({:journal
                   :name}) record in, orleans.actors.journal/Journal
                   implementations; a silo has none by default
     :state-check  see orleans.actors/settings
     :log-level    LogLevel/Warning"
  ([] (start {}))
  ([{:keys [silo-port gateway-port primary-port configure log-level journals]
     :or {silo-port 11111 gateway-port 30000 primary-port 0 log-level LogLevel/Warning}
     :as options}]
   (let [settings (actors/settings options)]
     (t/async
       (let [host (t/await (Actors/StartSiloAsync (actor-host settings (into {} (map (fn [[k v]] [(name k) v])) journals)) (clojure-wire)
                                                  (int silo-port) (int gateway-port) (int primary-port) log-level
                                                  configure))]
         (->Silo host settings))))))

(alter-meta! #'start assoc :tag task-of-object)

(defn start!
  "Blocking start, for -main, tests and the REPL."
  ([] (start! {}))
  ([options] (t/result (start options))))

(defrecord Client [^IHost host]
  actors/Messaging
  (-call [_ ref type payload] (grain-call (Actors/GrainFactory host) ref type payload))
  (-cast [_ ref type payload] (grain-cast (Actors/GrainFactory host) ref type payload)))

(defn connect
  "Connects to a cluster as an Orleans client: a process that sends to the
   actors without hosting any. `configure` is an Action<IClientBuilder>
   that says how it finds the cluster (its clustering). Returns a Task of
   the client, a system for `actors/call` and `actors/cast`. Close it with
   `shutdown`."
  ([configure] (connect configure LogLevel/Warning))
  ([configure log-level]
   (t/async
     (->Client (t/await (Actors/StartClientAsync (clojure-wire) log-level configure))))))

(alter-meta! #'connect assoc :tag task-of-object)

(defn round-trip
  "Serializes a message the way it would travel to another silo and reads
   it back: what the other side would receive. For tests and curiosity."
  [silo type payload]
  (.Payload (Actors/RoundTrip (:host silo) (message type payload))))

(defn active-silos
  "A Task of the number of silos the cluster considers active, as seen
   from this silo."
  [silo]
  (Actors/ActiveSiloCount (:host silo)))

(defn shutdown
  "Stops the silo started with start, or the client from connect. Returns a Task."
  [silo]
  (Actors/StopSiloAsync (:host silo)))

(defn shutdown!
  "Blocking shutdown, for -main, tests and the REPL."
  [silo]
  ;; a plain Task: t/result is for Task<T>, it would not wait for this one
  (.Wait ^System.Threading.Tasks.Task (shutdown silo)))
