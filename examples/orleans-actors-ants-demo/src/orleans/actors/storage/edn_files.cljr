(ns orleans.actors.storage.edn-files
  "Storage as EDN files, one per actor: <directory>/<type>/<id>.edn, written
   through orleans.actors.wire, so what is on disk is what would be on the
   wire. Durable across process and silo restarts and shared by every silo
   with access to the directory. Ids come from callers, so they are encoded
   into file names that stay inside the directory."
  (:require [orleans.actors.storage :as storage]
            [orleans.actors.wire :as wire])
  (:import [System Char]
           [System.IO Directory File Path]
           [System.Text Encoding StringBuilder]))

(set! *warn-on-reflection* true)

(defn encode
  "The file name for an id: letters, digits, - and _ as they are, every
   other byte of its UTF-8 form as %XX. Any id becomes one file name inside
   the directory: \"../../escape\" is %2E%2E%2F%2E%2E%2Fescape."
  ^String [^String s]
  (let [sb (StringBuilder.)]
    (doseq [b (.GetBytes Encoding/UTF8 s)]
      (let [n (int b)
            c (char n)]
        (if (and (< n 128) (or (Char/IsLetterOrDigit c) (= c \-) (= c \_)))
          (.Append sb c)
          (.Append sb (str "%" (.ToString n "X2"))))))
    (str sb)))

(defn- path-for ^String [^String directory type id]
  (Path/Combine directory (encode (name type)) (str (encode (str id)) ".edn")))

(defrecord EdnFiles [^String directory]
  storage/Storage
  (read-state [_ type id]
    (let [path (path-for directory type id)]
      (if (File/Exists path)
        (wire/read (File/ReadAllText path))
        storage/none)))
  (write-state [_ type id state]
    (let [path (path-for directory type id)
          temporary (str path ".tmp")]
      (Directory/CreateDirectory (Path/GetDirectoryName path))
      (File/WriteAllText temporary (wire/write state))
      (File/Move temporary path true)                  ; atomic: readers see the old file or the new one
      nil))
  (clear-state [_ type id]
    (let [path (path-for directory type id)]
      (when (File/Exists path) (File/Delete path))
      nil)))

(defn storage
  "Storage in the given directory, created on first write."
  [directory]
  (->EdnFiles (Path/GetFullPath directory)))

(defn file-of
  "The file an actor's state is stored in."
  [storage type id]
  (path-for (:directory storage) type id))
