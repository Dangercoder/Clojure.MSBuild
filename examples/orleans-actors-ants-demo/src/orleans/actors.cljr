;; IHost and LogLevel live in shared-framework assemblies that are not loaded
;; until something uses them; ClojureCLR resolves type names against loaded
;; assemblies, so load them first.
(assembly-load "Microsoft.Extensions.Hosting.Abstractions")
(assembly-load "Microsoft.Extensions.Logging.Abstractions")

(ns orleans.actors
  "Actors on Microsoft Orleans, GenServer style.

   An actor is defined with `defactor`: an `init` and handlers for `call`
   (request/response), `cast` (fire and forget) and `info` (timer messages).
   Every actor type is hosted by the same Orleans grain class
   (Clojure.Orleans.ActorGrain); the grain key is \"type/id\" and this
   namespace dispatches on the type. Orleans gives the rest: actors are
   virtual (they exist as soon as they are addressed, are activated on the
   first message and deactivated when idle), each actor handles one message
   at a time, and a crashed actor is simply re-initialised (`:on-error`).

   Messages are Clojure values, and code is data: `swap`, `send` and `get`
   apply a function to an actor's state the way swap!, send and deref do on
   atoms and agents, and the function is sent as its form, written with
   `(actors/fn [state] ...)`, and evaluated where it arrives. A var or a
   symbol names a function that exists on both sides. Inside a silo values
   are passed by reference (they are immutable, so Orleans has nothing to
   copy); between silos they travel as EDN. Both ways mean the same thing.

   State and messages can be described with clojure.spec: a `:state` spec
   is checked after init and after every message (a violation is a bug in
   the actor and restarts it), a spec on a handler is checked on the
   incoming payload (a violation is a bad message and is rejected without
   touching the actor). `describe` shows what an actor type expects."
  (:refer-clojure :exclude [cast fn get send swap!])
  (:require [clojure.clr.async.task.alpha :as t]
            [clojure.edn :as edn]
            [clojure.spec.alpha :as s]
            [clojure.string :as str]
            [clojure.walk :as walk])
  (:import [Clojure.Orleans Actors ActorGrain ActorMessage ActorReply IActorGrain IActorHost IClojureWire]
           [Microsoft.Extensions.Hosting IHost]
           [Microsoft.Extensions.Logging LogLevel]
           [System TimeSpan]
           [System.Threading Timeout]))

(set! *warn-on-reflection* true)

(def ^:private task-of-object "System.Threading.Tasks.Task`1[System.Object]")

(defn- warn [& parts]
  (binding [*out* *err*]
    (println (apply str parts))))

(defn- as-task
  "Gives the compiler the static Task<object> type that t/await needs."
  ^"System.Threading.Tasks.Task`1[System.Object]" [x] x)

;; ── Registry ─────────────────────────────────────────────────────

(defonce ^:private definitions (atom {}))
(defonce ^:private grain-factory (atom nil))

(defn register-actor!
  "Registers an actor definition for a type keyword:
     {:init     (clojure.core/fn [self id] state)
      :call     {msg-type (clojure.core/fn [self state payload] [reply state])}
      :cast     {msg-type (clojure.core/fn [self state payload] state)}
      :info     {msg-type (clojure.core/fn [self state payload] state)}
      :state    spec of the state, optional
      :specs    {:call {msg-type payload-spec} :cast {...} :info {...}}, optional
      :on-error :restart | :resume | :stop}
   Handlers may return a Task<object> (t/async) instead of a value.
   `defactor` is the convenient way to build this map."
  [type definition]
  (clojure.core/swap! definitions assoc type definition)
  type)

(defn- key->type+id [^String key]
  (let [[type id] (str/split key #"/" 2)]
    [(keyword type) id]))

(defn- definition-of [^ActorGrain grain]
  (let [[type id] (key->type+id (.Key grain))]
    [(or (clojure.core/get @definitions type)
         (throw (ex-info (str "No actor defined for type " type) {:key (.Key grain)})))
     type id]))

;; ── Messages ─────────────────────────────────────────────────────

(defn- message ^ActorMessage [type payload]
  (ActorMessage. (subs (str type) 1) payload))   ; keeps the namespace of a qualified keyword

(defn- payload-of [^ActorMessage message]
  (.Payload message))

;; ── The wire: how values leave the process ───────────────────────
;; Orleans only serializes a message that goes to another silo. Values are
;; written as EDN; a var travels as its symbol. Anything that cannot be
;; printed and read back (a compiled function, a .NET object) is refused.

(defn- var->symbol [^clojure.lang.Var v]
  (symbol (str (.Namespace v)) (str (.Symbol v))))

(defn write-wire
  "The EDN text for a value leaving the process."
  [value]
  (let [text (pr-str (walk/postwalk (clojure.core/fn [x]
                                      (cond (var? x) (var->symbol x)
                                            (fn? x) (throw (ex-info (str "A compiled function cannot leave the process; send code with (actors/fn ...), a var or a symbol: " x)
                                                                    {:value x}))
                                            :else x))
                                    value))]
    (when (str/includes? text "#object[")
      (throw (ex-info (str "This value cannot leave the process, it does not print as data: " text) {:value value})))
    text))

(defn read-wire
  "The value for EDN text from another silo."
  [text]
  (edn/read-string text))

(defn- wire []
  (reify IClojureWire
    (Write [_ value] (write-wire value))
    (Read [_ text] (read-wire text))))

;; ── Sending ──────────────────────────────────────────────────────

(defn actor-ref
  "A reference to the actor of the given type and id. The actor does not
   need to exist yet: it is created when the first message arrives."
  ^IActorGrain [type id]
  (Actors/Ref (or @grain-factory (throw (ex-info "The actor system is not started (orleans.actors/start!)" {})))
              (str (name type) "/" id)))

(defn call
  "Sends a request and returns a Task<object> of the reply. Await it in an
   async context with t/await, or use call! to block. A payload the actor
   rejects (see `defactor`) throws ex-info with the actor's explanation."
  ([ref type] (call ref type nil))
  ([^IActorGrain ref type payload]
   (t/async
     (let [^ActorReply reply (t/await (.Call ref (message type payload)))
           value (.Value reply)]
       (if (.Ok reply)
         value
         (throw (ex-info (str "Actor " (:actor value) " rejected " (:message value) ": " (:explain value))
                         value)))))))

(alter-meta! #'call assoc :tag task-of-object)

(defn call!
  "Blocking call: sends a request and waits for the reply. For drivers, tests
   and the REPL only: inside a handler use (t/await (call ...)), blocking an
   actor's thread on another actor deadlocks."
  ([ref type] (call! ref type nil))
  ([ref type payload] (t/result (call ref type payload))))

(defn cast
  "Sends a message without waiting for it to be handled. Returns a Task that
   completes when the message has been sent."
  ([ref type] (cast ref type nil))
  ([^IActorGrain ref type payload] (.Cast ref (message type payload))))

(defn reply
  "Return value for call handlers: the reply and the new state."
  [value state]
  [value state])

;; ── Functions as data ────────────────────────────────────────────
;; A function sent to an actor is code: its form plus the namespace it was
;; written in, evaluated in that namespace where it arrives (once per
;; distinct form, then cached). It means the same thing on every silo, and
;; it is plain data on the wire.

(defmacro fn
  "A function as data, to send to an actor with swap, send or get:

     (actors/swap w (actors/fn [world] (assoc world :world/collected ~n)))

   The form is evaluated by the receiving actor in the namespace this is
   written in (which has to exist there, i.e. the same code is deployed).
   Values from the surrounding code are spliced in with ~, as in a syntax
   quote, and must be data."
  [& fn-tail]
  (let [values (atom [])
        form (walk/postwalk (clojure.core/fn [x]
                              (if (and (seq? x) (= 'clojure.core/unquote (first x)))
                                (let [placeholder (keyword "orleans.actors" (str "unquote-" (count @values)))]
                                  (clojure.core/swap! values conj (second x))
                                  placeholder)
                                x))
                            (cons 'clojure.core/fn fn-tail))]
    `(code '~(ns-name *ns*) '~form ~@(deref values))))

(defn code
  "The data form of a function: the namespace to evaluate in, the form, and
   the values spliced into it. (actors/fn ...) builds this."
  [ns form & values]
  (let [placeholders (zipmap (map (clojure.core/fn [i] (keyword "orleans.actors" (str "unquote-" i))) (range))
                             values)]
    {::ns ns
     ::form (walk/postwalk (clojure.core/fn [x] (clojure.core/get placeholders x x)) form)}))

(defonce ^:private compiled (atom {}))

(defn- compile-code [{::keys [ns form] :as code}]
  (or (clojure.core/get @compiled code)
      (let [f (binding [*ns* (do (require ns) (the-ns ns))]
                (eval form))]
        (when (> (count @compiled) 1000) (reset! compiled {}))
        (clojure.core/swap! compiled assoc code f)
        f)))

(defn- resolve-fn
  "The function for what was sent: code, a var, a symbol naming a var, or
   a keyword."
  [f]
  (cond
    (and (map? f) (::form f)) (compile-code f)
    (keyword? f) f
    (var? f) f
    (symbol? f) (or (requiring-resolve f) (throw (ex-info (str "No var " f " on this silo") {:symbol f})))
    :else (throw (ex-info (str "Functions are sent as data: (actors/fn ...), a var, a symbol or a keyword, not " (pr-str f))
                          {:value f}))))

(defn- check-fn-data!
  "Refuses a compiled function up front, so the semantics do not depend on
   whether the actor happens to be in this process."
  [f]
  (when (and (fn? f) (not (keyword? f)))
    (throw (ex-info (str "Functions are sent as data: (actors/fn ...), a var, a symbol or a keyword, not " f) {:value f})))
  f)

;; Every actor understands these, the way an atom understands swap! and an
;; agent understands send: the function runs inside the actor, one message
;; at a time, and the result is checked against the state spec.

(defn swap
  "Applies f to the actor's state (with args) and stores the result, like
   clojure.core/swap! on an atom. Returns a Task of the new state.
   f is code, see `fn`, a var, a symbol or a keyword."
  [ref f & args]
  (call ref ::swap [(check-fn-data! f) args]))

(alter-meta! #'swap assoc :tag task-of-object)

(defn swap!
  "Blocking swap."
  [ref f & args]
  (t/result (apply swap ref f args)))

(defn send
  "Applies f to the actor's state without waiting, like clojure.core/send on
   an agent."
  [ref f & args]
  (cast ref ::swap [(check-fn-data! f) args]))

(defn get
  "Applies f to the actor's state (with args) and returns a Task of the
   result; the state is unchanged. A keyword is a function, so
   (get ref :world/collected) reads one key."
  [ref f & args]
  (call ref ::get [(check-fn-data! f) args]))

(alter-meta! #'get assoc :tag task-of-object)

(defn get!
  "Blocking get."
  [ref f & args]
  (t/result (apply get ref f args)))

(def ^:private built-in-handlers
  {:call {::swap (clojure.core/fn [_ state [f args]] (let [state (apply (resolve-fn f) state args)] (reply state state)))
          ::get (clojure.core/fn [_ state [f args]] (reply (apply (resolve-fn f) state args) state))}
   :cast {::swap (clojure.core/fn [_ state [f args]] (apply (resolve-fn f) state args))}})

;; ── Inside a handler: self ───────────────────────────────────────

(defn self-ref
  "A reference to the actor itself, to pass to others."
  ^IActorGrain [^ActorGrain self]
  (Actors/Ref (.Factory self) (.Key self)))

(defn self-id [^ActorGrain self]
  (second (key->type+id (.Key self))))

(defn send-after
  "Delivers a message to the actor's own info handler after ms milliseconds."
  ([self ms type] (send-after self ms type nil))
  ([^ActorGrain self ms type payload]
   (.Timer self (message type payload) (TimeSpan/FromMilliseconds (double ms)) Timeout/InfiniteTimeSpan)))

(defn send-every
  "Delivers a message to the actor's own info handler every ms milliseconds.
   Returns an IDisposable that cancels the timer."
  ([self ms type] (send-every self ms type nil))
  ([^ActorGrain self ms type payload]
   (.Timer self (message type payload) (TimeSpan/FromMilliseconds (double ms)) (TimeSpan/FromMilliseconds (double ms)))))

(defn stop
  "Deactivates the actor after the current message. The next message sent to
   it creates a fresh one (init runs again)."
  [^ActorGrain self]
  (.Stop self))

;; ── Runtime: the Orleans side calls these ─────────────────────────

(defn- run-handler
  "Calls a handler and returns a Task<object> of its result, whether the
   handler returned a value or a Task."
  [f & args]
  (t/async
    (let [result (apply f args)]
      (if (t/task? result)
        (t/await (as-task result))
        result))))

(alter-meta! #'run-handler assoc :tag task-of-object)

(defonce ^:private state-check-sample (atom 10))

(defn check-state!
  "How states are checked against their :state spec after init and after
   every message: false turns the checks off, true or a number sets how many
   elements of a collection described with s/every or s/every-kv are
   examined per check (the default, 10, keeps a check on a large state map
   well under a millisecond; s/coll-of and s/map-of always check every
   element). The check otherwise costs what s/valid? costs on the state."
  [setting]
  (reset! state-check-sample
          (cond (false? setting) nil
                (nil? setting) nil
                (number? setting) (long setting)
                :else 10)))

(defn- conform-state!
  "Throws when the state does not conform to the actor's :state spec. A
   handler that returns the state it was given (identical, not merely equal)
   is not checked again: the state still conforms."
  [definition type msg-type state previous]
  (when-let [spec (:state definition)]
    (when-let [sample @state-check-sample]
      (when-not (identical? state previous)
        (binding [s/*coll-check-limit* sample]
          (when-not (s/valid? spec state)
            (throw (ex-info (str "Actor " type (when msg-type (str " after " msg-type))
                                 ": the state does not conform to " spec ": " (s/explain-str spec state))
                            {:actor type :message msg-type :spec spec :state state}))))))))

(defn- payload-problem
  "The rejection data when a payload does not conform to the handler's spec,
   nil when it does or when the handler has no spec."
  [definition kind type msg-type payload]
  (when-let [spec (get-in definition [:specs kind msg-type])]
    (when-not (s/valid? spec payload)
      {:actor type :message msg-type :spec spec :explain (s/explain-str spec payload)})))

(defn- init! [^ActorGrain grain]
  (t/async
    (let [[definition type id] (definition-of grain)
          state (t/await (run-handler (:init definition) grain id))]
      (conform-state! definition type nil state ::none)
      (set! (.State grain) state)
      nil)))

(alter-meta! #'init! assoc :tag task-of-object)

(defn- handle
  "Runs the handler of the given kind (:call, :cast or :info) for a message.
   Call handlers return [reply state]; the reply travels as EDN [:ok reply],
   a rejected payload as [:error data]. Cast and info handlers return the
   new state."
  [kind ^ActorGrain grain ^ActorMessage message]
  (t/async
    (let [[definition type _] (definition-of grain)
          msg-type (keyword (.Type message))
          handler (or (get-in definition [kind msg-type])
                      (get-in built-in-handlers [kind msg-type])
                      (throw (ex-info (str "Actor " type " has no " (name kind) " handler for " msg-type)
                                      {:actor type :message msg-type})))
          payload (payload-of message)
          problem (payload-problem definition kind type msg-type payload)]
      (cond
        (and problem (= kind :call))
        (ActorReply. false problem)

        problem
        (do (warn "actor " type " rejected " msg-type ": " (:explain problem))
            nil)

        :else
        (let [previous (.State grain)
              result (t/await (run-handler handler grain previous payload))]
          (if (= kind :call)
            (let [_ (when-not (and (vector? result) (= 2 (count result)))
                      (throw (ex-info (str "Actor " type ": the " msg-type " call handler returned " (pr-str result)
                                           "; call handlers return (reply value state)")
                                      {:actor type :message msg-type})))
                  [value new-state] result]
              (conform-state! definition type msg-type new-state previous)
              (set! (.State grain) new-state)
              (ActorReply. true value))
            (do (conform-state! definition type msg-type result previous)
                (set! (.State grain) result)
                nil)))))))

(alter-meta! #'handle assoc :tag task-of-object)

(defn- on-error
  "Applies the actor's :on-error policy after a handler threw:
     :restart (default) the state is rebuilt with init, like a supervised
              GenServer coming back after a crash
     :resume  the state is kept
     :stop    the actor is deactivated
   The exception still reaches the caller."
  [^ActorGrain grain ^Exception error]
  (t/async
    (let [[definition type id] (definition-of grain)]
      (binding [*out* *err*]
        (println (str "actor " type "/" id " failed: " (.Message error))))
      (case (:on-error definition :restart)
        :restart (do (.ClearTimers grain)
                     (t/await (init! grain)))
        :stop (stop grain)
        nil)
      nil)))

(alter-meta! #'on-error assoc :tag task-of-object)

(defn- host []
  (reify IActorHost
    (OnActivate [_ grain] (init! grain))
    (OnDeactivate [_ _grain _reason] (t/completed-task))
    (OnCall [_ grain message] (handle :call grain message))
    (OnCast [_ grain message] (handle :cast grain message))
    (OnInfo [_ grain message] (handle :info grain message))
    (OnError [_ grain error] (on-error grain error))))

(defn describe
  "What an actor type expects: its state spec, the messages it handles and
   their payload specs (as s/describe forms), and its error policy."
  [type]
  (let [definition (or (clojure.core/get @definitions type) (throw (ex-info (str "No actor defined for type " type) {})))
        messages (clojure.core/fn [kind]
                   (into (sorted-map)
                         (map (clojure.core/fn [[msg-type _]]
                                [msg-type (some-> (get-in definition [:specs kind msg-type]) s/describe)]))
                         (clojure.core/get definition kind)))]
    {:type type
     :state (some-> (:state definition) s/describe)
     :on-error (:on-error definition :restart)
     :call (messages :call)
     :cast (messages :cast)
     :info (messages :info)}))

;; ── The actor system ─────────────────────────────────────────────

(defn start!
  "Starts an Orleans silo in this process hosting all defined actors and
   returns it. Options: :silo-port (11111), :gateway-port (30000),
   :log-level (LogLevel/Warning)."
  ([] (start! {}))
  ([{:keys [silo-port gateway-port log-level]
     :or {silo-port 11111 gateway-port 30000 log-level LogLevel/Warning}}]
   (Actors/SetHost (host))
   (Actors/SetWire (wire))
   (let [silo (Actors/StartSilo (int silo-port) (int gateway-port) log-level)]
     (reset! grain-factory (Actors/GrainFactory silo))
     silo)))

(defn round-trip
  "Serializes a message the way it would travel to another silo and reads it
   back: what the other side would receive. For tests and curiosity."
  [silo type payload]
  (.Payload (Actors/RoundTrip silo (message type payload))))

(defn stop!
  "Stops the silo started with start!."
  [^IHost silo]
  (reset! grain-factory nil)
  (Actors/StopSilo silo))

;; ── defactor ─────────────────────────────────────────────────────

(defn- handler-fn
  "Builds (clojure.core/fn [self state payload] (t/async body...)) from a handler clause's
   argument vector, which may leave out trailing arguments. The runtime calls
   init with [self id] and the other handlers with [self state payload]."
  [args body arity]
  (when (> (count args) arity)
    (throw (ex-info (str "defactor: handler takes at most " arity " arguments, got " args) {})))
  (let [params (vec (take arity (concat args (repeatedly #(gensym "_")))))]
    `(clojure.core/fn ~params (t/async ~@body))))

(defmacro defactor
  "Defines an actor type and a function that returns references to its
   actors: (defactor ant ...) defines (ant id).

     (defactor counter
       \"Counts.\"
       {:state ::count                      ; options, optional: spec of the state,
        :on-error :restart}                 ;   error policy
       (init [self id] 0)                   ; -> state
       (call :get [self state] (reply state state))
       (call :add ::amount [self state n]   ; optional spec of the payload
         (reply (+ state n) (+ state n)))
       (cast :reset [self state] 0)
       (info :tick [self state] (inc state)))

   Handler bodies run in an async context, so they can t/await calls to
   other actors. Call handlers return [reply new-state] (see `reply`); cast
   and info handlers return the new state.

   With a :state spec the state is checked after init and after every
   message; a violation is a bug in the actor, so the actor fails and its
   :on-error policy applies. A payload that fails its spec is rejected
   before the handler runs: the caller gets an ex-info, the actor is
   untouched."
  [name & body]
  (let [[doc body] (if (string? (first body)) [(first body) (rest body)] [nil body])
        [options body] (if (map? (first body)) [(first body) (rest body)] [{} body])
        type (keyword name)
        clauses (for [[kind & clause] body]
                  (case kind
                    init (let [[args & b] clause] [:init nil nil (handler-fn args b 2)])
                    (call cast info) (let [[msg-type & more] clause
                                           [spec more] (if (vector? (first more)) [nil more] [(first more) (rest more)])
                                           [args & b] more]
                                       [(keyword kind) msg-type spec (handler-fn args b 3)])
                    (throw (ex-info (str "defactor " name ": unknown clause " kind) {}))))
        init (some (clojure.core/fn [[k _ _ f]] (when (= k :init) f)) clauses)
        handlers (reduce (clojure.core/fn [m [k msg-type _ f]] (if (= k :init) m (assoc-in m [k msg-type] f))) {} clauses)
        specs (reduce (clojure.core/fn [m [k msg-type spec _]] (if spec (assoc-in m [k msg-type] spec) m)) {} clauses)]
    (when-not init
      (throw (ex-info (str "defactor " name ": an init clause is required") {})))
    `(do
       (register-actor! ~type (merge {:init ~init :specs ~specs} ~handlers ~options))
       (defn ~(with-meta name {:doc (or doc (str "Reference to the " name " actor with the given id."))
                               :actor/type type})
         [~'id]
         (actor-ref ~type ~'id)))))
