(ns orleans.actors
  "Actors, GenServer style.

   An actor type is defined with `defactor`: an `init` and handlers for
   `call` (request/response), `cast` (fire and forget) and `info` (timer
   messages). A reference to an actor is data, {:actor/type :ant :actor/id
   \"7\"}, so it can travel in a message; the actor exists as soon as it is
   addressed.

   Every handler gets a context as its first argument, a map with
   namespaced keys, and everything an actor does besides computing its next
   state goes through it: sending to other actors (`call`, `cast`, through
   :actor/system), timers to itself (`send-after`, `send-every`) and `stop`
   (through :actor/host), and the :actor/storage its state persists in;
   :actor/self is its own ref. The context comes from whatever hosts the
   actor, so nothing here is global: on Orleans (orleans.actors.silo) the
   system reaches the cluster; in a test (orleans.actors.local) it is an
   in-process system that runs actors synchronously. `call` and `cast` take
   a running system just as well as a context, so drivers, tests and actors
   use one API.

   This namespace is the runtime both hosts share: dispatch on the actor
   type, payload and state specs, persistence through the
   orleans.actors.storage protocol and the :on-error policy. A host adds a
   state slot, timers and deactivation (see `context`, `activate`, `handle`
   and `recover`).

   Messages and states are Clojure values. Inside a silo they are passed by
   reference (they are immutable); between silos, and in a file storage,
   they are EDN (orleans.actors.wire), so they have to be data. State and
   messages can be described with clojure.spec: a `:state` spec is checked
   after init and after every message (a violation is a bug in the actor
   and restarts it), a spec on a handler is checked on the incoming payload
   (a violation is a bad message and is rejected without touching the
   actor). `describe` shows what an actor type expects."
  (:refer-clojure :exclude [cast])
  (:require [clojure.clr.async.task.alpha :as t]
            [clojure.spec.alpha :as s]
            [clojure.spec.gen.alpha :as gen]
            [orleans.actors.storage :as storage]))

(set! *warn-on-reflection* true)

(def ^:private task-of-object "System.Threading.Tasks.Task`1[System.Object]")

(defn- as-task
  "Gives the compiler the static Task<object> type that t/await needs."
  ^"System.Threading.Tasks.Task`1[System.Object]" [x] x)

(defn as-async
  "A Task<object> of x, which is a value or a Task<object> (what t/async
   returns): how the runtime takes what handlers and storages return."
  [x]
  (t/async (if (t/task? x) (t/await (as-task x)) x)))

(alter-meta! #'as-async assoc :tag task-of-object)

(defn- as-plain ^System.Threading.Tasks.Task [x] x)
(defn- as-task-of-task ^"System.Threading.Tasks.Task`1[System.Threading.Tasks.Task]" [x] x)
(defn- as-tasks ^"System.Threading.Tasks.Task[]" [x] x)

(defn outcome
  "For hosts. A Task<object> of [value nil] when the given Task<object>
   completes, or [nil exception] when it faults: a way to await a handler
   and act on its failure, since t/await cannot sit inside try."
  [task]
  (t/async
    (t/await (as-task-of-task (System.Threading.Tasks.Task/WhenAny (as-tasks (into-array System.Threading.Tasks.Task [(as-plain task)])))))
    (if (.IsCompletedSuccessfully (as-plain task))
      [(.Result (as-task task)) nil]
      [nil (let [e (.Exception (as-plain task))]
             (or (first (.InnerExceptions e)) e))])))

(alter-meta! #'outcome assoc :tag task-of-object)

(defn- warn [& parts]
  (binding [*out* *err*]
    (println (apply str parts))))

;; ── What a host provides ─────────────────────────────────────────

(defprotocol Messaging
  "Sending messages to actors. A running system implements it, and so does
   the context an actor gets, so `call` and `cast` are the same everywhere."
  (-call [this ref type payload]
    "A Task<object> of the reply: {:ok? true :value value}, or {:ok? false
     :value rejection} for a message the actor rejected.")
  (-cast [this ref type payload]
    "Sends without waiting for the message to be handled; a Task that
     completes once it is sent."))

(defprotocol Host
  "What hosts one activation of an actor: its timers and its deactivation.
   The :actor/host of a context implements it."
  (-timer [host type payload due-ms period-ms]
    "Delivers the message to the actor's info handler after due-ms, then
     every period-ms (nil: once). Returns an IDisposable that cancels it.")
  (-clear-timers [host] "Cancels the actor's timers.")
  (-stop [host] "Deactivates the actor after the current message."))

;; ── References ───────────────────────────────────────────────────

(s/def :actor/type simple-keyword?)
(s/def :actor/id string?)
(s/def ::ref (s/keys :req [:actor/type :actor/id]))

(defn actor-ref
  "A reference to the actor of the given type and id. The actor does not
   need to exist yet: it is created when the first message arrives."
  [type id]
  {:actor/type type :actor/id (str id)})

;; ── The context ──────────────────────────────────────────────────

(s/def :actor/self ::ref)
(s/def :actor/system #(satisfies? Messaging %))
(s/def :actor/storage #(satisfies? storage/Storage %))
(s/def :actor/host #(satisfies? Host %))
(s/def ::context (s/keys :req [:actor/self :actor/system :actor/storage :actor/host]))

(defn context
  "For hosts: the context of an actor, what every handler gets first.
     :actor/self     the actor's own ref, to pass to others
     :actor/system   the system it sends through (Messaging)
     :actor/storage  the system's orleans.actors.storage/Storage; a
                     persisting actor's state goes through it on its own,
                     it is there for anything else an actor wants to keep
     :actor/host     what hosts this activation (Host)"
  [ref system storage host]
  {:actor/self ref :actor/system system :actor/storage storage :actor/host host})

(defn- system-of
  "The system to send through: the one in a context, or x itself."
  [x]
  (or (:actor/system x) x))

;; ── Registry ─────────────────────────────────────────────────────
;; Definitions are code, like the methods of a multimethod: defactor adds
;; one per actor type, and the runtime dispatches on the type of the ref.

(defonce ^:private definitions (atom {}))

(defn register-actor!
  "Registers an actor definition for a type keyword:
     {:init     (fn [ctx id] state)
      :resume   (fn [ctx stored] state), optional, for a persisting actor
      :call     {msg-type (fn [ctx state payload] [reply state])}
      :cast     {msg-type (fn [ctx state payload] state)}
      :info     {msg-type (fn [ctx state payload] state)}
      :state    spec of the state, optional
      :specs    {:call {msg-type payload-spec} :cast {...} :info {...}}, optional
      :persist  true to store the state, optional
      :on-error :restart | :resume | :stop}
   Handlers may return a Task<object> (t/async) instead of a value.
   `defactor` is the convenient way to build this map."
  [type definition]
  (swap! definitions assoc type definition)
  type)

(defn- definition-of [type]
  (or (get @definitions type)
      (throw (ex-info (str "No actor defined for type " type) {:actor type}))))

;; ── Sending ──────────────────────────────────────────────────────

(defn call
  "Sends a request and returns a Task<object> of the reply. `system` is the
   context inside a handler, where the reply is awaited ((t/await
   (actors/call ctx ref :msg payload))), or a running system in a driver
   or a test, where `call!` blocks. A payload the actor rejects (see
   `defactor`) throws ex-info with the actor's explanation."
  ([system ref type] (call system ref type nil))
  ([system ref type payload]
   (t/async
     (let [{:keys [ok? value]} (t/await (as-task (-call (system-of system) ref type payload)))]
       (if ok?
         value
         (throw (ex-info (str "Actor " (:actor value) " rejected " (:message value) ": " (:explain value))
                         value)))))))

(alter-meta! #'call assoc :tag task-of-object)

(defn call!
  "Blocking call: sends a request and waits for the reply. For drivers,
   tests and the REPL only: inside a handler use (t/await (call ...)),
   blocking an actor's thread on another actor deadlocks."
  ([system ref type] (call! system ref type nil))
  ([system ref type payload] (t/result (call system ref type payload))))

(defn cast
  "Sends a message without waiting for it to be handled. Returns a Task
   that completes when the message has been sent."
  ([system ref type] (cast system ref type nil))
  ([system ref type payload] (-cast (system-of system) ref type payload)))

(defn reply
  "Return value for call handlers: the reply and the new state."
  [value state]
  [value state])

;; ── Inside a handler: what goes through the context ──────────────

(defn send-after
  "Delivers a message to the actor's own info handler after ms
   milliseconds. Returns an IDisposable that cancels it."
  ([ctx ms type] (send-after ctx ms type nil))
  ([ctx ms type payload] (-timer (:actor/host ctx) type payload ms nil)))

(defn send-every
  "Delivers a message to the actor's own info handler every ms
   milliseconds. Returns an IDisposable that cancels the timer."
  ([ctx ms type] (send-every ctx ms type nil))
  ([ctx ms type payload] (-timer (:actor/host ctx) type payload ms ms)))

(defn stop
  "Deactivates the actor after the current message. The next message sent
   to it creates a fresh one: init runs again, or resume when the actor
   persists."
  [ctx]
  (-stop (:actor/host ctx)))

(defn forget
  "Discards the stored state of a persisting actor. Returns a Task; the
   next activation runs init again."
  [ctx]
  (let [{:actor/keys [type id]} (:actor/self ctx)]
    (as-async (storage/clear-state (:actor/storage ctx) type id))))

(alter-meta! #'forget assoc :tag task-of-object)

;; ── The runtime: what a host calls ───────────────────────────────

(defn settings
  "For hosts: the runtime settings from a system's options. :state-check
   is how states are checked against their :state spec after init and
   after every message: false turns the checks off, a number sets how many
   elements of a collection described with s/every or s/every-kv are
   examined per check (the default, 10, keeps a check on a large state map
   well under a millisecond; s/coll-of and s/map-of always check every
   element). The check otherwise costs what s/valid? costs on the state."
  [{:keys [state-check] :or {state-check 10}}]
  {:state-check (cond (false? state-check) nil
                      (nil? state-check) nil
                      (number? state-check) (long state-check)
                      :else 10)})

(defn- conform-state!
  "Throws when the state does not conform to the actor's :state spec. A
   handler that returns the state it was given (identical, not merely
   equal) is not checked again: the state still conforms."
  [definition sample type msg-type state previous]
  (when-let [spec (:state definition)]
    (when (and sample (not (identical? state previous)))
      (binding [s/*coll-check-limit* sample]
        (when-not (s/valid? spec state)
          (throw (ex-info (str "Actor " type (when msg-type (str " after " msg-type))
                               ": the state does not conform to " spec ": " (s/explain-str spec state))
                          {:actor type :message msg-type :spec spec :state state})))))))

(defn- payload-problem
  "The rejection data when a payload does not conform to the handler's
   spec, nil when it does or when the handler has no spec."
  [definition kind type msg-type payload]
  (when-let [spec (get-in definition [:specs kind msg-type])]
    (when-not (s/valid? spec payload)
      {:actor type :message msg-type :spec spec :explain (s/explain-str spec payload)})))

(defn- store!
  "Stores the state when the actor persists and the state changed."
  [ctx definition state previous]
  (t/async
    (when (and (:persist definition) (not (identical? state previous)))
      (let [{:actor/keys [type id]} (:actor/self ctx)]
        (t/await (as-async (storage/write-state (:actor/storage ctx) type id state)))))
    nil))

(alter-meta! #'store! assoc :tag task-of-object)

(defn activate
  "For hosts. Runs init, or resume with the stored state when the actor
   persists and has one, checks the result against the state spec and
   stores it when the actor persists. Returns a Task of the state."
  [ctx settings]
  (t/async
    (let [{:actor/keys [type id]} (:actor/self ctx)
          definition (definition-of type)
          stored (if (:persist definition)
                   (t/await (as-async (storage/read-state (:actor/storage ctx) type id)))
                   storage/none)
          state (if (storage/none? stored)
                  (t/await (as-async ((:init definition) ctx id)))
                  (t/await (as-async ((:resume definition (fn [_ stored] stored)) ctx stored))))]
      (conform-state! definition (:state-check settings) type nil state ::none)
      (t/await (store! ctx definition state ::none))
      state)))

(alter-meta! #'activate assoc :tag task-of-object)

(defn handle
  "For hosts. Handles one message of the given kind (:call, :cast or
   :info) in the given state. Returns a Task of [reply state]: for a call,
   reply is what `call` expects, {:ok? true :value value} or {:ok? false
   :value rejection}; for a cast or an info message it is nil. A message
   the actor rejects, because no handler takes it or its payload does not
   conform to the handler's spec, leaves the state as it is."
  [ctx settings kind state msg-type payload]
  (t/async
    (let [type (:actor/type (:actor/self ctx))
          definition (definition-of type)
          handler (get-in definition [kind msg-type])
          problem (if handler
                    (payload-problem definition kind type msg-type payload)
                    ;; an unknown message is the sender's mistake, not the actor's: rejected, no restart
                    {:actor type :message msg-type
                     :explain (str "no " (name kind) " handler for " msg-type)})]
      (cond
        (and problem (= kind :call))
        [{:ok? false :value problem} state]

        problem
        (do (warn "actor " type " rejected " msg-type ": " (:explain problem))
            [nil state])

        :else
        (let [result (t/await (as-async (handler ctx state payload)))]
          (if (= kind :call)
            (let [_ (when-not (and (vector? result) (= 2 (count result)))
                      (throw (ex-info (str "Actor " type ": the " msg-type " call handler returned " (pr-str result)
                                           "; call handlers return (reply value state)")
                                      {:actor type :message msg-type})))
                  [value new-state] result]
              (conform-state! definition (:state-check settings) type msg-type new-state state)
              (t/await (store! ctx definition new-state state))
              [{:ok? true :value value} new-state])
            (do (conform-state! definition (:state-check settings) type msg-type result state)
                (t/await (store! ctx definition result state))
                [nil result])))))))

(alter-meta! #'handle assoc :tag task-of-object)

(defn recover
  "For hosts. Applies the actor's :on-error policy after a handler threw:
     :restart (default) the actor is re-initialised with `activate`, like a
              supervised GenServer coming back after a crash; a persisting
              actor resumes from its stored state, the last one that
              conformed
     :resume  the state is kept
     :stop    the actor is deactivated
   Returns a Task of the state to continue with. The exception itself
   still reaches the caller."
  [ctx settings state ^Exception error]
  (t/async
    (let [{:actor/keys [type id]} (:actor/self ctx)
          definition (definition-of type)]
      (warn "actor " type "/" id " failed: " (.Message error))
      (case (:on-error definition :restart)
        :restart (do (-clear-timers (:actor/host ctx))
                     (t/await (as-task (activate ctx settings))))
        :stop (do (-stop (:actor/host ctx)) state)
        state))))

(alter-meta! #'recover assoc :tag task-of-object)

;; ── Introspection ────────────────────────────────────────────────

(defn describe
  "What an actor type expects: its state spec, the messages it handles and
   their payload specs (as s/describe forms), whether it persists and its
   error policy."
  [type]
  (let [definition (definition-of type)
        messages (fn [kind]
                   (into (sorted-map)
                         (map (fn [[msg-type _]]
                                [msg-type (some-> (get-in definition [:specs kind msg-type]) s/describe)]))
                         (get definition kind)))]
    {:type type
     :state (some-> (:state definition) s/describe)
     :persist (boolean (:persist definition))
     :on-error (:on-error definition :restart)
     :call (messages :call)
     :cast (messages :cast)
     :info (messages :info)}))

(defn message-generator
  "A test.check generator of [message-type payload] for the messages of the
   given kind (:call, :cast or :info) an actor type declares, with payloads
   generated from their specs (nil for a message without one). With it a
   property can send an actor every valid message it accepts:

     (prop/for-all [[type payload] (actors/message-generator :world :call)]
       (actors/call! system (world \"under-test\") type payload)
       true)

   A message the actor cannot handle throws, and after every message the
   runtime checks the state against the :state spec."
  [type kind]
  (let [definition (definition-of type)
        messages (get definition kind)]
    (when (empty? messages)
      (throw (ex-info (str "Actor " type " has no " (name kind) " messages") {:actor type})))
    (gen/one-of (for [[msg-type _] messages
                      :let [spec (get-in definition [:specs kind msg-type])]]
                  (gen/tuple (gen/return msg-type)
                             (if spec (s/gen spec) (gen/return nil)))))))

;; ── defactor ─────────────────────────────────────────────────────

(defn- handler-fn
  "Builds (fn [ctx state payload] (t/async body...)) from a handler clause's
   argument vector, which may leave out trailing arguments. The runtime
   calls init with [ctx id], resume with [ctx stored] and the other
   handlers with [ctx state payload]."
  [args body arity]
  (when (> (count args) arity)
    (throw (ex-info (str "defactor: handler takes at most " arity " arguments, got " args) {})))
  (let [params (vec (take arity (concat args (repeatedly #(gensym "_")))))]
    `(fn ~params (t/async ~@body))))

(defmacro defactor
  "Defines an actor type and a function that returns references to its
   actors: (defactor ant ...) defines (ant id).

     (defactor counter
       \"Counts.\"
       {:state ::count                      ; options, optional: spec of the state,
        :on-error :restart}                 ;   error policy, :persist
       (init [ctx id] 0)                    ; -> state
       (call :get [ctx state] (reply state state))
       (call :add ::amount [ctx state n]    ; optional spec of the payload
         (reply (+ state n) (+ state n)))
       (cast :reset [ctx state] 0)
       (info :tick [ctx state] (inc state)))

   The first argument of every handler is the actor's context (see
   `context`): what it sends through (`call`, `cast`), its timers
   (`send-after`, `send-every`), `stop`, its own ref as :actor/self and the
   system's :actor/storage. Handler bodies run in an async context, so they
   can t/await calls to other actors. Call handlers return [reply new-state]
   (see `reply`); cast and info handlers return the new state.

   With a :state spec the state is checked after init and after every
   message; a violation is a bug in the actor, so the actor fails and its
   :on-error policy applies. A payload that fails its spec is rejected
   before the handler runs: the caller gets an ex-info, the actor is
   untouched.

   With {:persist true} the state is stored after init and after every
   message that changed it, and an actor that is activated again (after
   stop, an idle deactivation, a crash or a silo restart) gets it back:
   (resume [ctx stored] state) runs instead of init, by default keeping
   the stored state as it is. The state has to be data (see the wire)."
  [name & body]
  (let [[doc body] (if (string? (first body)) [(first body) (rest body)] [nil body])
        [options body] (if (map? (first body)) [(first body) (rest body)] [{} body])
        type (keyword name)
        clauses (for [[kind & clause] body]
                  (case kind
                    (init resume) (let [[args & b] clause] [(keyword kind) nil nil (handler-fn args b 2)])
                    (call cast info) (let [[msg-type & more] clause
                                           [spec more] (if (vector? (first more)) [nil more] [(first more) (rest more)])
                                           [args & b] more]
                                       [(keyword kind) msg-type spec (handler-fn args b 3)])
                    (throw (ex-info (str "defactor " name ": unknown clause " kind) {}))))
        init (some (fn [[k _ _ f]] (when (= k :init) f)) clauses)
        resume (some (fn [[k _ _ f]] (when (= k :resume) f)) clauses)
        handlers (reduce (fn [m [k msg-type _ f]] (if (#{:init :resume} k) m (assoc-in m [k msg-type] f))) {} clauses)
        specs (reduce (fn [m [k msg-type spec _]] (if spec (assoc-in m [k msg-type] spec) m)) {} clauses)]
    (when-not init
      (throw (ex-info (str "defactor " name ": an init clause is required") {})))
    `(do
       (register-actor! ~type (merge {:init ~init :specs ~specs} (when ~resume {:resume ~resume}) ~handlers ~options))
       (defn ~(with-meta name {:doc (or doc (str "Reference to the " name " actor with the given id."))
                               :actor/type type})
         [~'id]
         (actor-ref ~type ~'id)))))
