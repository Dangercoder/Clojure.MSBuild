(ns ants.ant
  "The ant actor. Each ant is its own actor, created on first use: init asks
   the world for a place in the nest. On every :step the ant looks around,
   decides (ants.logic/decide) and acts through the world actor, sending
   through its context. Its state is described by ants.model/ant-state."
  (:require [clojure.clr.async.task.alpha :as t]
            [orleans.actors :as actors :refer [defactor reply]]
            [ants.world :refer [world]]
            [ants.logic :as logic]
            [ants.model]))                             ; loads the specs

(defactor ant
  "An ant, addressed as (ant id)."
  {:state :ants.model/ant-state}

  (init [ctx id]
    (let [{:ant/keys [x y dir]} (t/await (actors/call ctx (world "main") :world/spawn id))]
      #:ant{:id id :x x :y y :dir dir :food? false :steps 0}))

  (call :ant/state :ants.model/ant-state [ctx state]
    (reply state state))

  (call :ant/step :ants.model/action [ctx {:ant/keys [id x y dir] :as state}]
    (let [w (world "main")
          look (t/await (actors/call ctx w :world/look (select-keys state [:ant/x :ant/y :ant/dir])))
          [action amount] (logic/decide state look (rand))
          state (update state :ant/steps inc)]
      (case action
        :take-food
        (let [taken? (t/await (actors/call ctx w :world/take-food [x y]))]
          (reply action (cond-> (update state :ant/dir logic/turn 4) taken? (assoc :ant/food? true))))

        :drop-food
        (do (t/await (actors/call ctx w :world/drop-food [x y]))
            (reply action (-> state (assoc :ant/food? false) (update :ant/dir logic/turn 4))))

        :move
        (let [[nx ny] (logic/delta-loc (:world/size look) [x y] dir)
              moved? (t/await (actors/call ctx w :world/move {:ant/id id :move/from [x y] :move/to [nx ny]}))]
          (reply action (if moved? (assoc state :ant/x nx :ant/y ny) state)))

        :turn
        (reply action (update state :ant/dir logic/turn amount))))))
