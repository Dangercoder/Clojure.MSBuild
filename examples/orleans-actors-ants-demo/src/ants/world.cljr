(ns ants.world
  "The world actor: one actor owns the grid (food, pheromone, who is where).
   Ants ask it what they see and tell it what they do. Pheromone evaporates
   on a timer the actor sets for itself. Its state, its messages and its
   replies are described in ants.model."
  (:require [orleans.actors :as actors :refer [defactor reply]]
            [ants.logic :as logic]
            [ants.model]))                             ; loads the specs

(defn- rand-double [] (rand))

(defactor world
  "The grid. One instance, addressed as (world \"main\")."
  {:state :ants.model/world-state}

  (init [ctx id]
    (actors/send-every ctx 250 :world/evaporate)
    (logic/new-world {}))

  (call :world/configure :ants.model/ok [ctx state options]
    (reply :ok (logic/new-world options)))

  (call :world/spawn :ants.model/placed [ctx state id]
    (let [[state ant] (logic/spawn state id (rand-double))]
      (reply ant state)))

  (call :world/look :ants.model/look-view [ctx state {:ant/keys [x y dir]}]
    (reply (logic/look state [x y] dir) state))

  (call :world/move :ants.model/moved? [ctx state {:ant/keys [id] :move/keys [from to]}]
    (let [[state moved?] (logic/move state id from to)]
      (reply moved? state)))

  (call :world/take-food :ants.model/taken? [ctx state loc]
    (let [[state taken?] (logic/take-food state loc)]
      (reply taken? state)))

  (call :world/drop-food :ants.model/ok [ctx state loc]
    (reply :ok (logic/drop-food state loc)))

  (call :world/snapshot :ants.model/snapshot [ctx state]
    (reply (logic/snapshot state) state))

  (cast :world/clear-trails [ctx state]
    (update state :world/cells (fn [cells] (into {} (map (fn [[loc c]] [loc (dissoc c :cell/pher)])) cells))))

  (info :world/evaporate [ctx state]
    (logic/evaporate state)))
