(ns ants.main
  "Runs the colony: starts the actor system, configures the world and drives
   the ants tick by tick, drawing the grid between ticks.

     dotnet run -- --ants 40 --ticks 400 --size 40 [--no-render] [--seed 7]"
  (:require [clojure.clr.async.task.alpha :as t]
            [orleans.actors :as actors]
            [ants.world :refer [world]]
            [ants.ant :refer [ant]]
            [ants.render :as render]
            [ants.logic :as logic])
  (:import [System Console Threading.Thread]))

(defn- parse-args [args]
  (loop [args args opts {:ants 40 :ticks 400 :size 40 :render? true :seed 42}]
    (if-let [[flag value] (seq args)]
      (case flag
        "--ants" (recur (nnext args) (assoc opts :ants (Int32/Parse value)))
        "--ticks" (recur (nnext args) (assoc opts :ticks (Int32/Parse value)))
        "--size" (recur (nnext args) (assoc opts :size (Int32/Parse value)))
        "--seed" (recur (nnext args) (assoc opts :seed (Int32/Parse value)))
        "--no-render" (recur (next args) (assoc opts :render? false))
        (throw (ex-info (str "Unknown argument " flag) {})))
      opts)))

(defn step-all!
  "One tick: every ant steps concurrently (each ant actor still handles its
   own message alone; the world serialises what they do to the grid)."
  [ant-count]
  (t/wait-all (mapv #(actors/call (ant %) :step) (range ant-count))))

(defn run!
  "Runs the simulation and returns the final snapshot."
  [{:keys [ants ticks size render? seed]}]
  (let [w (world "main")]
    (actors/call! w :configure {:size size :seed seed :food-places (quot (* size size) 50)
                                :home-size (logic/nest-size ants)})
    (when render? (render/clear!))
    (dotimes [tick ticks]
      (step-all! ants)
      (when render?
        (render/draw! (actors/call! w :snapshot) tick)
        (Thread/Sleep 30)))
    (actors/call! w :snapshot)))

(defn -main [& args]
  (let [options (parse-args args)
        silo (actors/start! {})]
    (try
      (let [snapshot (run! options)]
        (println (str "\n" (:ants options) " ants, " (:ticks options) " ticks, food collected: " (:collected snapshot))))
      (finally
        (actors/stop! silo)))))
