(ns ants.logic
  "The ant colony rules, as pure functions. This is the classic Clojure ants
   simulation: ants leave the nest, forage for food following pheromone
   trails, carry food home and leave pheromone on the way back. Nothing here
   knows about actors; the world and ant actors call these functions. The
   maps are described in ants.model.")

;; ── Directions ───────────────────────────────────────────────────
;; 0 north, then clockwise in 45 degree steps.

(def dir-delta {0 [0 -1] 1 [1 -1] 2 [1 0] 3 [1 1] 4 [0 1] 5 [-1 1] 6 [-1 0] 7 [-1 -1]})

(defn bound
  "Wraps n into [0, size)."
  [size n]
  (let [n (rem n size)] (if (neg? n) (+ n size) n)))

(defn turn [dir amount] (bound 8 (+ dir amount)))

(defn delta-loc
  "The location one step from [x y] in direction dir, on a torus of the given size."
  [size [x y] dir]
  (let [[dx dy] (dir-delta dir)]
    [(bound size (+ x dx)) (bound size (+ y dy))]))

;; ── Choosing where to go ─────────────────────────────────────────

(defn wrand
  "Weighted random index: slices are weights, r is a random number in [0, 1)."
  [slices r]
  (let [total (reduce + slices)
        target (* r total)]
    (loop [i 0 sum 0]
      (if (< target (+ (nth slices i) sum))
        i
        (recur (inc i) (+ (nth slices i) sum))))))

(defn rank-by
  "Ranks xs by keyfn from 1 (lowest) to (count xs) (highest): {x rank}."
  [keyfn xs]
  (let [sorted (sort-by keyfn xs)]
    (into {} (map-indexed (fn [i x] [x (inc i)]) sorted))))

(defn decide
  "What an ant does next, given its state (only :ant/food? matters), what it
   sees (a ::model/look-view) and a random number r in [0, 1).
   Returns one of [:take-food] [:drop-food] [:move] [:turn n]."
  [{:ant/keys [food?]} {:view/keys [here ahead left right]} r]
  (let [places [ahead left right]
        choose (fn [ranks]
                 (let [weights [(if (:cell/ant? ahead) 0 (ranks ahead)) (ranks left) (ranks right)]]
                   ([[:move] [:turn -1] [:turn 1]] (wrand weights r))))]
    (if food?
      (cond
        (:cell/home? here) [:drop-food]
        (and (:cell/home? ahead) (not (:cell/ant? ahead))) [:move]
        :else (choose (merge-with + (rank-by #(if (:cell/home? %) 1 0) places)
                                    (rank-by :cell/pher places))))
      (cond
        (and (pos? (:cell/food here 0)) (not (:cell/home? here))) [:take-food]
        (and (pos? (:cell/food ahead 0)) (not (:cell/home? ahead)) (not (:cell/ant? ahead))) [:move]
        :else (choose (merge-with + (rank-by :cell/food places)
                                    (rank-by :cell/pher places)))))))

;; ── The world ────────────────────────────────────────────────────

(def ^:private evaporation-rate 0.99)

(defn new-world
  "A size x size world with a home in the middle and food scattered around.
   Only non-empty cells are stored."
  [{:world/keys [size home-size food-places food-range seed]
    :or {size 40 home-size 5 food-places 30 food-range 60 seed 42}}]
  (let [rng (System.Random. (int seed))
        home-min (quot (- size home-size) 2)
        home-max (+ home-min home-size)
        home (for [x (range home-min home-max) y (range home-min home-max)] [[x y] #:cell{:home? true}])
        food (for [_ (range food-places)]
               [[(.Next rng size) (.Next rng size)] #:cell{:food (inc (.Next rng food-range))}])]
    #:world{:size size
            :home [home-min home-max]
            :cells (merge-with merge (into {} home) (into {} food))
            :collected 0}))

(defn cell [world loc] (get-in world [:world/cells loc] {}))

(defn cell-view
  "What an ant sees in a cell."
  [world loc]
  (let [{:cell/keys [food pher home? ant]} (cell world loc)]
    #:cell{:food (or food 0) :pher (or pher 0.0) :home? (boolean home?) :ant? (some? ant)}))

(defn look
  "The view for an ant at [x y] facing dir."
  [world loc dir]
  (let [size (:world/size world)]
    {:world/size size
     :view/here (cell-view world loc)
     :view/ahead (cell-view world (delta-loc size loc dir))
     :view/left (cell-view world (delta-loc size loc (turn dir -1)))
     :view/right (cell-view world (delta-loc size loc (turn dir 1)))}))

(defn update-cell [world loc f & args]
  (apply update-in world [:world/cells loc] f args))

(defn nest-size
  "A nest with room for the given number of ants."
  [ants]
  (max 5 (int (Math/Ceiling (Math/Sqrt (* 2.0 ants))))))

(defn spawn
  "Places ant id on a free home cell. Returns [world #:ant{:x :y :dir}]."
  [world id r]
  (let [[home-min home-max] (:world/home world)
        free (vec (for [x (range home-min home-max) y (range home-min home-max)
                        :when (nil? (:cell/ant (cell world [x y])))]
                    [x y]))
        _ (when (empty? free)
            (throw (ex-info "The nest is full" {:nest (:world/home world)})))
        [x y] (nth free (int (* r (count free))))]
    [(update-cell world [x y] assoc :cell/ant id)
     #:ant{:x x :y y :dir (int (* r 8))}]))

(defn move
  "Moves ant id from one location to a neighbouring one if it is free,
   leaving pheromone behind (except at home). Returns [world moved?]."
  [world id from to]
  (if (some? (:cell/ant (cell world to)))
    [world false]
    [(-> world
         (update-cell from (fn [c] (let [c (dissoc c :cell/ant)]
                                     (if (:cell/home? c) c (update c :cell/pher (fnil + 0.0) 1.0)))))
         (update-cell to assoc :cell/ant id))
     true]))

(defn take-food
  "Returns [world taken?]."
  [world loc]
  (if (pos? (:cell/food (cell world loc) 0))
    [(update-cell world loc update :cell/food dec) true]
    [world false]))

(defn drop-food [world loc]
  (-> world
      (update :world/collected inc)
      (update-cell loc update :cell/food (fnil inc 0))))

(defn evaporate [world]
  (update world :world/cells
          (fn [cells]
            (reduce-kv (fn [m loc c]
                         (if-let [p (:cell/pher c)]
                           (let [p (* p evaporation-rate)]
                             (assoc m loc (if (< p 0.05) (dissoc c :cell/pher) (assoc c :cell/pher p))))
                           (assoc m loc c)))
                       {} cells))))

(defn snapshot
  "A compact picture of the world for rendering: non-empty cells only, as
   [x y food pher home? ant?]."
  [world]
  #:snapshot{:size (:world/size world)
             :collected (:world/collected world)
             :cells (into [] (for [[[x y] {:cell/keys [food pher home? ant]}] (:world/cells world)
                                   :when (or food pher home? ant)]
                               [x y (or food 0) (or pher 0.0) (boolean home?) (some? ant)]))})
