(ns cljapi.todo.model
  "The todo domain as clojure.spec specs. The API validates request bodies
   against them, responses conform to them, and the tests generate their
   data from them with s/gen."
  (:require [clojure.spec.alpha :as s]
            [clojure.spec.gen.alpha :as gen]
            [clojure.string :as str]))

(def max-title-length 200)

;; ── Fields ───────────────────────────────────────────────────────

(s/def ::id pos-int?)

(s/def ::title
  (s/with-gen
    (s/and string? (complement str/blank?) #(<= (count %) max-title-length))
    ;; printable ASCII, non-blank, within the length limit
    #(gen/such-that (complement str/blank?)
                    (gen/fmap (fn [s] (subs s 0 (min (count s) max-title-length)))
                              (gen/string-ascii))
                    100)))

(s/def ::done boolean?)

;; Derived, read-only: "[x] title" / "[ ] title"
(s/def ::display-name (s/and string? #(re-matches #"\[[ x]\] .+" %)))

;; ── Entities and payloads ────────────────────────────────────────

(s/def ::todo (s/keys :req-un [::id ::title ::done ::display-name]))

(s/def ::new-todo (s/keys :req-un [::title]))

(s/def ::todo-update
  (s/and (s/keys :opt-un [::title ::done])
         #(or (contains? % :title) (contains? % :done))))

;; ── Functions ────────────────────────────────────────────────────

(defn display-name [{:keys [title done]}]
  (str (if done "[x] " "[ ] ") title))

(s/fdef display-name
  :args (s/cat :todo (s/keys :req-un [::title ::done]))
  :ret ::display-name)

(defn present
  "Adds the derived fields to a stored todo."
  [todo]
  (assoc todo :display-name (display-name todo)))

(s/fdef present
  :args (s/cat :todo (s/keys :req-un [::id ::title ::done]))
  :ret ::todo)

(defn explain
  "Human readable reason why value does not conform to spec."
  [spec value]
  (str/trim (s/explain-str spec value)))
