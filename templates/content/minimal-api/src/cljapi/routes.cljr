(ns cljapi.routes
  "HTTP endpoints. Handlers take the HttpContext and return a response map
   (see cljapi.web). Request bodies are validated with the specs in
   cljapi.todo.model; async handlers await database calls."
  (:require [clojure.clr.async.task.alpha :as t]
            [clojure.spec.alpha :as s]
            [cljapi.web :as web]
            [cljapi.todo.model :as model]
            [cljapi.todos :as todos]))

(defn- parse-id [ctx]
  (let [s (web/route-param ctx "id")]
    (when (and s (re-matches #"\d+" s))
      (Int64/Parse s))))

(defn- invalid
  "400 response explaining why body does not conform to spec, or nil if it does."
  [spec body]
  (cond
    (nil? body) (web/bad-request "body must be a JSON object")
    (not (s/valid? spec body)) (web/bad-request (model/explain spec body))))

(defn health [_ctx]
  (web/ok {:status "ok"}))

(defn ^:async list-todos [db _ctx]
  (web/ok (mapv model/present (t/await (todos/list-todos db)))))

(defn ^:async get-todo [db ctx]
  (if-let [id (parse-id ctx)]
    (if-let [found (t/await (todos/get-todo db id))]
      (web/ok (model/present found))
      (web/not-found "todo not found"))
    (web/bad-request "id must be a number")))

(defn ^:async create-todo [db ctx]
  (let [body (web/parse-json (t/await (web/read-body ctx)))]
    (or (invalid ::model/new-todo body)
        (web/created (model/present (t/await (todos/create-todo! db (:title body))))))))

(defn ^:async update-todo [db ctx]
  (let [id (parse-id ctx)
        body (web/parse-json (t/await (web/read-body ctx)))]
    (or (when (nil? id) (web/bad-request "id must be a number"))
        (invalid ::model/todo-update body)
        (if-let [updated (t/await (todos/update-todo! db id (select-keys body [:title :done])))]
          (web/ok (model/present updated))
          (web/not-found "todo not found")))))

(defn ^:async delete-todo [db ctx]
  (if-let [id (parse-id ctx)]
    (if (t/await (todos/delete-todo! db id))
      (web/no-content)
      (web/not-found "todo not found"))
    (web/bad-request "id must be a number")))

(defn configure
  "Registers all routes on the WebApplication. db is closed over so handlers
   stay plain functions."
  [app db]
  (-> app
      (web/get "/health" health)
      (web/get "/todos" (partial list-todos db))
      (web/get "/todos/{id}" (partial get-todo db))
      (web/post "/todos" (partial create-todo db))
      (web/put "/todos/{id}" (partial update-todo db))
      (web/delete "/todos/{id}" (partial delete-todo db))))
