(ns cljapi.db
  "Async ADO.NET access with HoneySQL. Works with any ADO.NET provider;
   the template uses Microsoft.Data.Sqlite.

   A db is a map {:conn-string \"...\"}. Every execute! opens its own
   connection, runs one statement and returns rows as maps."
  (:require [clojure.clr.async.task.alpha :as t]
            [honey.sql :as sql])
  (:import [System DBNull]
           [System.Data.Common DbConnection DbCommand DbDataReader]
           [Microsoft.Data.Sqlite SqliteConnection]))

(set! *warn-on-reflection* true)

;; Type alias (ClojureCLR 1.12.3+): |TaskOf[Object]| reads as Task<object>.
(alias-type TaskOf |System.Threading.Tasks.Task`1|)

(defn db
  "Creates a db spec from a connection string."
  [^String conn-string]
  {:conn-string conn-string})

(defn- open-connection ^DbConnection [{:keys [conn-string]}]
  (doto (SqliteConnection. ^String conn-string) (.Open)))

(defn- reader->rows [^DbDataReader reader]
  (let [col-count (.FieldCount reader)
        col-names (mapv #(keyword (.GetName reader (int %))) (range col-count))]
    (loop [rows []]
      (if (.Read reader)
        (recur (conj rows
                     (persistent!
                       (reduce (fn [m i]
                                 (assoc! m (col-names i)
                                         (let [v (.GetValue reader (int i))]
                                           (if (instance? DBNull v) nil v))))
                               (transient {})
                               (range col-count)))))
        rows))))

(defn- prepare-command
  "Turns a HoneySQL sqlvec [sql & params] (positional ? placeholders) into a
   DbCommand with named parameters @p0, @p1, ..."
  ^DbCommand [^DbConnection conn [sql & params]]
  (let [^DbCommand cmd (.CreateCommand conn)
        indexed-sql (loop [^String s sql i 0]
                      (let [idx (.IndexOf s "?")]
                        (if (neg? idx)
                          s
                          (recur (str (subs s 0 idx) "@p" i (subs s (inc idx))) (inc i)))))]
    (set! (.-CommandText cmd) indexed-sql)
    (doseq [[i v] (map-indexed vector params)]
      (let [p (.CreateParameter cmd)]
        (set! (.-ParameterName p) (str "@p" i))
        (set! (.-Value p) (cond (nil? v) DBNull/Value
                                (boolean? v) (if v 1 0)
                                :else v))
        (.Add (.Parameters cmd) p)))
    cmd))

(defn ^:async execute!
  "Runs a HoneySQL map (or a sqlvec) and returns the result rows as maps.
   Statements without a result set return [{:affected n}]."
  [db query]
  (let [sqlvec (if (map? query) (sql/format query) query)]
    (with-open [conn (open-connection db)]
      (let [^DbCommand cmd (prepare-command conn sqlvec)
            ^DbDataReader reader (t/await (.ExecuteReaderAsync cmd))
            result-set? (pos? (.FieldCount reader))
            rows (reader->rows reader)
            affected (.RecordsAffected reader)]
        (.Close reader)
        (if result-set? rows [{:affected affected}])))))

;; (t/await (execute! ...)) needs the static Task<object> type of the call, and a
;; return tag on a ^:async defn is not kept on the var, so attach it explicitly.
;; A var tag must be the full type name; the alias works for hints in code.
(alter-meta! #'execute! assoc :tag (symbol "System.Threading.Tasks.Task`1[System.Object]"))

(defn execute-sync!
  "Blocking variant of execute!, for startup and test setup."
  [db query]
  (.Result ^|TaskOf[Object]| (execute! db query)))
