<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <Features>$(Features);runtime-async=on</Features>
    <AssemblyName>CLJASSEMBLYNAME</AssemblyName>
    <ClojureMainNamespace>cljapi.server</ClojureMainNamespace>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <!-- dotnet run (Debug) also starts an nREPL server inside the application and writes
         .nrepl-port for your editor; CLOJURE_MSBUILD_NREPL=off turns it off for one run -->
    <ClojureNReplInApp Condition="'$(Configuration)' == 'Debug'">true</ClojureNReplInApp>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Clojure.MSBuild" Version="0.0.11" />
    <PackageReference Include="Clojure.MSBuild.TestAdapter" Version="0.0.11" />
    <PackageReference Include="Clojure" Version="1.12.6" />
    <PackageReference Include="clojure.data.json" Version="2.5.1" />
    <PackageReference Include="clojure.tools.nrepl" Version="0.1.0-alpha2" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="11.0.0" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" Version="1.21.0" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.21.0" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Http" Version="1.21.0" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.21.0" />
    <PackageReference Include="Microsoft.AspNetCore.TestHost" Version="11.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />

    <!-- Clojure libraries from git (cloned to ~/.gitlibs, compiled into the build output) -->
    <ClojureGitDep Include="com.github.seancorfield/honeysql" Tag="v2.7.1368" Sha="b8332fc" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="src/**/*.cljr" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="test/**/*.cljr" CopyToOutputDirectory="PreserveNewest" />
    <Content Remove=".template.config/**" />
  </ItemGroup>

</Project>
