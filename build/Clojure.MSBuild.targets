<Project>

  <!-- Computed at target time so this file also works when imported directly from a csproj -->
  <Target Name="_ClojureInit">
    <PropertyGroup>
      <!-- Where generated Clojure sources and compiled output live (absolute, trailing slash) -->
      <_ClojureGenDir>$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)', '$(IntermediateOutputPath)', 'clj'))</_ClojureGenDir>
      <_ClojureBuildDir>$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)', '$(IntermediateOutputPath)', 'clj-out'))</_ClojureBuildDir>
      <_ClojureEntryFile>$(IntermediateOutputPath)ClojureEntry.g.cs</_ClojureEntryFile>
      <_ClojureEntryNsFile>$(_ClojureGenDir)clojure/msbuild/entry.cljr</_ClojureEntryNsFile>
      <_ClojureFileList>$(IntermediateOutputPath)ClojureBuild.FileList.txt</_ClojureFileList>
      <!-- Library layer: precompiled clojure.core, standard library and dependencies, kept between builds -->
      <_ClojureLibDir>$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)', '$(IntermediateOutputPath)', 'clj-lib'))</_ClojureLibDir>
      <_ClojureLibFileList>$(IntermediateOutputPath)ClojureLibs.FileList.txt</_ClojureLibFileList>
      <_ClojureLibStampFile>$(IntermediateOutputPath)ClojureLibs.stamp</_ClojureLibStampFile>
      <_ClojureBuildStampFile>$(IntermediateOutputPath)ClojureBuild.stamp</_ClojureBuildStampFile>
      <_ClojureSourceListFile>$(IntermediateOutputPath)ClojureSources.txt</_ClojureSourceListFile>
      <_ClojureTestConfigFile>$(TargetDir)$(TargetName).clojure.edn</_ClojureTestConfigFile>
      <_ClojureEntryExe>$(_ClojureBuildDir)$(AssemblyName).exe</_ClojureEntryExe>
      <_ClojureGenClassMode>false</_ClojureGenClassMode>
      <_ClojureGenClassMode Condition="'$(ClojureEntryPoint)' == 'gen-class'">true</_ClojureGenClassMode>
      <_ClojureNamespacesToBuild>clojure.msbuild.entry;$(ClojureMainNamespace);$(ClojureNamespacesToCompile)</_ClojureNamespacesToBuild>
      <!-- Namespaces whose source lives in these directories are project code -->
      <_ClojureProjectDirs>$(ClojureSourceDir)|$(ClojureExtraSourceDirs)|test|$(_ClojureGenDir)</_ClojureProjectDirs>
      <_ClojureCompileOutputs>$(_ClojureBuildStampFile)</_ClojureCompileOutputs>
      <_ClojureCompileOutputs Condition="'$(_ClojureGenClassMode)' == 'true'">$(_ClojureBuildStampFile);$(_ClojureEntryExe)</_ClojureCompileOutputs>
    </PropertyGroup>
  </Target>

  <!-- The generated host (or the gen-class Main) is the entry point. Microsoft.NET.Test.Sdk
       would add a Program with a second one (warning CS7022). Its target reads the final
       value, so setting it here wins although its targets are imported first. -->
  <PropertyGroup Condition="'$(ClojureMainNamespace)' != ''">
    <GenerateProgramFile>false</GenerateProgramFile>
  </PropertyGroup>

  <!-- Build a Clojure deps map from ClojureGitDep items -->
  <Target Name="_BuildClojureGitDeps">
    <PropertyGroup>
      <_ClojureGitDeps>nil</_ClojureGitDeps>
      <_ClojureGitDeps Condition="@(ClojureGitDep->Count()) > 0">{:deps {@(ClojureGitDep->'%(Identity) {:git/tag "%(Tag)" :git/sha "%(Sha)" :git/url "%(Url)"}', ' ')}}</_ClojureGitDeps>
    </PropertyGroup>
  </Target>

  <!-- gen-class mode replaces the project assembly, so the project cannot contain C# of its own -->
  <Target Name="_ClojureValidateEntryPoint" DependsOnTargets="_ClojureInit" Condition="'$(ClojureMainNamespace)' != ''">
    <Error Condition="'$(ClojureEntryPoint)' != 'gen-class' And '$(ClojureEntryPoint)' != 'csharp'"
           Text="ClojureEntryPoint must be 'gen-class' or 'csharp' (got '$(ClojureEntryPoint)')." />
    <Error Condition="'$(_ClojureGenClassMode)' == 'true' And !$([System.Text.RegularExpressions.Regex]::IsMatch('$(AssemblyName)', '^[A-Za-z_][A-Za-z0-9_]*(\.[A-Za-z_][A-Za-z0-9_]*)*$'))"
           Text="AssemblyName '$(AssemblyName)' is not a valid .NET type name. In gen-class entry-point mode the assembly name is used as the name of the generated entry class. Set &lt;AssemblyName&gt; to letters, digits, '_' and '.' only, or set &lt;ClojureEntryPoint&gt;csharp&lt;/ClojureEntryPoint&gt;." />
    <ItemGroup Condition="'$(_ClojureGenClassMode)' == 'true'">
      <_ClojureUserCompile Include="@(Compile)" Exclude="$(GeneratedProgramFile)"
                           Condition="!$([MSBuild]::NormalizePath('%(Compile.FullPath)').StartsWith($([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)', '$(BaseIntermediateOutputPath)'))))" />
    </ItemGroup>
    <Error Condition="'$(_ClojureGenClassMode)' == 'true' And '@(_ClojureUserCompile)' != ''"
           Text="C# sources (@(_ClojureUserCompile, ', ')) cannot be compiled into a Clojure project with ClojureEntryPoint=gen-class, because the project assembly is replaced by the compiled Clojure entry point. Move the C# into a class library project, or set &lt;ClojureEntryPoint&gt;csharp&lt;/ClojureEntryPoint&gt;." />
  </Target>

  <!-- Generate the C# host and the clojure.msbuild.entry namespace.
       The C# host is compiled by the SDK as usual; it bootstraps Clojure and calls
       clojure.msbuild.entry/-main. In gen-class mode the host only lives long enough
       to AOT-compile the project: ClojureBuild then replaces the project assembly with
       the compiled entry point whose Main is generated by gen-class. -->
  <Target Name="GenerateClojureEntryPoint" BeforeTargets="CoreCompile"
          Condition="'$(ClojureMainNamespace)' != ''"
          DependsOnTargets="_ClojureInit;_ClojureValidateEntryPoint;_BuildClojureGitDeps">
    <PropertyGroup>
      <_ClojureEntrySource>
using System%3B
using System.IO%3B
using System.Threading.Tasks%3B

// Generated by Clojure.MSBuild. Bootstraps the Clojure runtime and hands off to clojure.msbuild.entry/-main.
{
    var generated = @"$(_ClojureGenDir)"%3B
    var packageSrc = @"$(ClojureMSBuildSourceDir)"%3B
    var existing = Environment.GetEnvironmentVariable("CLOJURE_LOAD_PATH")%3B
    var paths = string.Join(Path.PathSeparator.ToString(), new[] { generated, packageSrc })%3B
    Environment.SetEnvironmentVariable("CLOJURE_LOAD_PATH", string.IsNullOrEmpty(existing) ? paths : existing + Path.PathSeparator + paths)%3B
}
// The library layer reloads clojure.spec.alpha while compiling it, which only works with
// macro spec checking off. Set here rather than by the caller: /bin/sh drops the dotted name.
if (args.Length > 1 &amp;&amp; args[0] == "--clj-mode" &amp;&amp; args[1] == "build-libs")
    Environment.SetEnvironmentVariable("clojure.spec.skip-macros", "true")%3B
clojure.lang.RT.Init()%3B
clojure.lang.RT.var("clojure.core", "require").invoke(clojure.lang.Symbol.intern("clojure.msbuild.entry"))%3B
var result = clojure.lang.RT.var("clojure.msbuild.entry", "-main").applyTo(clojure.lang.RT.seq(args))%3B
if (result is Task task) task.GetAwaiter().GetResult()%3B
      </_ClojureEntrySource>

      <_ClojureGenClassClause Condition="'$(_ClojureGenClassMode)' == 'true'">(:gen-class :name $(AssemblyName) :main true)</_ClojureGenClassClause>
      <_ClojureEntryNsSource>
(ns clojure.msbuild.entry
  "Generated by Clojure.MSBuild. Do not edit."
  $(_ClojureGenClassClause)
  (:require [clojure.msbuild.bootstrap :as bootstrap]))

(def config
  {:main-ns (quote $(ClojureMainNamespace))
   :source-dir "$(ClojureSourceDir.Replace('\', '\\'))"
   :extra-source-dirs "$(ClojureExtraSourceDirs.Replace('\', '\\'))"
   :msbuild-source-dir "$(ClojureMSBuildSourceDir.Replace('\', '\\'))"
   :git-deps (quote $(_ClojureGitDeps))})

(defn -main [&amp; args]
  (bootstrap/run config args))
      </_ClojureEntryNsSource>
    </PropertyGroup>

    <MakeDir Directories="$(_ClojureGenDir)clojure/msbuild" />
    <WriteLinesToFile File="$(_ClojureEntryFile)" Lines="$(_ClojureEntrySource)" Overwrite="true" WriteOnlyWhenDifferent="true" />
    <WriteLinesToFile File="$(_ClojureEntryNsFile)" Lines="$(_ClojureEntryNsSource)" Overwrite="true" WriteOnlyWhenDifferent="true" />
    <ItemGroup>
      <Compile Include="$(_ClojureEntryFile)" />
      <FileWrites Include="$(_ClojureEntryFile);$(_ClojureEntryNsFile)" />
    </ItemGroup>
  </Target>

  <!-- AOT compile the project after the SDK has produced the runnable host in the output
       directory, then copy the compiled assemblies next to it. In gen-class mode the
       compiled entry point replaces the project assembly, so `dotnet run`, the apphost
       and `dotnet MyApp.dll` all start at the gen-class Main.

       Clojure is compiled in two layers. ClojureCLR ships clojure.core, the standard
       library and NuGet Clojure libraries as source and compiles them at every process
       start (about 12 s of runtime init), so the library layer precompiles them once,
       together with git dependencies and the Clojure.MSBuild tooling, into clj-lib. It
       is rebuilt only when the dependencies (project.assets.json), the generated entry
       namespace (git deps, main namespace), deps.edn or Clojure.MSBuild itself change.
       The build layer (clj-out) holds the project's own namespaces. It only runs when a
       Clojure source file, the project file or the library layer changed, and then only
       compiles the namespaces that changed and the namespaces that depend on them.
       The copy step runs on every build: the SDK copies the C# host over the output
       assembly on each build, and the host is what compiles the project. -->
  <Target Name="ClojureBuild" AfterTargets="Build" Condition="'$(ClojureMainNamespace)' != ''"
          DependsOnTargets="_ClojureInit;_ClojureLibLayer;_ClojureCompile;_ClojureCopyOutput" />

  <!-- Where the library layer lives and how it is compiled. The part of the library layer
       that depends only on the Clojure and Clojure.MSBuild versions (clojure.core, the
       standard library, the tooling) is shared between projects through ClojureLibCacheDir.
       The layer is ReadyToRun compiled (native code, so processes start without JIT) with
       the crossgen2 that matches the target framework, when the application runs on the
       platform that builds it. -->
  <Target Name="_ClojureResolveLayers" DependsOnTargets="_ClojureInit">
    <PropertyGroup>
      <_ClojureTargetFrameworkForPacks>net$(TargetFrameworkVersion.TrimStart('v'))</_ClojureTargetFrameworkForPacks>
      <_ClojureHostRid>$(NETCoreSdkPortableRuntimeIdentifier)</_ClojureHostRid>
      <_ClojureHostRid Condition="'$(_ClojureHostRid)' == ''">$(NETCoreSdkRuntimeIdentifier)</_ClojureHostRid>
      <_ClojureExeSuffix Condition="$([MSBuild]::IsOSPlatform('Windows'))">.exe</_ClojureExeSuffix>
    </PropertyGroup>
    <ItemGroup>
      <_ClojureRuntimePackage Include="@(ReferencePath)" Condition="'%(ReferencePath.NuGetPackageId)' == 'Clojure' Or '%(ReferencePath.NuGetPackageId)' == 'clojure.spec.alpha' Or '%(ReferencePath.NuGetPackageId)' == 'clojure.core.specs.alpha'" />
      <_ClojureIlRuntime Include="@(ReferencePath)" Condition="'%(ReferencePath.NuGetPackageId)' == 'Clojure' And '%(Filename)%(Extension)' == 'Clojure.dll'" />
      <_ClojureCrossgen2Pack Include="@(KnownCrossgen2Pack)" Condition="'%(KnownCrossgen2Pack.TargetFramework)' == '$(_ClojureTargetFrameworkForPacks)'" />
    </ItemGroup>
    <PropertyGroup>
      <_ClojureCrossgenVersion>@(_ClojureCrossgen2Pack->'%(Crossgen2PackVersion)'->Distinct())</_ClojureCrossgenVersion>
      <_ClojureReadyToRun>false</_ClojureReadyToRun>
      <_ClojureReadyToRun Condition="'$(ClojureReadyToRun)' != 'false' And '$(TargetFrameworkIdentifier)' == '.NETCoreApp' And '$(_ClojureCrossgenVersion)' != '' And '$(_ClojureHostRid)' != '' And ('$(RuntimeIdentifier)' == '' Or '$(RuntimeIdentifier)' == '$(_ClojureHostRid)' Or '$(RuntimeIdentifier)' == '$(NETCoreSdkRuntimeIdentifier)')">true</_ClojureReadyToRun>
      <_ClojureCrossgenPackage>microsoft.netcore.app.crossgen2.$(_ClojureHostRid.ToLowerInvariant())</_ClojureCrossgenPackage>
      <_ClojureCrossgenPath Condition="'$(_ClojureReadyToRun)' == 'true'">$([MSBuild]::EnsureTrailingSlash('$(NuGetPackageRoot)'))$(_ClojureCrossgenPackage)/$(_ClojureCrossgenVersion)/tools/crossgen2$(_ClojureExeSuffix)</_ClojureCrossgenPath>
      <_ClojureLayerMode>il</_ClojureLayerMode>
      <_ClojureLayerMode Condition="'$(_ClojureReadyToRun)' == 'true'">r2r-$(_ClojureHostRid)</_ClojureLayerMode>
      <_ClojureSharedLibDir Condition="'$(ClojureLibCache)' != 'false'">$([MSBuild]::EnsureTrailingSlash('$(ClojureLibCacheDir)'))@(_ClojureRuntimePackage->'%(NuGetPackageId)-%(NuGetPackageVersion)'->Distinct(), '_')_$(TargetFramework)_$(_ClojureLayerMode)_$([MSBuild]::StableStringHash('$(MSBuildThisFileDirectory)|$([System.IO.File]::GetLastWriteTimeUtc('$(MSBuildThisFileFullPath)').Ticks)'))/</_ClojureSharedLibDir>
      <!-- The ReadyToRun Clojure.dll, used instead of the package's once it exists -->
      <_ClojureRuntimeDir>$(_ClojureLibDir)runtime/</_ClojureRuntimeDir>
      <_ClojureRuntimeDir Condition="'$(_ClojureSharedLibDir)' != ''">$(_ClojureSharedLibDir)runtime/</_ClojureRuntimeDir>
    </PropertyGroup>
  </Target>

  <!-- Is the library layer up to date? -->
  <Target Name="_ClojureLibLayerState" DependsOnTargets="_ClojureResolveLayers">
    <PropertyGroup>
      <_ClojureSharedLibReady>false</_ClojureSharedLibReady>
      <_ClojureSharedLibReady Condition="'$(_ClojureSharedLibDir)' != '' And Exists('$(_ClojureSharedLibDir)complete')">true</_ClojureSharedLibReady>
      <_ClojureLibStamp>$(MSBuildThisFileDirectory)|$([System.IO.File]::GetLastWriteTimeUtc('$(MSBuildThisFileFullPath)').Ticks)|$(_ClojureLayerMode)|$([System.IO.File]::GetLastWriteTimeUtc('$(ProjectAssetsFile)').Ticks)|$([System.IO.File]::GetLastWriteTimeUtc('$(_ClojureEntryNsFile)').Ticks)|$([System.IO.File]::GetLastWriteTimeUtc('$(MSBuildProjectDirectory)/deps.edn').Ticks)|$([System.IO.File]::GetLastWriteTimeUtc('$(MSBuildProjectDirectory)/deps-clr.edn').Ticks)</_ClojureLibStamp>
    </PropertyGroup>
    <ReadLinesFromFile File="$(_ClojureLibStampFile)" Condition="Exists('$(_ClojureLibStampFile)')">
      <Output TaskParameter="Lines" PropertyName="_ClojurePreviousLibStamp" />
    </ReadLinesFromFile>
    <PropertyGroup>
      <_ClojureLibsUpToDate>false</_ClojureLibsUpToDate>
      <_ClojureLibsUpToDate Condition="'$(_ClojurePreviousLibStamp)' == '$(_ClojureLibStamp)' And Exists('$(_ClojureLibDir)')">true</_ClojureLibsUpToDate>
    </PropertyGroup>
  </Target>

  <!-- crossgen2 comes from a NuGet package that nothing references. Restore it with a
       generated project when the library layer is about to be built and it is missing.
       Without it (e.g. offline) the layer stays IL and this is tried again next time. -->
  <Target Name="_ClojureAcquireCrossgen" DependsOnTargets="_ClojureLibLayerState"
          Condition="'$(_ClojureReadyToRun)' == 'true' And '$(_ClojureLibsUpToDate)' != 'true' And !Exists('$(_ClojureCrossgenPath)')">
    <PropertyGroup>
      <_ClojureCrossgenProject>$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)', '$(IntermediateOutputPath)', 'clj-crossgen'))crossgen.csproj</_ClojureCrossgenProject>
      <_ClojureCrossgenProjectSource>
&lt;Project Sdk="Microsoft.NET.Sdk"&gt;
  &lt;!-- Generated by Clojure.MSBuild to download crossgen2 --&gt;
  &lt;PropertyGroup&gt;
    &lt;TargetFramework&gt;$(_ClojureTargetFrameworkForPacks)&lt;/TargetFramework&gt;
    &lt;ManagePackageVersionsCentrally&gt;false&lt;/ManagePackageVersionsCentrally&gt;
  &lt;/PropertyGroup&gt;
  &lt;ItemGroup&gt;
    &lt;PackageDownload Include="$(_ClojureCrossgenPackage)" Version="[$(_ClojureCrossgenVersion)]" /&gt;
  &lt;/ItemGroup&gt;
&lt;/Project&gt;
      </_ClojureCrossgenProjectSource>
    </PropertyGroup>
    <Message Importance="high" Text="Downloading crossgen2 ($(_ClojureCrossgenPackage) $(_ClojureCrossgenVersion)) to compile the Clojure library layer to native code" />
    <WriteLinesToFile File="$(_ClojureCrossgenProject)" Lines="$(_ClojureCrossgenProjectSource)" Overwrite="true" />
    <Exec Command="&quot;$(DOTNET_HOST_PATH)&quot; restore &quot;$(_ClojureCrossgenProject)&quot; -nologo -v q &quot;-p:RestorePackagesPath=$(NuGetPackageRoot.TrimEnd('/').TrimEnd('\'))&quot; -p:ImportDirectoryBuildProps=false -p:ImportDirectoryBuildTargets=false -p:ImportDirectoryPackagesProps=false"
          WorkingDirectory="$(MSBuildProjectDirectory)" ContinueOnError="true" />
  </Target>

  <Target Name="_ClojureLibLayer" DependsOnTargets="_ClojureInit;_ClojureResolveLayers;_ClojureLibLayerState;_ClojureAcquireCrossgen">
    <!-- A new library layer means a new build layer: remove both from the output and from
         obj first. Stale library assemblies would shadow the new versions of their
         sources, and project assemblies compiled against the old libraries must not be
         loaded by the host. -->
    <ReadLinesFromFile File="$(_ClojureFileList)" Condition="'$(_ClojureLibsUpToDate)' != 'true' And Exists('$(_ClojureFileList)')">
      <Output TaskParameter="Lines" ItemName="_ClojurePreviousLayerFile" />
    </ReadLinesFromFile>
    <ReadLinesFromFile File="$(_ClojureLibFileList)" Condition="'$(_ClojureLibsUpToDate)' != 'true' And Exists('$(_ClojureLibFileList)')">
      <Output TaskParameter="Lines" ItemName="_ClojurePreviousLayerFile" />
    </ReadLinesFromFile>
    <Delete Condition="'$(_ClojureLibsUpToDate)' != 'true'" Files="@(_ClojurePreviousLayerFile);$(_ClojureLibStampFile);$(_ClojureBuildStampFile)" ContinueOnError="true" />
    <RemoveDir Condition="'$(_ClojureLibsUpToDate)' != 'true'" Directories="$(_ClojureLibDir);$(_ClojureBuildDir)" />

    <!-- Library layer (once per dependency change). Failures only cost startup time, so
         they do not fail the build; the stamp is written regardless so the pass is not
         repeated on every build. `dotnet clean` removes the layer. -->
    <Message Condition="'$(_ClojureLibsUpToDate)' != 'true'" Importance="high"
             Text="Compiling the Clojure library layer (clojure.core, standard library, dependencies). This runs once per dependency change and takes a while." />
    <ItemGroup Condition="'$(_ClojureLibsUpToDate)' != 'true' And '$(_ClojureSharedLibReady)' == 'true'">
      <_ClojureSharedLibFile Include="$(_ClojureSharedLibDir)*.dll;$(_ClojureSharedLibDir)*.pdb" />
    </ItemGroup>
    <Message Condition="'$(_ClojureLibsUpToDate)' != 'true' And '$(_ClojureSharedLibReady)' == 'true'" Importance="high"
             Text="Using the shared Clojure runtime layer from $(_ClojureSharedLibDir)" />
    <Copy Condition="'$(_ClojureLibsUpToDate)' != 'true' And '$(_ClojureSharedLibReady)' == 'true'" SourceFiles="@(_ClojureSharedLibFile)" DestinationFolder="$(_ClojureLibDir)" />
    <Copy Condition="'$(_ClojureLibsUpToDate)' != 'true' And '$(_ClojureSharedLibReady)' == 'true'" SourceFiles="@(_ClojureSharedLibFile)" DestinationFolder="$(TargetDir)" />
    <Exec Condition="'$(_ClojureLibsUpToDate)' != 'true'"
          Command="&quot;$(DOTNET_HOST_PATH)&quot; &quot;$(TargetPath)&quot; --clj-mode build-libs &quot;$(_ClojureLibDir)&quot; &quot;$(ClojureMainNamespace)&quot; &quot;$(_ClojureProjectDirs)&quot; &quot;$(_ClojureSharedLibDir)&quot; &quot;$(_ClojureCrossgenPath)&quot; &quot;@(_ClojureIlRuntime)&quot;"
          WorkingDirectory="$(MSBuildProjectDirectory)"
          ConsoleToMSBuild="false" ContinueOnError="true" />
    <WriteLinesToFile Condition="'$(_ClojureLibsUpToDate)' != 'true'" File="$(_ClojureLibStampFile)" Lines="$(_ClojureLibStamp)" Overwrite="true" />
    <!-- The host compiling the build layer starts from the precompiled libraries -->
    <ItemGroup>
      <_ClojureLibLayerFile Include="$(_ClojureLibDir)*.dll;$(_ClojureLibDir)*.pdb" />
    </ItemGroup>
    <Copy SourceFiles="@(_ClojureLibLayerFile)" DestinationFolder="$(TargetDir)" SkipUnchangedFiles="true" />
    <Copy Condition="'$(_ClojureReadyToRun)' == 'true' And Exists('$(_ClojureRuntimeDir)Clojure.dll')"
          SourceFiles="$(_ClojureRuntimeDir)Clojure.dll" DestinationFolder="$(TargetDir)" SkipUnchangedFiles="true" />
  </Target>

  <!-- Copy the ReadyToRun Clojure runtime instead of the package's IL assembly once it
       exists. Swapping the copy-local item (rather than copying over it afterwards) keeps
       the SDK from writing the file again on every build. It has to run before
       _CopyFilesMarkedCopyLocal itself: that is a dependency of CopyFilesToOutputDirectory,
       so it runs before that target's BeforeTargets hooks. -->
  <Target Name="_ClojureUseReadyToRunRuntime" BeforeTargets="_CopyFilesMarkedCopyLocal"
          DependsOnTargets="_ClojureResolveLayers" Condition="'$(ClojureMainNamespace)' != ''">
    <ItemGroup Condition="'$(_ClojureReadyToRun)' == 'true' And Exists('$(_ClojureRuntimeDir)Clojure.dll')">
      <_ClojureIlRuntimeCopy Include="@(ReferenceCopyLocalPaths)" Condition="'%(ReferenceCopyLocalPaths.NuGetPackageId)' == 'Clojure' And '%(ReferenceCopyLocalPaths.Filename)%(ReferenceCopyLocalPaths.Extension)' == 'Clojure.dll'" />
      <ReferenceCopyLocalPaths Remove="@(_ClojureIlRuntimeCopy)" />
      <ReferenceCopyLocalPaths Include="@(_ClojureIlRuntimeCopy->'$(_ClojureRuntimeDir)Clojure.dll')" />
    </ItemGroup>
  </Target>

  <!-- The Clojure sources of the build layer; the list itself is an input too, so that
       deleting, renaming or restoring an older copy of a file also rebuilds. -->
  <Target Name="_ClojureCollectSources" DependsOnTargets="_ClojureInit">
    <PropertyGroup>
      <_ClojureSourceDirs>$(ClojureSourceDir)|$(ClojureExtraSourceDirs)</_ClojureSourceDirs>
      <_ClojureSourceDirs>$([System.Text.RegularExpressions.Regex]::Replace('$(_ClojureSourceDirs)', '\|\s*(?=\||$)|^\s*\|', ''))</_ClojureSourceDirs>
      <_ClojureSourceDirs>$(_ClojureSourceDirs.Trim('|'))</_ClojureSourceDirs>
      <_ClojureSourceGlobs Condition="'$(_ClojureSourceDirs)' != ''">$(_ClojureSourceDirs.Replace('|', '/**/*.cljr;'))/**/*.cljr;$(_ClojureSourceDirs.Replace('|', '/**/*.cljc;'))/**/*.cljc;$(_ClojureSourceDirs.Replace('|', '/**/*.clj;'))/**/*.clj</_ClojureSourceGlobs>
    </PropertyGroup>
    <ItemGroup>
      <_ClojureSourceFile Include="$([MSBuild]::Unescape($(_ClojureSourceGlobs)))" />
    </ItemGroup>
    <!-- With the timestamps: a file that gets an older one (cp -p, rsync -a) changed too -->
    <WriteLinesToFile File="$(_ClojureSourceListFile)" Lines="@(_ClojureSourceFile->'%(FullPath)|%(ModifiedTime)')" Overwrite="true" WriteOnlyWhenDifferent="true" />
  </Target>

  <!-- Build layer: skipped when no input changed. The tool compiles only the namespaces
       whose source changed and the namespaces that depend on them. -->
  <Target Name="_ClojureCompile" DependsOnTargets="_ClojureInit;_ClojureCollectSources"
          Inputs="@(_ClojureSourceFile);$(_ClojureSourceListFile);$(_ClojureEntryNsFile);$(_ClojureLibStampFile);$(MSBuildThisFileFullPath);$(MSBuildProjectFullPath)"
          Outputs="$(_ClojureCompileOutputs)">
    <!-- The host loads clojure.msbuild.entry from source: a compiled entry assembly refers
         to the gen-class type, which the C# host (same assembly name) does not contain. -->
    <Delete Files="$(TargetDir)clojure.msbuild.entry.cljr.dll;$(TargetDir)clojure.msbuild.entry.cljr.pdb" ContinueOnError="true" />
    <MakeDir Directories="$(_ClojureBuildDir)" />
    <Exec Command="&quot;$(DOTNET_HOST_PATH)&quot; &quot;$(TargetPath)&quot; --clj-mode build &quot;$(_ClojureNamespacesToBuild)&quot; &quot;$(_ClojureBuildDir)&quot; &quot;$(_ClojureLibDir)&quot; &quot;$(_ClojureProjectDirs)&quot;"
          WorkingDirectory="$(MSBuildProjectDirectory)"
          ConsoleToMSBuild="false" />
    <Error Condition="'$(_ClojureGenClassMode)' == 'true' And !Exists('$(_ClojureEntryExe)')"
           Text="Clojure compilation did not produce the entry point assembly $(_ClojureEntryExe)." />
    <Touch Files="$(_ClojureBuildStampFile)" AlwaysCreate="true" />
  </Target>

  <!-- Copy both layers next to the host and the entry point over it (every build) -->
  <Target Name="_ClojureCopyOutput" DependsOnTargets="_ClojureInit">
    <ItemGroup>
      <_ClojureLibDll Include="$(_ClojureLibDir)*.dll" />
      <_ClojureLibPdb Include="$(_ClojureLibDir)*.pdb" />
      <_ClojureCompiledDll Include="$(_ClojureBuildDir)*.dll" />
      <_ClojureCompiledPdb Include="$(_ClojureBuildDir)*.pdb" />
      <_ClojureOutputFile Include="@(_ClojureCompiledDll->'$(TargetDir)%(Filename)%(Extension)')" />
      <_ClojureOutputFile Include="@(_ClojureCompiledPdb->'$(TargetDir)%(Filename)%(Extension)')" />
      <_ClojureLibOutputFile Include="@(_ClojureLibDll->'$(TargetDir)%(Filename)%(Extension)')" />
      <_ClojureLibOutputFile Include="@(_ClojureLibPdb->'$(TargetDir)%(Filename)%(Extension)')" />
    </ItemGroup>
    <!-- Remove what the previous build copied that neither layer contains any more -->
    <ReadLinesFromFile File="$(_ClojureFileList)" Condition="Exists('$(_ClojureFileList)')">
      <Output TaskParameter="Lines" ItemName="_ClojurePreviousOutputFile" />
    </ReadLinesFromFile>
    <ReadLinesFromFile File="$(_ClojureLibFileList)" Condition="Exists('$(_ClojureLibFileList)')">
      <Output TaskParameter="Lines" ItemName="_ClojurePreviousOutputFile" />
    </ReadLinesFromFile>
    <ItemGroup>
      <_ClojureRemovedOutputFile Include="@(_ClojurePreviousOutputFile)" Exclude="@(_ClojureOutputFile);@(_ClojureLibOutputFile)" />
    </ItemGroup>
    <Delete Files="@(_ClojureRemovedOutputFile)" ContinueOnError="true" />
    <WriteLinesToFile File="$(_ClojureFileList)" Lines="@(_ClojureOutputFile)" Overwrite="true" WriteOnlyWhenDifferent="true" />
    <WriteLinesToFile File="$(_ClojureLibFileList)" Lines="@(_ClojureLibOutputFile)" Overwrite="true" WriteOnlyWhenDifferent="true" />
    <Copy SourceFiles="@(_ClojureLibDll);@(_ClojureLibPdb);@(_ClojureCompiledDll);@(_ClojureCompiledPdb)" DestinationFolder="$(TargetDir)" SkipUnchangedFiles="true" />
    <Copy Condition="'$(_ClojureGenClassMode)' == 'true'" SourceFiles="$(_ClojureEntryExe)" DestinationFiles="$(TargetPath)" />
    <Message Condition="'$(_ClojureGenClassMode)' == 'true'" Text="Clojure entry point $(AssemblyName).Main -> $(TargetPath)" Importance="high" />
    <!-- Tells Clojure.MSBuild.TestAdapter where the project and its tests are -->
    <WriteLinesToFile Condition="Exists('$(MSBuildProjectDirectory)/test')" File="$(_ClojureTestConfigFile)"
                      Lines="{:project-dir &quot;$(MSBuildProjectDirectory.Replace('\', '\\'))&quot; :test-dir &quot;test&quot;}"
                      Overwrite="true" WriteOnlyWhenDifferent="true" />
  </Target>

  <Target Name="ClojureClean" AfterTargets="CoreClean" DependsOnTargets="_ClojureInit">
    <ReadLinesFromFile File="$(_ClojureFileList)" Condition="Exists('$(_ClojureFileList)')">
      <Output TaskParameter="Lines" ItemName="_ClojurePreviousOutputFile" />
    </ReadLinesFromFile>
    <ReadLinesFromFile File="$(_ClojureLibFileList)" Condition="Exists('$(_ClojureLibFileList)')">
      <Output TaskParameter="Lines" ItemName="_ClojurePreviousOutputFile" />
    </ReadLinesFromFile>
    <Delete Files="@(_ClojurePreviousOutputFile);$(_ClojureFileList);$(_ClojureLibFileList);$(_ClojureLibStampFile);$(_ClojureBuildStampFile);$(_ClojureSourceListFile);$(_ClojureTestConfigFile)" ContinueOnError="true" />
    <RemoveDir Directories="$(_ClojureBuildDir);$(_ClojureLibDir);$(_ClojureGenDir);$(IntermediateOutputPath)clj-crossgen" ContinueOnError="true" />
  </Target>

  <!-- Publish the compiled Clojure assemblies (and the gen-class entry point) instead of the C# host -->
  <Target Name="_ClojureAddPublishFiles" AfterTargets="ComputeResolvedFilesToPublishList"
          DependsOnTargets="_ClojureInit;_ClojureResolveLayers;ClojureBuild" Condition="'$(ClojureMainNamespace)' != ''">
    <ItemGroup>
      <ResolvedFileToPublish Condition="'$(_ClojureGenClassMode)' == 'true'" Remove="@(IntermediateAssembly)" />
      <ResolvedFileToPublish Condition="'$(_ClojureGenClassMode)' == 'true'" Include="$(_ClojureEntryExe)">
        <RelativePath>$(TargetFileName)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
      <ResolvedFileToPublish Include="@(_ClojureLibDll);@(_ClojureLibPdb);@(_ClojureCompiledDll);@(_ClojureCompiledPdb)">
        <RelativePath>%(Filename)%(Extension)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
    </ItemGroup>
    <ItemGroup Condition="'$(_ClojureReadyToRun)' == 'true' And Exists('$(_ClojureRuntimeDir)Clojure.dll')">
      <_ClojurePublishedIlRuntime Include="@(ResolvedFileToPublish)" Condition="'%(ResolvedFileToPublish.RelativePath)' == 'Clojure.dll'" />
      <ResolvedFileToPublish Remove="@(_ClojurePublishedIlRuntime)" />
      <ResolvedFileToPublish Include="@(_ClojurePublishedIlRuntime->'$(_ClojureRuntimeDir)Clojure.dll')" />
    </ItemGroup>
  </Target>

  <!-- Target to run Clojure REPL with all dependencies loaded -->
  <Target Name="clj-repl" DependsOnTargets="Build">
    <Message Text="Starting Clojure REPL with project dependencies..." Importance="high" />
    <Exec Command="&quot;$(DOTNET_HOST_PATH)&quot; &quot;$(TargetPath)&quot; --clj-mode repl"
          WorkingDirectory="$(MSBuildProjectDirectory)"
          ConsoleToMSBuild="false" />
  </Target>

  <!-- Target to run Clojure nREPL server: -p:ClojureNReplPort=7888 (0 = any free port).
       The port is written to .nrepl-port for editors. -->
  <Target Name="clj-nrepl" DependsOnTargets="Build">
    <Message Text="Starting Clojure nREPL server..." Importance="high" />
    <Exec Command="&quot;$(DOTNET_HOST_PATH)&quot; &quot;$(TargetPath)&quot; --clj-mode nrepl $(ClojureNReplPort)"
          WorkingDirectory="$(MSBuildProjectDirectory)"
          ConsoleToMSBuild="false" />
  </Target>

  <!-- Target to run a Clojure file -->
  <Target Name="clj-run" DependsOnTargets="Build">
    <Error Text="Please provide a file path using -p:File=path/to/file.clj"
           Condition="'$(File)' == ''" />
    <Message Text="Running Clojure file: $(File)" Importance="high" />
    <Exec Command="&quot;$(DOTNET_HOST_PATH)&quot; &quot;$(TargetPath)&quot; --clj-mode script &quot;$(File)&quot;"
          WorkingDirectory="$(MSBuildProjectDirectory)"
          ConsoleToMSBuild="false" />
  </Target>

  <!-- Run the Clojure tests without VSTest: dotnet msbuild /t:clj-test
       -p:ClojureTests="my.app-test my.app-test/one-test" selects namespaces and tests. -->
  <Target Name="clj-test" DependsOnTargets="Build">
    <Exec Command="&quot;$(DOTNET_HOST_PATH)&quot; &quot;$(TargetPath)&quot; --clj-mode test $(ClojureTests)"
          WorkingDirectory="$(MSBuildProjectDirectory)"
          EnvironmentVariables="CLOJURE_MSBUILD_TEST_FORMAT=none"
          ConsoleToMSBuild="false" IgnoreExitCode="true">
      <Output TaskParameter="ExitCode" PropertyName="_ClojureTestExitCode" />
    </Exec>
    <Error Condition="'$(_ClojureTestExitCode)' != '0'" Text="Clojure tests failed" />
  </Target>

  <Target Name="ClojureTest" DependsOnTargets="clj-test" />

  <!-- Run the tests, then again whenever a Clojure file changes, reloading only what
       changed and what depends on it: dotnet msbuild /t:clj-test-watch -->
  <Target Name="clj-test-watch" DependsOnTargets="Build">
    <Exec Command="&quot;$(DOTNET_HOST_PATH)&quot; &quot;$(TargetPath)&quot; --clj-mode test-watch &quot;$(ClojureSourceDir)|$(ClojureExtraSourceDirs)&quot;"
          WorkingDirectory="$(MSBuildProjectDirectory)"
          StandardOutputImportance="high"
          ConsoleToMSBuild="false" />
  </Target>

</Project>
