<Project>
  <PropertyGroup>
    <!-- ClojureCLR's runtime (Clojure.dll for net11.0) is marked as using preview
         features (runtime async), so the generated host needs them on. -->
    <EnablePreviewFeatures Condition="'$(EnablePreviewFeatures)' == ''">true</EnablePreviewFeatures>

    <!-- The ClojureCLR version this release of Clojure.MSBuild supports. The tooling and
         Clojure.MSBuild.TestAdapter are compiled against it, and the build fails when the
         project references another version of the Clojure package. -->
    <ClojureSupportedVersion>1.13.0-alpha8</ClojureSupportedVersion>

    <!-- Load every assembly next to the application at startup, so that `require` and
         `import` find NuGet-packaged Clojure libraries and .NET types. Set to false to
         load what the application uses itself (assembly-load); tooling always does it. -->
    <ClojureAutoLoadAssemblies Condition="'$(ClojureAutoLoadAssemblies)' == ''">true</ClojureAutoLoadAssemblies>

    <!-- Main namespace — set this in your csproj. Its -main becomes the application entry point. -->
    <ClojureMainNamespace Condition="'$(ClojureMainNamespace)' == ''"></ClojureMainNamespace>

    <!-- Entry point style:
           gen-class  (default) dotnet build AOT-compiles the project and replaces the
                      project assembly with one whose entry point is a gen-class Main.
                      The project cannot contain C# sources in this mode.
           csharp     keep a generated C# Main as the entry point (needed when the
                      project also compiles C# files). Clojure is still AOT-compiled. -->
    <ClojureEntryPoint Condition="'$(ClojureEntryPoint)' == ''">gen-class</ClojureEntryPoint>

    <!-- Source directory for Clojure files (added to CLOJURE_LOAD_PATH) -->
    <ClojureSourceDir Condition="'$(ClojureSourceDir)' == ''">src</ClojureSourceDir>

    <!-- Extra source directories, separated by ; or | (or use ClojureSource items) -->
    <ClojureExtraSourceDirs Condition="'$(ClojureExtraSourceDirs)' == ''"></ClojureExtraSourceDirs>

    <!-- Test directory, and the suffix of test file names (my/app_test.cljr) -->
    <ClojureTestDir Condition="'$(ClojureTestDir)' == ''">test</ClojureTestDir>
    <ClojureTestSuffix Condition="'$(ClojureTestSuffix)' == ''">_test</ClojureTestSuffix>

    <!-- deps.edn aliases whose :extra-deps and :extra-paths are used (separated by ;) -->
    <ClojureDepsAliases Condition="'$(ClojureDepsAliases)' == ''"></ClojureDepsAliases>

    <!-- Path to Clojure.MSBuild package source (auto-set, don't override) -->
    <ClojureMSBuildSourceDir>$(MSBuildThisFileDirectory)</ClojureMSBuildSourceDir>

    <!-- The precompiled Clojure runtime (clojure.core, standard library, Clojure.MSBuild
         tooling) is shared between projects through this directory, keyed by the Clojure
         and Clojure.MSBuild versions. Set ClojureLibCache=false to keep everything per project. -->
    <ClojureLibCacheDir Condition="'$(ClojureLibCacheDir)' == ''">$([System.Environment]::GetFolderPath(SpecialFolder.UserProfile))/.clojure-msbuild/lib-cache/</ClojureLibCacheDir>

    <!-- Compile the precompiled Clojure runtime, standard library and dependencies to native
         code with crossgen2 (ReadyToRun) so that the build, the tests, the REPL and the
         application start without JIT-compiling them. crossgen2 is downloaded from NuGet the
         first time. Set to false to keep them IL. -->
    <ClojureReadyToRun Condition="'$(ClojureReadyToRun)' == ''">true</ClojureReadyToRun>

    <!-- Additional namespaces to AOT compile besides the main namespace and its
         dependencies (separated by ;, or use ClojureCompile items), e.g. namespaces
         with gen-class or namespaces the application loads by name at runtime. -->
    <ClojureNamespacesToCompile Condition="'$(ClojureNamespacesToCompile)' == ''"></ClojureNamespacesToCompile>

    <!-- nREPL: the port of clj-nrepl/clj-dev and of the in-app server (0 = any free port),
         extra middleware (qualified var symbols, separated by ;), and whether the
         application itself starts an nREPL server next to its -main (e.g. only in Debug:
         <ClojureNReplInApp Condition="'$(Configuration)' == 'Debug'">true</ClojureNReplInApp>). -->
    <ClojureNReplPort Condition="'$(ClojureNReplPort)' == ''">1667</ClojureNReplPort>
    <ClojureNReplMiddleware Condition="'$(ClojureNReplMiddleware)' == ''"></ClojureNReplMiddleware>
    <ClojureNReplInApp Condition="'$(ClojureNReplInApp)' == ''">false</ClojureNReplInApp>
  </PropertyGroup>
</Project>
